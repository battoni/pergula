# back-and-forth between terminals.
MESSAGE_CACHE_LIMIT = 8
_CACHE_LOCK = threading.Lock()

# One parse per file at a time. The page asks again every 700 ms, so a cold 60 MB
# transcript drew a second and a third full parse while the first was still
# running; under the GIL each one slowed the others, and the whole server with
# them. Whoever arrives second waits and then reads the cache.
_PARSE_LOCKS: dict[str, threading.Lock] = {}

# Screenshots travel inside the transcript as base64 — twice, as the image block's
# "data" and the tool result's "base64" — and are most of a heavy file's bytes.
# Nothing here draws them, so they are cut before json.loads has to walk them.
# Inside a JSON string these keys would read \"data\":\", so only real keys match.
BLOB_KEYS = (b'"data":"', b'"base64":"')
BLOB_MIN = 256

# A record whose first key is its type says what it is in its first bytes. The
# CLI writes api-request records that way — a third of a heavy file, never shown —
# while the turns themselves open with parentUuid and are parsed in full.
TYPED_OPENING = b'{"type":"'
SHOWN_OPENINGS = tuple(TYPED_OPENING + kind.encode() + b'"' for kind in CONVERSATION_TYPES)

# One assertion at a time. A second `caffeinate` would keep the Mac awake
# behind the one the page knows about, with no way to reach it.
_CAFFEINE = {"child": None, "until": 0.0}
_CAFFEINE_LOCK = threading.Lock()


# HELPERS


def project_slug(directory: Path) -> str:
    return re.sub(r"[^a-zA-Z0-9]", "-", str(directory))


def signature(path: Path) -> str:
    info = path.stat()
    return f"{info.st_mtime_ns}:{info.st_size}"


def read_head(path: Path, limit: int = HEAD_BYTES) -> list[str]:
    with path.open("rb") as handle:
        chunk = handle.read(limit)

    lines = chunk.decode("utf-8", errors="replace").split("\n")
    if len(chunk) == limit:
        lines.pop()

    return lines


def read_tail(path: Path, limit: int = TAIL_BYTES) -> list[str]:
    size = path.stat().st_size
    with path.open("rb") as handle:
        if size > limit:
            handle.seek(size - limit)
        chunk = handle.read()

    lines = chunk.decode("utf-8", errors="replace").split("\n")
    if size > limit:
        lines.pop(0)

    return lines


def strip_noise(text: str) -> str:
    for pattern in NOISE_PATTERNS:
        text = pattern.sub("", text)

    return text.strip()


def summarize_tool(name: str, payload: dict) -> tuple[str, str]:
    """Return (one-line subtitle, copyable body) for a tool call."""
    if name == "Bash":
        return payload.get("description", ""), payload.get("command", "")

    for field in ("file_path", "path", "pattern", "url", "query", "prompt"):
        if field in payload:
            return str(payload[field])[:200], ""

    return "", ""


def session_meta(path: Path) -> dict:
    """Cheap metadata for one transcript, cached until the file changes."""
    key = str(path)
    stamp = signature(path)

    with _CACHE_LOCK:
        cached = _META_CACHE.get(key)
        fresh = cached and cached[0] == stamp
        if fresh:
            return cached[1]

    info = path.stat()
    small = info.st_size <= HEAD_BYTES + TAIL_BYTES
    head = read_head(path)
    tail = head if small else read_tail(path)

    meta = {
        "id": path.stem,
        "slug": path.parent.name,
        "cwd": "",
        "branch": "",
        "opening": "",
        "aiTitle": "",
        "customTitle": "",
        "color": "",
        "mtime": info.st_mtime,
        "size": info.st_size,
    }

    for line in head:
        if not line.strip():
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue

        learns_cwd = not meta["cwd"] and record.get("cwd")
        if learns_cwd:
            meta["cwd"] = record["cwd"]
            meta["branch"] = record.get("gitBranch") or ""

        learns_opening = not meta["opening"] and record.get("type") == "user"
        if learns_opening:
            content = (record.get("message") or {}).get("content")
            if isinstance(content, str):
                text = " ".join(strip_noise(content).split())
                if text:
                    meta["opening"] = text[:110]

        complete = meta["cwd"] and meta["opening"]
        if complete:
            break

    # Later records win: a session can be renamed or recoloured many times.
    for line in tail:
        boring = "title" not in line and "agent" not in line
        if boring:
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue

        kind = record.get("type")

        if kind == "ai-title":
            meta["aiTitle"] = record.get("aiTitle") or meta["aiTitle"]
            continue

        if kind == "custom-title":
            meta["customTitle"] = record.get("customTitle") or meta["customTitle"]
            continue

        if kind == "agent-name":
            meta["customTitle"] = meta["customTitle"] or (record.get("agentName") or "")
            continue

        if kind == "agent-color":
            meta["color"] = record.get("agentColor") or meta["color"]

    meta["title"] = meta["customTitle"] or meta["aiTitle"] or meta["opening"] or path.stem[:8]
    meta["renamed"] = bool(meta["customTitle"])

    with _CACHE_LOCK:
        _META_CACHE[key] = (stamp, meta)

    return meta


def live_sessions() -> dict:
    """session id -> {pid, status, name, since} for every session with a live process."""
    live: dict[str, dict] = {}
    try:
        entries = sorted(LIVE_PATH.glob("*.json"))
    except OSError:
        return live

    for entry in entries:
        try:
            record = json.loads(entry.read_text(encoding="utf-8"))
            pid = int(record["pid"])
            session = str(record["sessionId"])
        except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
            continue

        # A crashed session can leave its file behind; the pid is the truth.
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            continue
        except PermissionError:
            pass
        except OSError:
            continue

        status = record.get("status") or ""
        state = agent_state(session, status)
        live[session] = {
            "pid": pid,
            "status": status,
            "state": state,
            "subagents": subagents_behind(agent_record(session)) if state == "working" else 0,
            "name": record.get("name") or "",
            "since": record.get("startedAt", 0) / 1000,
        }

    return live


def agent_record(session: str) -> dict:
    """What the tab-status hooks wrote about a session, or nothing."""
    # The id names a file, so it must not be able to name one anywhere else.
    if not SESSION_ID.fullmatch(session):
        return {}

    try:
        record = json.loads((AGENT_STATE_PATH / f"{session}.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}

    return record if isinstance(record, dict) else {}


def subagents_behind(record: dict) -> int:
    """Subagents still running after the main turn ended. The hooks read them
    from the CLI's own list of background tasks, so a dead one is not counted."""
    count = record.get("subagents")
    counted = isinstance(count, int) and count > 0 and record.get("turn_over")
    return count if counted else 0


def agent_state(session: str, status: str) -> str:
    """working, needs_you, ready or error, for a session with a live process."""
    fallback = "working" if status == "busy" else "ready"
    record = agent_record(session)
    state = record.get("state")

    if state not in AGENT_STATES:
        return fallback

    # Esc ends a turn without firing the Stop hook, so the file can still say
    # working long after the CLI went idle. The registry wins that one — unless
    # the turn ended on purpose and subagents are still at it in the background,
    # which the registry cannot see either.
    interrupted = state == "working" and status == "idle" and not subagents_behind(record)
    if interrupted:
        return "ready"

    return state


def live_stamp(live: dict) -> str:
    return ",".join(
        f"{session}:{data['status']}:{data['state']}:{data.get('subagents', 0)}"
        for session, data in sorted(live.items())
    )


def save_caffeine(until: float, pid: int) -> None:
    body = json.dumps({"until": int(until), "pid": pid}, indent=2)
    CAFFEINE_PATH.write_text(body, encoding="utf-8")


def owns_pid(pid: int) -> bool:
    """A pid outlives the process that held it, so ask what answers to this one
    before signalling it. Killing a stranger to tidy up would be worse than
    leaving a stray `caffeinate` running."""
    probe = subprocess.run(["ps", "-p", str(pid), "-o", "comm="],
                           capture_output=True, text=True)
    return probe.stdout.strip().endswith("caffeinate")


def caffeine_reading() -> dict:
    """A deadline of zero means nothing is holding the Mac awake. The child is
    asked rather than the clock, because `caffeinate -t` ends on its own and the
    page must not go on counting down for a process that already exited.
    Callers hold _CAFFEINE_LOCK."""
    child = _CAFFEINE["child"]
    finished = child is None or child.poll() is not None
    if finished:
        _CAFFEINE["child"] = None
        _CAFFEINE["until"] = 0.0

    return {"until": int(_CAFFEINE["until"]), "hours": list(CAFFEINE_HOURS)}


def drop_caffeine() -> None:
    """Ends the assertion, if there is one. Callers hold _CAFFEINE_LOCK."""
    child = _CAFFEINE["child"]
    if child is not None:
        child.terminate()

    _CAFFEINE["child"] = None
    _CAFFEINE["until"] = 0.0


def caffeine_state() -> dict:
    with _CAFFEINE_LOCK:
        return caffeine_reading()


def start_caffeine(hours: float) -> dict:
    seconds = int(max(0.25, min(hours, CAFFEINE_LIMIT)) * 3600)
    with _CAFFEINE_LOCK:
        drop_caffeine()

        # -d holds the display, -i the idle sleep, -s the system sleep on mains
        # and -u says a user is present. Without -i the Mac sleeps anyway and
        # the agents stop with it, which is the whole point of the button.
        _CAFFEINE["child"] = subprocess.Popen(
            ["caffeinate", "-disu", "-t", str(seconds)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        _CAFFEINE["until"] = time.time() + seconds
        save_caffeine(_CAFFEINE["until"], _CAFFEINE["child"].pid)

        return caffeine_reading()


def stop_caffeine() -> dict:
    with _CAFFEINE_LOCK:
        drop_caffeine()
        save_caffeine(0.0, 0)

        return caffeine_reading()


def adopt_caffeine() -> None:
    """Restarting the agent takes the child with it — launchd kills the whole
    job — but the file it wrote outlives the process. Whatever is recorded there
    is either already dead or an orphan the page can no longer stop, so it goes
    and the deadline is cleared."""
    try:
        data = json.loads(CAFFEINE_PATH.read_text(encoding="utf-8"))
        pid = int(data.get("pid") or 0) if isinstance(data, dict) else 0
    except (OSError, ValueError, json.JSONDecodeError):
        return

    stray = pid > 0 and owns_pid(pid)
    if stray:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass

    save_caffeine(0.0, 0)


def load_names() -> dict:
    try:
        data = json.loads(NAMES_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}

    return data if isinstance(data, dict) else {}


def save_name(slug: str, label: str) -> dict:
    with _CACHE_LOCK:
        names = load_names()
        if label:
            names[slug] = label
        if not label:
            names.pop(slug, None)

        NAMES_PATH.write_text(json.dumps(names, ensure_ascii=False, indent=2), encoding="utf-8")

    return names


def names_stamp() -> str:
    try:
        return str(NAMES_PATH.stat().st_mtime_ns)
    except OSError:
        return "0"


def load_favourites() -> list[str]:
    try:
        data = json.loads(FAVOURITES_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []

    if not isinstance(data, list):
        return []

    return [str(slug) for slug in data][:FAVOURITE_LIMIT]


def save_favourites(slugs: list[str]) -> None:
    kept = json.dumps(slugs[:FAVOURITE_LIMIT], ensure_ascii=False, indent=2)
    FAVOURITES_PATH.write_text(kept, encoding="utf-8")


def set_favourite(slug: str, wanted: bool) -> list[str]:
    with _CACHE_LOCK:
        slugs = [one for one in load_favourites() if one != slug]

        # A new favourite joins the end, so the ones already there do not move.
        room = len(slugs) < FAVOURITE_LIMIT
        adding = wanted and room
        if adding:
            slugs.append(slug)

        save_favourites(slugs)

    return slugs


def move_favourite(was: str, slug: str) -> None:
    """Retitling a snippet moves its file; the star has to move with it."""
    with _CACHE_LOCK:
        slugs = load_favourites()
        if was not in slugs:
            return

        save_favourites([slug if one == was else one for one in slugs])


def favourites_stamp() -> str:
    try:
        return str(FAVOURITES_PATH.stat().st_mtime_ns)
    except OSError:
        return "0"


def snippet_slug(raw: str) -> str:
    """A snippet is addressed by its path: an optional folder, then a name. Both
    are reduced to the safe alphabet here, so nothing arriving from the page can
    walk out of the directory."""
    plain = unicodedata.normalize("NFD", str(raw)).encode("ascii", "ignore").decode("ascii")
    cleaned = [re.sub(r"[^a-z0-9]+", "-", part.lower()).strip("-") for part in plain.split("/")]
    parts = [part for part in cleaned if part][:2]

    return "/".join(parts)


def split_snippet(text: str) -> tuple[str, str]:
    """The first line names the snippet when it is a heading, and stays out of
    the clipboard. Everything under it is the prompt, verbatim."""
    head, _, rest = text.partition("\n")
    heading = re.match(r"^#\s+(.+?)\s*$", head)
    if not heading:
        return "", text

    return heading.group(1), rest.lstrip("\n")


def snippet_files() -> list[Path]:
    if not SNIPPETS_PATH.is_dir():
        return []

    loose = sorted(SNIPPETS_PATH.glob("*.md"))
    grouped = sorted(SNIPPETS_PATH.glob("*/*.md"))

    return loose + grouped


def snippets_token(files: list[Path]) -> str:
    """Built from stat() alone, so an unchanged library is answered without
    opening a single file."""
    try:
        stamps = [path.stat().st_mtime_ns for path in files]
    except OSError:
        return "0"

    return f"{len(stamps)}:{max(stamps, default=0)}:{favourites_stamp()}"


def load_snippets() -> list[dict]:
    found = []
    for path in snippet_files():
        try:
            text = path.read_text(encoding="utf-8")
            stamp = path.stat().st_mtime
        except OSError:
            continue

        slug = path.relative_to(SNIPPETS_PATH).with_suffix("").as_posix()
        group, _, name = slug.rpartition("/")
        title, body = split_snippet(text)
        found.append({
            "slug": slug,
            "group": group,
            "title": title or name.replace("-", " "),
            "body": body,
            "mtime": stamp,
        })

    found.sort(key=lambda item: (item["group"], item["title"].lower()))

    return found


def save_snippet(slug: str, title: str, body: str) -> None:
    path = SNIPPETS_PATH / f"{slug}.md"
    path.parent.mkdir(parents=True, exist_ok=True)
    heading = f"# {title}\n\n" if title else ""
    path.write_text(heading + body.strip() + "\n", encoding="utf-8")


def drop_snippet(slug: str) -> None:
    path = SNIPPETS_PATH / f"{slug}.md"
    try:
        path.unlink()
        # An empty group is an empty folder; left behind, it lists forever.
        spare = path.parent != SNIPPETS_PATH and not any(path.parent.iterdir())
        if spare:
            path.parent.rmdir()
    except OSError:
        return


def all_transcripts(scope: Path | None) -> list[Path]:
    if scope is not None:
        directory = PROJECTS / project_slug(scope)
        return list(directory.glob("*.jsonl")) if directory.is_dir() else []

    return list(PROJECTS.glob("*/*.jsonl"))


def find_transcript(scope: Path | None, session: str | None) -> Path | None:
    transcripts = all_transcripts(scope)
    if not transcripts:
        return None

    if session:
        for path in transcripts:
            if path.stem == session:
                return path

        return None

    return max(transcripts, key=lambda path: path.stat().st_mtime)


def build_index(scope: Path | None) -> dict:
    transcripts = all_transcripts(scope)
    if not transcripts:
        return {"token": "empty", "projects": [], "active": None}

    newest = max(transcripts, key=lambda path: path.stat().st_mtime)
    live = live_sessions()
    names = load_names()
    token = f"{len(transcripts)}:{newest}:{signature(newest)}:{names_stamp()}:{live_stamp(live)}"

    groups: dict[str, dict] = {}
    for path in transcripts:
        try:
            meta = session_meta(path)
        except OSError:
            continue

        running = live.get(meta["id"])
        meta = {
            **meta,
            "live": bool(running),
            "status": running["status"] if running else "",
            "state": running["state"] if running else "",
            "subagents": running["subagents"] if running else 0,
            "pid": running["pid"] if running else 0,
        }

        group = groups.setdefault(meta["slug"], {"slug": meta["slug"], "path": "", "sessions": []})
        first_cwd_seen = meta["cwd"] and not group["path"]
        if first_cwd_seen:
            group["path"] = meta["cwd"]
        group["sessions"].append(meta)

    projects = []
    for group in groups.values():
        group["sessions"].sort(key=lambda meta: meta["mtime"], reverse=True)
        group["path"] = group["path"] or group["slug"].lstrip("-").replace("-", "/")
        group["label"] = names.get(group["slug"], "")
        group["mtime"] = group["sessions"][0]["mtime"]
        projects.append(group)

    projects.sort(key=lambda group: group["mtime"], reverse=True)

    # Follow a session that is genuinely open before falling back to whichever
    # file was touched last — a finished session should not steal the view.
    running_ids = {meta["id"] for group in projects for meta in group["sessions"] if meta["live"]}
    active = newest.stem
    active_is_stale = running_ids and active not in running_ids
    if active_is_stale:
        candidates = [meta for group in projects for meta in group["sessions"] if meta["live"]]
        active = max(candidates, key=lambda meta: meta["mtime"])["id"]

    return {
        "token": token,
        "projects": projects,
        "active": active,
        "hasRegistry": LIVE_PATH.is_dir(),
    }


def drop_blobs(line: bytes) -> bytes:
    """The line with every long base64 value emptied. Base64 holds no quote, so
    the end of the value is the next one."""
    for key in BLOB_KEYS:
        start = line.find(key)
        if start == -1:
            continue

        parts = []
        cursor = 0
        while start != -1:
            value = start + len(key)
            end = line.find(b'"', value)
            if end == -1:
                break

            long_enough = end - value >= BLOB_MIN
            if long_enough:
                parts.append(line[cursor:value])
                cursor = end

            start = line.find(key, end)

        parts.append(line[cursor:])
        line = b"".join(parts)

    return line


def worth_parsing(line: bytes) -> bool:
    hidden = line.startswith(TYPED_OPENING) and not line.startswith(SHOWN_OPENINGS)
    return not hidden


def parse_lines(lines, messages: list[dict]) -> None:
    for line in lines:
        try:
            record = json.loads(line)
        except ValueError:
            continue

        if record.get("type") not in CONVERSATION_TYPES:
            continue

        message = record.get("message") or {}
        role = message.get("role")
        content = message.get("content")
        stamp = record.get("timestamp", "")

        # What the CLI injects on the user's behalf — a skill's body, an image
        # placeholder — is shown like any other turn, but nobody typed it.
        injected = bool(record.get("isMeta"))

        if isinstance(content, str):
            text = strip_noise(content)
            if text:
                messages.append({"role": role, "kind": "text", "text": text, "ts": stamp,
                                 "meta": injected})
            continue

        if not isinstance(content, list):
            continue

        for block in content:
            if not isinstance(block, dict):
                continue

            kind = block.get("type")

            if kind == "text":
                text = strip_noise(block.get("text", ""))
                if text:
                    messages.append({"role": role, "kind": "text", "text": text, "ts": stamp,
                                     "meta": injected})
                continue

            if kind == "tool_use":
                name = block.get("name", "tool")
                payload = block.get("input") or {}
                subtitle, body = summarize_tool(name, payload)
                messages.append({
                    "role": "tool",
                    "kind": "tool_use",
                    "name": name,
                    "subtitle": subtitle,
                    "text": body,
                    "ts": stamp,
                })
                continue

            if kind == "tool_result":
                body = block.get("content")
                if isinstance(body, list):
                    body = "\n".join(
                        part.get("text", "")
                        for part in body
                        if isinstance(part, dict) and part.get("type") == "text"
                    )
                text = (body or "").strip() if isinstance(body, str) else ""
                if text:
                    messages.append({"role": "tool", "kind": "tool_result", "text": text, "ts": stamp})



def state_token(path: Path, limit: int) -> str:
    """The identity of a response, from stat() alone — the file stays shut."""
    return f"{path}:{signature(path)}:{limit}"


def parse_transcript(path: Path) -> list[dict]:
    key = str(path)

    with _CACHE_LOCK:
        parse_lock = _PARSE_LOCKS.setdefault(key, threading.Lock())

    with parse_lock:
        return parse_transcript_locked(path, key)


def parse_transcript_locked(path: Path, key: str) -> list[dict]:
    size = path.stat().st_size

    with _CACHE_LOCK:
        cached = _MESSAGE_CACHE.get(key)

    unchanged = cached and cached[0] == size
    if unchanged:
        with _CACHE_LOCK:
            # Refresh its position: eviction drops the least recently used.
            if key in _MESSAGE_CACHE:
                _MESSAGE_CACHE[key] = _MESSAGE_CACHE.pop(key)
        return cached[1]

    # It grew: carry on from where we stopped. Shrunk or new: read from zero.
    resume = bool(cached) and cached[0] < size
    start, messages = (cached[0], list(cached[1])) if resume else (0, [])

    with path.open("rb") as handle:
        handle.seek(start)
        chunk = handle.read()

    # A live session may be mid-write, so only whole lines are consumed.
    end = chunk.rfind(b"\n")
    if end == -1:
        return messages

    # Bytes all the way to json.loads: decoding 60 MB to str and splitting that
    # cost more than the parse itself.
    lines = (drop_blobs(line) for line in chunk[:end].split(b"\n") if worth_parsing(line))
    parse_lines(lines, messages)

    with _CACHE_LOCK:
        _MESSAGE_CACHE.pop(key, None)
        _MESSAGE_CACHE[key] = (start + end + 1, messages)
        while len(_MESSAGE_CACHE) > MESSAGE_CACHE_LIMIT:
            _MESSAGE_CACHE.pop(next(iter(_MESSAGE_CACHE)))

    return messages


def clip_middle(text: str, limit: int = RESUME_CLIP) -> str:
    if len(text) <= limit:
        return text

    head = limit * 3 // 5
    tail = limit - head

    return f"{text[:head].rstrip()}\n[…]\n{text[-tail:].lstrip()}"


def resume_turns(messages: list[dict]) -> list[dict]:
    """The end of the conversation as prose alone. A session resumed after hours
    away pays for its whole context again; these few turns are what a new one
    needs to carry on, and they cost a page of text instead.

    A turn is everything one side said before the other spoke. Claude narrates
    between commands, so of its turn only the last thing said is kept — where it
    ended up, not how it got there."""
    turns: list[dict] = []
    for message in messages:
        unspoken = message["kind"] != "text" or message.get("meta")
        if unspoken:
            continue

        role, text = message["role"], message["text"]
        answers = not turns or turns[-1]["role"] != role
        if answers:
            turns.append({"role": role, "text": text})
            continue

        said = turns[-1]
        said["text"] = f"{said['text']}\n\n{text}" if role == "user" else text

    return [
        {"role": turn["role"], "text": clip_middle(turn["text"])}
        for turn in turns[-RESUME_TURNS:]
    ]


def build_state(scope: Path | None, session: str | None, limit: int) -> dict:
    path = find_transcript(scope, session)
    if path is None:
        return {"token": "empty", "session": None, "messages": [], "total": 0}

    messages = parse_transcript(path)
    total = len(messages)

    # A long session can carry thousands of turns; sending them all would stall
    # the page on every poll. The tail is what anyone is reading anyway.
    window = messages[-limit:] if limit and total > limit else messages

    return {
        "token": state_token(path, limit),
        "session": session_meta(path),
        "messages": window,
        "total": total,
        "resume": {"path": str(path), "turns": resume_turns(messages)},
    }


# SERVER


class Handler(BaseHTTPRequestHandler):
    scope: Path | None = None

    def log_message(self, *_args):
        pass

    def send_payload(self, status: int, body: bytes, content_type: str):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Pergula", "1")
        self.end_headers()
        self.wfile.write(body)

    def send_json(self, payload: dict, since: str):
        nothing_changed = since and since == payload.get("token")
        if nothing_changed:
            self.send_payload(204, b"", "application/json")
            return

        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_payload(200, body, "application/json; charset=utf-8")

    def do_GET(self):
        parsed = urlparse(self.path)
        query = parse_qs(parsed.query)
        since = (query.get("since") or [""])[0]

        if parsed.path == "/":
            self.send_payload(200, PAGE.encode("utf-8"), "text/html; charset=utf-8")
            return

        if parsed.path == "/manifest.webmanifest":
            self.send_payload(200, MANIFEST.encode("utf-8"),
                              "application/manifest+json; charset=utf-8")
            return

        if parsed.path in ("/icon.png", "/apple-touch-icon.png"):
            self.send_payload(200, base64.b64decode(ICON_B64), "image/png")
            return

        if parsed.path == "/api/caffeine":
            self.send_ok(caffeine_state())
            return

        if parsed.path == "/api/ping":
            self.send_payload(200, b'{"ok":true}', "application/json")
            return

        if parsed.path == "/api/index":
            self.send_json(build_index(self.scope), since)
            return

        if parsed.path == "/api/state":
            session = (query.get("session") or [""])[0] or None
            try:
                limit = max(0, int((query.get("limit") or ["400"])[0]))
            except ValueError:
                limit = DEFAULT_LIMIT

            # The token comes from stat(), so "nothing changed" can be answered
            # without opening the transcript. Before this line, every 700 ms poll
            # read and parsed the whole file only to discover it owed a 204.
            path = find_transcript(self.scope, session)
            unchanged = path is not None and since and since == state_token(path, limit)
            if unchanged:
                self.send_payload(204, b"", "application/json")
                return

            self.send_json(build_state(self.scope, session, limit), since)
            return

        if parsed.path == "/api/snippets":
            files = snippet_files()
            token = snippets_token(files)
            unchanged = since and since == token
            if unchanged:
                self.send_payload(204, b"", "application/json")
                return

            payload = {
                "token": token,
                "home": str(SNIPPETS_PATH),
                "snippets": load_snippets(),
                "favourites": load_favourites(),
            }
            self.send_json(payload, since)
            return

        self.send_payload(404, b"not found", "text/plain; charset=utf-8")

    def send_ok(self, payload: dict):
        self.send_payload(200, json.dumps(payload).encode("utf-8"), "application/json")

    def send_bad(self):
        self.send_payload(400, b"bad request", "text/plain; charset=utf-8")

    def read_body(self) -> dict | None:
        try:
            length = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(length).decode("utf-8"))
        except (ValueError, json.JSONDecodeError):
            return None

        return body if isinstance(body, dict) else None

    def do_POST(self):
        routes = {
            "/api/rename": self.rename_project,
            "/api/snippet": self.write_snippet,
            "/api/snippet/delete": self.erase_snippet,
            "/api/favourite": self.star_snippet,
            "/api/caffeine": self.set_caffeine,
        }
        route = routes.get(urlparse(self.path).path)
        if not route:
            self.send_payload(404, b"not found", "text/plain; charset=utf-8")
            return

        payload = self.read_body()
        if payload is None:
            self.send_bad()
            return

        route(payload)

    def set_caffeine(self, payload: dict):
        """How many hours to stay awake, or nothing at all to sleep again."""
        try:
            hours = float(payload.get("hours") or 0)
        except (TypeError, ValueError):
            self.send_bad()
            return

        if hours <= 0:
            self.send_ok(stop_caffeine())
            return

        self.send_ok(start_caffeine(hours))

    def rename_project(self, payload: dict):
        slug = str(payload.get("slug") or "")
        if not slug:
            self.send_bad()
            return

        save_name(slug, str(payload.get("label") or "").strip()[:80])
        self.send_ok({"ok": True})

    def write_snippet(self, payload: dict):
        title = str(payload.get("title") or "").strip()[:80]
        group = str(payload.get("group") or "").strip()
        slug = snippet_slug(f"{group}/{title}")
        if not slug:
            self.send_bad()
            return

        save_snippet(slug, title, str(payload.get("body") or ""))

        # Retitling or regrouping moves the file, so the old one has to go.
        was = snippet_slug(str(payload.get("was") or ""))
        moved = was and was != slug
        if moved:
            drop_snippet(was)
            move_favourite(was, slug)

        self.send_ok({"ok": True, "slug": slug})

    def erase_snippet(self, payload: dict):
        slug = snippet_slug(str(payload.get("slug") or ""))
        if not slug:
            self.send_bad()
            return

        drop_snippet(slug)
        set_favourite(slug, False)
        self.send_ok({"ok": True})

    def star_snippet(self, payload: dict):
        slug = snippet_slug(str(payload.get("slug") or ""))
        if not slug:
            self.send_bad()
            return

        self.send_ok({"ok": True, "favourites": set_favourite(slug, bool(payload.get("on")))})


