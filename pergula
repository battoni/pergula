  /* ---- sidebar ---- */
  #rail {
    position: relative;
    height: 100vh;
    display: flex; flex-direction: column;
    background: var(--rail);
    border-right: 1px solid var(--line);
    overflow: hidden;
  }
  #rail .rail-top { padding: 12px 12px 9px; border-bottom: 1px solid var(--line); }
  /* The grip lies along the rail's right edge, inside it because the rail
     clips; the line it draws is that edge lit up, so at rest there is nothing
     extra on screen. */
  .rail-grip {
    position: absolute; top: 0; right: 0; bottom: 0; width: 7px; z-index: 5;
    cursor: col-resize; touch-action: none;
  }
  .rail-grip::after {
    content: ""; position: absolute; top: 0; bottom: 0; right: 0; width: 2px;
    background: transparent; transition: background .15s;
  }
  .rail-grip:hover::after, body.resizing .rail-grip::after { background: var(--accent); }
  body.resizing { cursor: col-resize; user-select: none; }
  /* The lockup, outlined: no external font, like the rest of the page. */
  #rail .logo { display: block; height: 38px; width: auto; fill: var(--accent);
                margin: 4px auto 16px; }
  #filter {
    width: 100%; padding: 7px 10px;
    background: var(--code); color: var(--body);
    border: 1px solid var(--line); border-radius: 9px;
    font: inherit; font-size: 13px;
  }
  #filter:focus { outline: none; border-color: var(--accent); }
  /* Focus: one project on the list and nothing else. The chip is the only sign
     of it, so it has to be impossible to miss, and it is also the way out. */
  #focusChip {
    display: flex; align-items: center; gap: 7px; width: 100%;
    margin-top: 9px; padding: 5px 10px;
    background: var(--accent-soft); border: 1px solid var(--accent); border-radius: 8px;
    color: var(--heading); font: inherit; font-size: 11.5px; text-align: left; cursor: pointer;
  }
  #focusChip[hidden] { display: none; }
  #focusChip .name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
  #focusChip .keys { color: var(--muted); flex: none; }
  .scope { display: flex; gap: 4px; margin-top: 9px; }
  .scope button {
    flex: 1; padding: 4px 0;
    background: none; border: 1px solid var(--line); border-radius: 8px;
    color: var(--muted); font: inherit; font-size: 11.5px; cursor: pointer;
  }
  .scope button:hover { color: var(--heading); }
  .scope button.on { background: var(--accent-soft); border-color: var(--accent); color: var(--heading); }
  .session.dragging {
    opacity: .4; background: var(--panel-soft);
    cursor: grabbing;
  }
  /* Without this the row's own content fires dragleave on every pixel. */
  .session.dragging * { pointer-events: none; }
  .session .badge {
    flex: none; min-width: 15px; text-align: center;
    font: 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--subtle); border: 1px solid var(--line); border-radius: 4px; padding: 2px 0;
  }
  .session.active .badge { color: var(--accent); border-color: var(--accent); }
  .project > summary .pencil {
    opacity: 0; background: none; border: 0; padding: 0 2px;
    color: var(--subtle); font: inherit; font-size: 11px; cursor: pointer;
  }
  .project > summary:hover .pencil { opacity: 1; }
  .project > summary .pencil:hover { color: var(--accent); }
  .rename {
    flex: 1; min-width: 0; padding: 2px 6px;
    background: var(--code); color: var(--heading);
    border: 1px solid var(--accent); border-radius: 6px;
    font: inherit; font-size: 12.5px;
  }
  .rename:focus { outline: none; }
  /* Square and radius-free, in the mark's own language. The native control is
     too small to aim at and refuses the palette. */
  input[type="checkbox"] {
    appearance: none; -webkit-appearance: none;
    width: 19px; height: 19px; margin: 0; flex: none;
    background: var(--code);
    border: 1.5px solid var(--line); border-radius: 0;
    display: grid; place-content: center;
    cursor: pointer;
    transition: background .15s ease, border-color .15s ease;
  }
  /* The tick already exists when unchecked, merely hidden, so it scales in
     rather than blinking into being. */
  input[type="checkbox"]::after {
    content: ""; width: 9px; height: 5px;
    border: 2px solid var(--canvas); border-top: 0; border-right: 0;
    transform: translateY(-1.5px) rotate(-45deg) scale(.4);
    opacity: 0;
    transition: opacity .12s ease, transform .16s cubic-bezier(.2, .9, .3, 1.3);
  }
  input[type="checkbox"]:hover { border-color: var(--accent); }
  input[type="checkbox"]:checked { background: var(--accent); border-color: var(--accent); }
  input[type="checkbox"]:checked::after {
    opacity: 1; transform: translateY(-1.5px) rotate(-45deg) scale(1);
  }
  input[type="checkbox"]:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  #rail .follow {
    display: flex; align-items: center; gap: 10px;
    margin-top: 10px; font-size: 12.5px; color: var(--muted);
    cursor: pointer; user-select: none;
    transition: color .12s;
  }
  #rail .follow:hover { color: var(--body); }
  #rail .follow:hover input[type="checkbox"] { border-color: var(--accent); }
  #tree { flex: 1; overflow-y: auto; padding: 8px 8px 24px; }

  /* ---- library ---- */
  /* The rail serves two lists. The tabs pick which; everything below them that
     belongs to only one view is marked and hidden by the body class. */
  .tabs { display: flex; gap: 4px; margin-bottom: 10px; }
  .tabs button {
    flex: 1; padding: 5px 0;
    background: none; border: 1px solid var(--line); border-radius: 8px;
    color: var(--muted); font: inherit; font-size: 11.5px; cursor: pointer;
  }
  .tabs button:hover { color: var(--heading); }
  .tabs button.on { background: var(--accent-soft); border-color: var(--accent); color: var(--heading); }
  #rail .library-only { display: none; }
  body.library #rail .sessions-only { display: none; }
  body.library #rail .library-only { display: flex; }
  body.library #scroller { display: none; }
  body.library #top .swatch, body.library #copySid, body.library #copyResume { display: none; }
  /* A snippet with no group has no summary above it to indent under. */
  .session.flat { padding-left: 9px; }
  .session .rowcopy { flex: none; opacity: 0; transition: opacity .12s; }
  .session:hover .rowcopy, .session .rowcopy.done { opacity: 1; }

  /* Five prompts within reach while you read. The block vanishes entirely when
     nothing is starred, rather than sitting there as an empty heading. */
  #favourites { flex: none; padding: 9px 8px; border-bottom: 1px solid var(--line); }
  #favourites:empty { display: none; }
  body.library #rail #favourites { display: none; }
  /* A block of the rail that folds down to its heading. Folded, the heading
     says what it is hiding when that fits in a word. */
  .fold-head {
    display: flex; align-items: center; gap: 6px;
    width: 100%; padding: 0 6px 6px; text-align: left;
    background: none; border: 0; cursor: pointer;
    font: inherit; font-size: 10px; letter-spacing: .09em; text-transform: uppercase;
    color: var(--subtle); font-weight: 600;
  }
  .fold-head:hover { color: var(--body); }
  .fold-head:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fold-head::before { content: "\25BE"; font-size: 10px; }
  .fold-head .state { display: none; margin-left: auto; color: var(--accent); }
  .folded > .fold-head { padding-bottom: 0; }
  .folded > .fold-head::before { content: "\25B8"; }
  .folded > .fold-head .state { display: inline; }
  /* The id is there to outrank `#rail .follow`, which sets its own display. */
  #rail .folded > :not(.fold-head) { display: none; }
  #options { margin-top: 12px; }
  #options .fold-head { padding-left: 0; padding-right: 0; }
  #options .scope { margin-top: 0; }
  .fav {
    display: flex; align-items: center; gap: 8px;
    width: 100%; text-align: left;
    padding: 5px 9px; margin: 1px 0;
    background: none; border: 0; border-radius: 8px;
    color: var(--muted); font: inherit; font-size: 12.5px;
    cursor: pointer; overflow: hidden;
  }
  .fav:hover { background: var(--panel); color: var(--body); }
  .fav.done { color: var(--accent); }
  .fav .pin { flex: none; color: var(--accent); font-size: 10px; }
  .fav .name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .session .pin { flex: none; color: var(--accent); font-size: 10px; }
  button.copy.star { padding: 5px 10px; font-size: 13px; line-height: 1; }
  button.copy.star.on { color: var(--accent); border-color: var(--accent); }
  button.copy.star:disabled { opacity: .4; cursor: default; }
  button.copy.star:disabled:hover { color: var(--muted); border-color: var(--line); }

  #library { display: none; flex: 1; min-height: 0; }
  body.library #library { display: flex; }
  #library > .empty { flex: 1; padding-top: 22vh; }
  #library .editor {
    display: none; flex-direction: column; gap: 11px;
    width: 100%; max-width: 860px; min-height: 0;
    margin: 0 auto; padding: 22px 22px 26px;
  }
  #library.editing .editor { display: flex; }
  #library.editing .empty { display: none; }
  #library .fields { display: flex; gap: 9px; flex: none; }
  #library input, #library textarea {
    background: var(--code); color: var(--body);
    border: 1px solid var(--line); border-radius: 9px;
    font: inherit; padding: 9px 12px;
  }
  #library input:focus, #library textarea:focus { outline: none; border-color: var(--accent); }
  #snipTitle { flex: 1; min-width: 0; color: var(--heading); font-size: 15px; font-weight: 600; }
  #snipGroup { width: 190px; flex: none; font-size: 13px; }
  #snipBody {
    flex: 1; min-height: 140px; resize: none;
    font: 13.5px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  #library .actions { display: flex; align-items: center; gap: 8px; flex: none; }
  #library .where {
    margin-left: auto; color: var(--subtle);
    font: 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  button.copy.primary {
    background: var(--accent); border-color: var(--accent);
    color: #141413; font-weight: 600; padding: 5px 16px;
  }
  button.copy.primary:hover, button.copy.primary.done { color: #141413; }
  button.copy.danger:hover, button.copy.armed { color: var(--danger); border-color: var(--danger); }

  /* ---- palette ---- */
  /* The fast path: cmd+K, type, Enter. No pointer involved and no view change. */
  .palette {
    position: fixed; inset: 0; z-index: 20; display: none;
    justify-content: center; align-items: flex-start;
    padding-top: 13vh; background: rgba(10, 9, 8, .58);
  }
  .palette.on { display: flex; }
  .palette .sheet {
    width: min(660px, 92vw); overflow: hidden;
    background: var(--panel); border: 1px solid var(--line); border-radius: 14px;
    box-shadow: 0 22px 60px rgba(0, 0, 0, .5);
  }
  .palette input {
    width: 100%; padding: 14px 17px;
    background: none; border: 0; border-bottom: 1px solid var(--line);
    color: var(--heading); font: inherit; font-size: 15px;
  }
  .palette input:focus { outline: none; }
  .palette .results { max-height: 46vh; overflow-y: auto; padding: 6px; }
  .palette .hit {
    display: flex; align-items: baseline; gap: 9px;
    width: 100%; text-align: left;
    padding: 8px 11px; border: 0; border-radius: 9px;
    background: none; color: var(--body); font: inherit; font-size: 13px;
    cursor: pointer; overflow: hidden;
  }
  .palette .hit .group { flex: none; color: var(--subtle); font-size: 11px; }
  .palette .hit .peek {
    flex: 1; min-width: 0; color: var(--subtle); font-size: 11.5px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .palette .hit.on { background: var(--accent-soft); color: var(--heading); }
  .palette .hit.done { background: var(--accent-soft); color: var(--accent); }

  /* Footer: the language picker does not compete with the search. */
  .rail-foot {
    flex: none; display: flex; flex-direction: column; gap: 5px;
    padding: 9px 12px; border-top: 1px solid var(--line);
  }
  .rail-foot .row { display: flex; gap: 4px; }

  /* The durations stay folded away until the button is asked for them. */
  .rail-foot .hours { display: none; }
  .rail-foot.asking .hours { display: flex; }
  .rail-foot button {
    flex: 1; padding: 4px 0;
    background: none; border: 1px solid var(--line); border-radius: 8px;
    color: var(--muted); font: inherit; font-size: 11.5px; cursor: pointer;
  }
  .rail-foot button:hover { color: var(--heading); }
  .rail-foot button.on { background: var(--accent-soft); border-color: var(--accent); color: var(--heading); }
  .project { margin-bottom: 4px; }
  .project > summary {
    list-style: none; cursor: pointer;
    padding: 6px 8px; border-radius: 8px;
    font-size: 12px; color: var(--muted);
    display: flex; align-items: baseline; gap: 7px;
    white-space: nowrap; overflow: hidden;
  }
  .project > summary::-webkit-details-marker { display: none; }
  .project > summary:hover { background: var(--panel); color: var(--heading); }
  .project > summary b {
    color: var(--body); font-weight: 600; font-size: 12.5px;
    overflow: hidden; text-overflow: ellipsis;
  }
  .project > summary .count { margin-left: auto; color: var(--subtle); font-size: 11px; }
  .project > summary::before { content: "\25B8"; color: var(--subtle); font-size: 10px; }
  .project[open] > summary::before { content: "\25BE"; }
  /* The days a project was worked on, as rules across its list. They show
     only when the list spans more than one, so a morning's work is not filed
     under a lone "today". */
  .day {
    display: flex; align-items: center; gap: 8px;
    padding: 9px 9px 3px 22px;
    font-size: 10px; letter-spacing: .09em; text-transform: uppercase;
    color: var(--subtle);
  }
  .day::after { content: ""; flex: 1; height: 1px; background: var(--line); }
  .session {
    display: flex; align-items: center; gap: 8px;
    width: 100%; text-align: left;
    padding: 6px 9px 6px 22px; margin: 1px 0;
    background: none; border: 0; border-radius: 8px;
    color: var(--muted); font: inherit; font-size: 12.5px;
    cursor: pointer; overflow: hidden;
  }
  .session:hover { background: var(--panel); color: var(--body); }
  .session.active { background: var(--accent-soft); color: var(--heading); }
  .session .swatch { width: 7px; height: 7px; border-radius: 50%; flex: none; background: var(--subtle); }
  .session .name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .session .name em { font-style: normal; color: var(--accent); }
  .session .when { color: var(--subtle); font-size: 10.5px; flex: none; }
  .session.live .when { color: var(--accent); }
  .session .when .light { color: var(--state-ready); }
  .session.working .when .light { color: var(--state-working); }
  .session.needs-you .when, .session.needs-you .when .light { color: var(--state-needs-you); font-weight: 600; }
  .session.error .when, .session.error .when .light { color: var(--state-error); font-weight: 600; }

  /* ---- pane ---- */
  #pane { min-width: 0; height: 100vh; display: flex; flex-direction: column; }
  /* Two lines, so a portrait screen keeps everything in view: the session and
     its two buttons above, where it lives below. The title gives way first and
     ends in an ellipsis; the buttons never leave. */
  #top {
    flex: none;
    display: flex; flex-direction: column; gap: 3px;
    padding: 9px 22px 8px;
    background: var(--rail);
    border-bottom: 1px solid var(--line);
    font-size: 12.5px; color: var(--muted);
  }
  #top .top-row { display: flex; align-items: center; gap: 11px; min-width: 0; }
  #top .swatch { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); flex: none; }
  /* The mark: a paragraph with a line snapped in two. See brand/BRAND.md.
     It shows only while the list is hidden — with the list open the sidebar
     lockup already carries the identity, and two marks would compete. */
  #top .brand { display: none; width: 21.5px; height: 20px; flex: none; fill: var(--accent); }
  body.railed-off #top .brand { display: block; }
  #top .title {
    flex: 0 1 auto; min-width: 0;
    color: var(--heading); font-weight: 600; font-size: 14px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  /* Icon button. The list toggle uses a side-panel icon rather than a burger:
     the mark is already three horizontal lines and the two would be confused. */
  #top .iconbtn {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; padding: 0;
    background: none; border: 1px solid transparent; border-radius: 7px;
    color: var(--muted); cursor: pointer;
    transition: color .12s, border-color .12s, background .12s;
  }
  #top .iconbtn svg {
    width: 17px; height: 17px;
    fill: none; stroke: currentColor; stroke-width: 1.6;
    stroke-linecap: round; stroke-linejoin: round;
  }
  #top .iconbtn:hover { color: var(--heading); background: var(--panel-soft); border-color: var(--line); }
  #top .iconbtn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  #top .iconbtn.done { color: var(--accent); }

  /* Tooltip: hover and keyboard focus only, never on click. */
  #top .tip {
    position: absolute; top: calc(100% + 8px); left: 0;
    z-index: 5; pointer-events: none;
    opacity: 0; transform: translateY(-2px);
    transition: opacity .12s, transform .12s;
    background: var(--panel); color: var(--body);
    border: 1px solid var(--line); border-radius: 7px;
    padding: 6px 9px; white-space: nowrap;
    width: max-content; max-width: 300px;
    font-size: 11.5px; line-height: 1.5;
  }
  /* The id does not fit on one line, so it gets its own and may wrap. */
  #top .tip b {
    display: block; white-space: normal; word-break: break-all;
    font: 11px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 400; color: var(--heading);
  }
  #top .iconbtn:hover .tip,
  #top .iconbtn:focus-visible .tip { opacity: 1; transform: translateY(0); }
  /* Under the title, not under the buttons before it: the toggle and the
     swatch are 28 + 10 px with an 11 px gap after each. */
  #top .meta {
    min-width: 0; padding-left: 60px;
    color: var(--subtle); white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
  }
  body.railed-off #top .meta { padding-left: 92.5px; }
  #top .meta:empty { display: none; }
  #top button { flex: none; }

  #scroller { flex: 1; min-height: 0; overflow-y: auto; }
  #feed { max-width: 860px; margin: 0 auto; padding: 22px 22px 12vh; }
  .msg { margin: 0 0 22px; }
  .msg { --role: var(--muted); --tint: var(--panel); }
  .msg.user { --role: var(--role-you); --tint: var(--tint-you); }
  .msg.claude { --role: var(--role-claude); --tint: var(--tint-claude); }
  .msg.tool { --role: var(--role-tool); --tint: var(--tint-tool); }
  .msg.result { --role: var(--role-out); --tint: var(--tint-out); }

  .who {
    display: flex; align-items: center; gap: 7px;
    font-size: 11px; letter-spacing: .09em; text-transform: uppercase;
    color: var(--role); margin-bottom: 7px; font-weight: 600;
  }
  .who .mark { display: block; flex: none; }
  /* Metadata, not a label: no small caps, no weight, no tracking. */
  .who .stamp {
    color: var(--subtle); font-size: 10.5px; font-weight: 400;
    letter-spacing: 0; text-transform: none;
    font-variant-numeric: tabular-nums;
  }
  .who .copy-msg {
    margin-left: auto; opacity: 0; transition: opacity .12s;
    letter-spacing: 0; text-transform: none; font-weight: 400;
  }
  .msg:hover .copy-msg { opacity: 1; }
  .bubble {
    background: var(--tint);
    border: 1px solid var(--line);
    border-left: 3px solid var(--role);
    border-radius: 4px 14px 14px 4px;
    padding: 13px 17px; overflow-wrap: anywhere;
  }
  .result .bubble { color: var(--muted); }
  .bubble > *:first-child { margin-top: 0; }
  .bubble > *:last-child { margin-bottom: 0; }
  .bubble h3, .bubble h4 { color: var(--heading); font-size: 1.02em; margin: 1.1em 0 .45em; }
  .bubble p { margin: 0 0 .75em; }
  .bubble ul, .bubble ol { margin: 0 0 .75em; padding-left: 1.3em; }
  .bubble blockquote {
    margin: 0 0 .75em; padding-left: .8em;
    border-left: 3px solid var(--line); color: var(--muted);
  }
  .bubble a { color: var(--accent); }
  .scroller { overflow-x: auto; margin: 0 0 .8em; }
  .bubble table { border-collapse: collapse; font-size: 13.5px; }
  .bubble th, .bubble td {
    border: 1px solid var(--line); padding: 5px 10px;
    text-align: left; vertical-align: top; white-space: nowrap;
  }
  .bubble th { color: var(--heading); background: var(--panel-soft); font-weight: 600; }
  code.inline {
    background: var(--code); border: 1px solid var(--line);
    border-radius: 5px; padding: .1em .35em;
    font: 13px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    overflow-wrap: anywhere;
  }
  .block { position: relative; margin: 0 0 .8em; }
  .block pre {
    margin: 0; padding: 12px 14px;
    background: var(--code); border: 1px solid var(--line); border-radius: 10px;
    overflow-x: auto; white-space: pre;
    font: 13px/1.55 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #e6ddd2;
  }
  button.copy {
    background: var(--panel-soft); color: var(--muted);
    border: 1px solid var(--line); border-radius: 7px;
    padding: 3px 9px; font-size: 11px; cursor: pointer; font-family: inherit;
  }
  button.copy:hover { color: var(--heading); border-color: var(--accent); }
  button.copy.done { color: var(--accent); border-color: var(--accent); }
  .block button.copy { position: absolute; top: 7px; right: 7px; opacity: 0; transition: opacity .12s; }
  .block:hover button.copy, .block button.copy.done { opacity: 1; }
  .tool .bubble { padding: 9px 13px; }
  .tool-head { display: flex; align-items: baseline; gap: 9px; font-size: 12.5px; }
  .tool-head b { color: var(--role); font-weight: 600; }
  .tool-head span { color: var(--muted); }
  details.result summary { cursor: pointer; font-size: 12px; color: var(--muted); list-style: none; }
  details.result summary::before { content: "\25B8  "; }
