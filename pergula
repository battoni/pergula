# HELPERS


def project_slug(directory: Path) -> str:
    return re.sub(r"[^a-zA-Z0-9]", "-", str(directory))


def signature(path: Path) -> str:
    info = path.stat()
    return f"{info.st_mtime_ns}:{info.st_size}"


def read_head(path: Path, limit: int = HEAD_BYTES) -> list[str]:
    with path.open("rb") as handle:
        chunk = handle.read(limit)

    lines = chunk.decode("utf-8", errors="replace").split("\n")
    if len(chunk) == limit:
        lines.pop()

    return lines


def read_tail(path: Path, limit: int = TAIL_BYTES) -> list[str]:
    size = path.stat().st_size
    with path.open("rb") as handle:
        if size > limit:
            handle.seek(size - limit)
        chunk = handle.read()

    lines = chunk.decode("utf-8", errors="replace").split("\n")
    if size > limit:
        lines.pop(0)

    return lines


def strip_noise(text: str) -> str:
    for pattern in NOISE_PATTERNS:
        text = pattern.sub("", text)

    return text.strip()


def summarize_tool(name: str, payload: dict) -> tuple[str, str]:
    """Return (one-line subtitle, copyable body) for a tool call."""
    if name == "Bash":
        return payload.get("description", ""), payload.get("command", "")

    for field in ("file_path", "path", "pattern", "url", "query", "prompt"):
        if field in payload:
            return str(payload[field])[:200], ""

    return "", ""


def session_meta(path: Path) -> dict:
    """Cheap metadata for one transcript, cached until the file changes."""
    key = str(path)
    stamp = signature(path)

    with _CACHE_LOCK:
        cached = _META_CACHE.get(key)
        fresh = cached and cached[0] == stamp
        if fresh:
            return cached[1]

    info = path.stat()
    small = info.st_size <= HEAD_BYTES + TAIL_BYTES
    head = read_head(path)
    tail = head if small else read_tail(path)

    meta = {
        "id": path.stem,
        "slug": path.parent.name,
        "cwd": "",
        "branch": "",
        "opening": "",
        "aiTitle": "",
        "customTitle": "",
        "color": "",
        "mtime": info.st_mtime,
        "size": info.st_size,
    }

    for line in head:
        if not line.strip():
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue

        learns_cwd = not meta["cwd"] and record.get("cwd")
        if learns_cwd:
            meta["cwd"] = record["cwd"]
            meta["branch"] = record.get("gitBranch") or ""

        learns_opening = not meta["opening"] and record.get("type") == "user"
        if learns_opening:
            content = (record.get("message") or {}).get("content")
            if isinstance(content, str):
                text = " ".join(strip_noise(content).split())
                if text:
                    meta["opening"] = text[:110]

        complete = meta["cwd"] and meta["opening"]
        if complete:
            break

    # Later records win: a session can be renamed or recoloured many times.
    for line in tail:
        boring = "title" not in line and "agent" not in line
        if boring:
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue

        kind = record.get("type")

        if kind == "ai-title":
            meta["aiTitle"] = record.get("aiTitle") or meta["aiTitle"]
            continue

        if kind == "custom-title":
            meta["customTitle"] = record.get("customTitle") or meta["customTitle"]
            continue

        if kind == "agent-name":
            meta["customTitle"] = meta["customTitle"] or (record.get("agentName") or "")
            continue

        if kind == "agent-color":
            meta["color"] = record.get("agentColor") or meta["color"]

    meta["title"] = meta["customTitle"] or meta["aiTitle"] or meta["opening"] or path.stem[:8]
    meta["renamed"] = bool(meta["customTitle"])

    with _CACHE_LOCK:
        _META_CACHE[key] = (stamp, meta)

    return meta


def live_sessions() -> dict:
    """session id -> {pid, status, name, since} for every session with a live process."""
    live: dict[str, dict] = {}
    try:
        entries = sorted(LIVE_PATH.glob("*.json"))
    except OSError:
        return live

    for entry in entries:
        try:
            record = json.loads(entry.read_text(encoding="utf-8"))
            pid = int(record["pid"])
            session = str(record["sessionId"])
        except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
            continue

        # A crashed session can leave its file behind; the pid is the truth.
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            continue
        except PermissionError:
            pass
        except OSError:
            continue

        status = record.get("status") or ""
        state = agent_state(session, status)
        hooks = agent_record(session)
        live[session] = {
            "pid": pid,
            "status": status,
            "state": state,
            "subagents": subagents_behind(hooks) if state == "working" else 0,
            "tab": tab_title(hooks),
            "name": record.get("name") or "",
            "since": record.get("startedAt", 0) / 1000,
        }

    return live


def agent_record(session: str) -> dict:
    """What the tab-status hooks wrote about a session, or nothing."""
    # The id names a file, so it must not be able to name one anywhere else.
    if not SESSION_ID.fullmatch(session):
        return {}

    try:
        record = json.loads((AGENT_STATE_PATH / f"{session}.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}

    return record if isinstance(record, dict) else {}


def tab_title(record: dict) -> str:
    """The name the terminal tab shows after the project: what `cc` was given,
    or the /rename. The hooks keep it apart from the project prefix, which the
    sidebar already says with the group the row sits in."""
    tab = record.get("tab")
    if not isinstance(tab, str):
        return ""

    return " ".join(tab.split())[:110]


def subagents_behind(record: dict) -> int:
    """Subagents still running after the main turn ended. The hooks read them
    from the CLI's own list of background tasks, so a dead one is not counted."""
    count = record.get("subagents")
    counted = isinstance(count, int) and count > 0 and record.get("turn_over")
    return count if counted else 0


def agent_state(session: str, status: str) -> str:
    """working, needs_you, ready or error, for a session with a live process."""
    fallback = "working" if status == "busy" else "ready"
    record = agent_record(session)
    state = record.get("state")

    if state not in AGENT_STATES:
        return fallback

    # Esc ends a turn without firing the Stop hook, so the file can still say
    # working long after the CLI went idle. The registry wins that one — unless
    # the turn ended on purpose and subagents are still at it in the background,
    # which the registry cannot see either.
    interrupted = state == "working" and status == "idle" and not subagents_behind(record)
    if interrupted:
        return "ready"

    # waiting is written when the turn ends with a shell still running. The
    # shell finishing wakes the agent with no prompt and no hook, so a busy
    # registry means it is already working on the result.
    woke = state == "waiting" and status == "busy"
    if woke:
        return "working"

    return state


def live_stamp(live: dict) -> str:
    return ",".join(
        f"{session}:{data['status']}:{data['state']}:{data.get('subagents', 0)}:{data.get('tab', '')}"
        for session, data in sorted(live.items())
    )


def save_caffeine(until: float, pid: int) -> None:
    body = json.dumps({"until": int(until), "pid": pid}, indent=2)
    CAFFEINE_PATH.write_text(body, encoding="utf-8")


def owns_pid(pid: int) -> bool:
    """A pid outlives the process that held it, so ask what answers to this one
    before signalling it. Killing a stranger to tidy up would be worse than
    leaving a stray `caffeinate` running."""
    probe = subprocess.run(["ps", "-p", str(pid), "-o", "comm="],
                           capture_output=True, text=True)
    return probe.stdout.strip().endswith("caffeinate")


def caffeine_reading() -> dict:
    """A deadline of zero means nothing is holding the Mac awake. The child is
    asked rather than the clock, because `caffeinate -t` ends on its own and the
    page must not go on counting down for a process that already exited.
    Callers hold _CAFFEINE_LOCK."""
    child = _CAFFEINE["child"]
    finished = child is None or child.poll() is not None
    if finished:
        _CAFFEINE["child"] = None
        _CAFFEINE["until"] = 0.0

    return {"until": int(_CAFFEINE["until"]), "hours": list(CAFFEINE_HOURS)}


def drop_caffeine() -> None:
    """Ends the assertion, if there is one. Callers hold _CAFFEINE_LOCK."""
    child = _CAFFEINE["child"]
    if child is not None:
        child.terminate()

    _CAFFEINE["child"] = None
    _CAFFEINE["until"] = 0.0


def caffeine_state() -> dict:
    with _CAFFEINE_LOCK:
        return caffeine_reading()


def start_caffeine(hours: float) -> dict:
    seconds = int(max(0.25, min(hours, CAFFEINE_LIMIT)) * 3600)
    with _CAFFEINE_LOCK:
        drop_caffeine()

        # -d holds the display, -i the idle sleep, -s the system sleep on mains
        # and -u says a user is present. Without -i the Mac sleeps anyway and
        # the agents stop with it, which is the whole point of the button.
        _CAFFEINE["child"] = subprocess.Popen(
            ["caffeinate", "-disu", "-t", str(seconds)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        _CAFFEINE["until"] = time.time() + seconds
        save_caffeine(_CAFFEINE["until"], _CAFFEINE["child"].pid)

        return caffeine_reading()


def stop_caffeine() -> dict:
    with _CAFFEINE_LOCK:
        drop_caffeine()
        save_caffeine(0.0, 0)

        return caffeine_reading()


def adopt_caffeine() -> None:
    """Restarting the agent takes the child with it — launchd kills the whole
    job — but the file it wrote outlives the process. Whatever is recorded there
    is either already dead or an orphan the page can no longer stop, so it goes
    and the deadline is cleared."""
    try:
        data = json.loads(CAFFEINE_PATH.read_text(encoding="utf-8"))
        pid = int(data.get("pid") or 0) if isinstance(data, dict) else 0
    except (OSError, ValueError, json.JSONDecodeError):
        return

    stray = pid > 0 and owns_pid(pid)
    if stray:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass

    save_caffeine(0.0, 0)


def load_names() -> dict:
    try:
        data = json.loads(NAMES_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}

    return data if isinstance(data, dict) else {}


def save_name(slug: str, label: str) -> dict:
    with _CACHE_LOCK:
        names = load_names()
        if label:
            names[slug] = label
        if not label:
            names.pop(slug, None)

        NAMES_PATH.write_text(json.dumps(names, ensure_ascii=False, indent=2), encoding="utf-8")

    return names


def names_stamp() -> str:
    try:
        return str(NAMES_PATH.stat().st_mtime_ns)
    except OSError:
        return "0"


def load_favourites() -> list[str]:
    try:
        data = json.loads(FAVOURITES_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []

    if not isinstance(data, list):
        return []

    return [str(slug) for slug in data][:FAVOURITE_LIMIT]


def save_favourites(slugs: list[str]) -> None:
    kept = json.dumps(slugs[:FAVOURITE_LIMIT], ensure_ascii=False, indent=2)
    FAVOURITES_PATH.write_text(kept, encoding="utf-8")


def set_favourite(slug: str, wanted: bool) -> list[str]:
    with _CACHE_LOCK:
        slugs = [one for one in load_favourites() if one != slug]

        # A new favourite joins the end, so the ones already there do not move.
        room = len(slugs) < FAVOURITE_LIMIT
        adding = wanted and room
        if adding:
            slugs.append(slug)

        save_favourites(slugs)

    return slugs


def move_favourite(was: str, slug: str) -> None:
    """Retitling a snippet moves its file; the star has to move with it."""
    with _CACHE_LOCK:
        slugs = load_favourites()
        if was not in slugs:
            return

        save_favourites([slug if one == was else one for one in slugs])


def favourites_stamp() -> str:
    try:
        return str(FAVOURITES_PATH.stat().st_mtime_ns)
    except OSError:
        return "0"


def snippet_slug(raw: str) -> str:
    """A snippet is addressed by its path: an optional folder, then a name. Both
    are reduced to the safe alphabet here, so nothing arriving from the page can
    walk out of the directory."""
    plain = unicodedata.normalize("NFD", str(raw)).encode("ascii", "ignore").decode("ascii")
    cleaned = [re.sub(r"[^a-z0-9]+", "-", part.lower()).strip("-") for part in plain.split("/")]
    parts = [part for part in cleaned if part][:2]

    return "/".join(parts)


def split_snippet(text: str) -> tuple[str, str]:
    """The first line names the snippet when it is a heading, and stays out of
    the clipboard. Everything under it is the prompt, verbatim."""
    head, _, rest = text.partition("\n")
    heading = re.match(r"^#\s+(.+?)\s*$", head)
    if not heading:
        return "", text

    return heading.group(1), rest.lstrip("\n")


def snippet_files() -> list[Path]:
    if not SNIPPETS_PATH.is_dir():
        return []

    loose = sorted(SNIPPETS_PATH.glob("*.md"))
    grouped = sorted(SNIPPETS_PATH.glob("*/*.md"))

    return loose + grouped


def snippets_token(files: list[Path]) -> str:
    """Built from stat() alone, so an unchanged library is answered without
    opening a single file."""
    try:
        stamps = [path.stat().st_mtime_ns for path in files]
    except OSError:
        return "0"

    return f"{len(stamps)}:{max(stamps, default=0)}:{favourites_stamp()}"


def load_snippets() -> list[dict]:
    found = []
    for path in snippet_files():
        try:
            text = path.read_text(encoding="utf-8")
            stamp = path.stat().st_mtime
        except OSError:
            continue

        slug = path.relative_to(SNIPPETS_PATH).with_suffix("").as_posix()
        group, _, name = slug.rpartition("/")
        title, body = split_snippet(text)
        found.append({
            "slug": slug,
            "group": group,
            "title": title or name.replace("-", " "),
            "body": body,
            "mtime": stamp,
        })

    found.sort(key=lambda item: (item["group"], item["title"].lower()))

    return found


def save_snippet(slug: str, title: str, body: str) -> None:
    path = SNIPPETS_PATH / f"{slug}.md"
    path.parent.mkdir(parents=True, exist_ok=True)
    heading = f"# {title}\n\n" if title else ""
    path.write_text(heading + body.strip() + "\n", encoding="utf-8")


def drop_snippet(slug: str) -> None:
    path = SNIPPETS_PATH / f"{slug}.md"
    try:
        path.unlink()
        # An empty group is an empty folder; left behind, it lists forever.
        spare = path.parent != SNIPPETS_PATH and not any(path.parent.iterdir())
        if spare:
            path.parent.rmdir()
    except OSError:
        return


def all_transcripts(scope: Path | None) -> list[Path]:
    if scope is not None:
        directory = PROJECTS / project_slug(scope)
        return list(directory.glob("*.jsonl")) if directory.is_dir() else []

    return list(PROJECTS.glob("*/*.jsonl"))


def find_transcript(scope: Path | None, session: str | None) -> Path | None:
    transcripts = all_transcripts(scope)
    if not transcripts:
        return None

    if session:
        for path in transcripts:
            if path.stem == session:
                return path

        return None

    return max(transcripts, key=lambda path: path.stat().st_mtime)


def build_index(scope: Path | None) -> dict:
    transcripts = all_transcripts(scope)
    if not transcripts:
        return {"token": "empty", "projects": [], "active": None}

    newest = max(transcripts, key=lambda path: path.stat().st_mtime)
    live = live_sessions()
    names = load_names()
    token = f"{len(transcripts)}:{newest}:{signature(newest)}:{names_stamp()}:{live_stamp(live)}"

    groups: dict[str, dict] = {}
    for path in transcripts:
        try:
            meta = session_meta(path)
        except OSError:
            continue

        running = live.get(meta["id"])
        tab = running.get("tab", "") if running else ""
        named_in_terminal = tab and not meta["customTitle"]
        if named_in_terminal:
            meta = {**meta, "title": tab, "renamed": True}

        meta = {
            **meta,
            "live": bool(running),
            "status": running["status"] if running else "",
            "state": running["state"] if running else "",
            "subagents": running["subagents"] if running else 0,
            "pid": running["pid"] if running else 0,
        }

        group = groups.setdefault(meta["slug"], {"slug": meta["slug"], "path": "", "sessions": []})
        first_cwd_seen = meta["cwd"] and not group["path"]
        if first_cwd_seen:
            group["path"] = meta["cwd"]
        group["sessions"].append(meta)

    projects = []
    for group in groups.values():
        group["sessions"].sort(key=lambda meta: meta["mtime"], reverse=True)
        group["path"] = group["path"] or group["slug"].lstrip("-").replace("-", "/")
        group["label"] = names.get(group["slug"], "")
        group["mtime"] = group["sessions"][0]["mtime"]
        projects.append(group)

    projects.sort(key=lambda group: group["mtime"], reverse=True)

    # Follow a session that is genuinely open before falling back to whichever
    # file was touched last — a finished session should not steal the view.
    running_ids = {meta["id"] for group in projects for meta in group["sessions"] if meta["live"]}
    active = newest.stem
    active_is_stale = running_ids and active not in running_ids
    if active_is_stale:
        candidates = [meta for group in projects for meta in group["sessions"] if meta["live"]]
        active = max(candidates, key=lambda meta: meta["mtime"])["id"]

    return {
        "token": token,
        "projects": projects,
        "active": active,
        "hasRegistry": LIVE_PATH.is_dir(),
    }


def drop_blobs(line: bytes) -> bytes:
    """The line with every long base64 value emptied. Base64 holds no quote, so
    the end of the value is the next one."""
    for key in BLOB_KEYS:
        start = line.find(key)
        if start == -1:
            continue

        parts = []
        cursor = 0
        while start != -1:
            value = start + len(key)
            end = line.find(b'"', value)
            if end == -1:
                break

            long_enough = end - value >= BLOB_MIN
            if long_enough:
                parts.append(line[cursor:value])
                cursor = end

            start = line.find(key, end)

        parts.append(line[cursor:])
        line = b"".join(parts)

    return line


def worth_parsing(line: bytes) -> bool:
    hidden = line.startswith(TYPED_OPENING) and not line.startswith(SHOWN_OPENINGS)
    return not hidden


def parse_lines(lines, messages: list[dict]) -> None:
    for line in lines:
        try:
            record = json.loads(line)
        except ValueError:
            continue

        if record.get("type") not in CONVERSATION_TYPES:
            continue

        message = record.get("message") or {}
        role = message.get("role")
        content = message.get("content")
        stamp = record.get("timestamp", "")

        # What the CLI injects on the user's behalf — a skill's body, an image
        # placeholder — is shown like any other turn, but nobody typed it.
        injected = bool(record.get("isMeta"))

        if isinstance(content, str):
            text = strip_noise(content)
            if text:
                messages.append({"role": role, "kind": "text", "text": text, "ts": stamp,
                                 "meta": injected})
            continue

        if not isinstance(content, list):
            continue

        for block in content:
            if not isinstance(block, dict):
                continue

            kind = block.get("type")

            if kind == "text":
                text = strip_noise(block.get("text", ""))
                if text:
                    messages.append({"role": role, "kind": "text", "text": text, "ts": stamp,
                                     "meta": injected})
                continue

            if kind == "tool_use":
                name = block.get("name", "tool")
                payload = block.get("input") or {}
                subtitle, body = summarize_tool(name, payload)
                messages.append({
                    "role": "tool",
                    "kind": "tool_use",
                    "name": name,
                    "subtitle": subtitle,
                    "text": body,
                    "ts": stamp,
                })
                continue

            if kind == "tool_result":
                body = block.get("content")
                if isinstance(body, list):
                    body = "\n".join(
                        part.get("text", "")
                        for part in body
                        if isinstance(part, dict) and part.get("type") == "text"
                    )
                text = (body or "").strip() if isinstance(body, str) else ""
                if text:
                    messages.append({"role": "tool", "kind": "tool_result", "text": text, "ts": stamp})



def state_token(path: Path, limit: int) -> str:
    """The identity of a response, from stat() alone — the file stays shut."""
    return f"{path}:{signature(path)}:{limit}"


def parse_transcript(path: Path) -> list[dict]:
    key = str(path)

    with _CACHE_LOCK:
        parse_lock = _PARSE_LOCKS.setdefault(key, threading.Lock())

    with parse_lock:
        return parse_transcript_locked(path, key)


def parse_transcript_locked(path: Path, key: str) -> list[dict]:
    size = path.stat().st_size

    with _CACHE_LOCK:
        cached = _MESSAGE_CACHE.get(key)

    unchanged = cached and cached[0] == size
    if unchanged:
        with _CACHE_LOCK:
            # Refresh its position: eviction drops the least recently used.
            if key in _MESSAGE_CACHE:
                _MESSAGE_CACHE[key] = _MESSAGE_CACHE.pop(key)
        return cached[1]

    # It grew: carry on from where we stopped. Shrunk or new: read from zero.
    resume = bool(cached) and cached[0] < size
    start, messages = (cached[0], list(cached[1])) if resume else (0, [])

    with path.open("rb") as handle:
        handle.seek(start)
        chunk = handle.read()

    # A live session may be mid-write, so only whole lines are consumed.
    end = chunk.rfind(b"\n")
    if end == -1:
        return messages

    # Bytes all the way to json.loads: decoding 60 MB to str and splitting that
    # cost more than the parse itself.
    lines = (drop_blobs(line) for line in chunk[:end].split(b"\n") if worth_parsing(line))
    parse_lines(lines, messages)

    with _CACHE_LOCK:
        _MESSAGE_CACHE.pop(key, None)
        _MESSAGE_CACHE[key] = (start + end + 1, messages)
        while len(_MESSAGE_CACHE) > MESSAGE_CACHE_LIMIT:
            _MESSAGE_CACHE.pop(next(iter(_MESSAGE_CACHE)))

    return messages


def clip_middle(text: str, limit: int = RESUME_CLIP) -> str:
    if len(text) <= limit:
        return text

    head = limit * 3 // 5
    tail = limit - head

    return f"{text[:head].rstrip()}\n[…]\n{text[-tail:].lstrip()}"


def resume_turns(messages: list[dict]) -> list[dict]:
    """The end of the conversation as prose alone. A session resumed after hours
    away pays for its whole context again; these few turns are what a new one
    needs to carry on, and they cost a page of text instead.

    A turn is everything one side said before the other spoke. Claude narrates
    between commands, so of its turn only the last thing said is kept — where it
    ended up, not how it got there."""
    turns: list[dict] = []
    for message in messages:
        unspoken = message["kind"] != "text" or message.get("meta")
        if unspoken:
            continue

        role, text = message["role"], message["text"]
        answers = not turns or turns[-1]["role"] != role
        if answers:
            turns.append({"role": role, "text": text})
            continue

        said = turns[-1]
        said["text"] = f"{said['text']}\n\n{text}" if role == "user" else text

    return [
        {"role": turn["role"], "text": clip_middle(turn["text"])}
        for turn in turns[-RESUME_TURNS:]
    ]


def build_state(scope: Path | None, session: str | None, limit: int) -> dict:
    path = find_transcript(scope, session)
    if path is None:
        return {"token": "empty", "session": None, "messages": [], "total": 0}

    messages = parse_transcript(path)
    total = len(messages)

    # A long session can carry thousands of turns; sending them all would stall
    # the page on every poll. The tail is what anyone is reading anyway.
    window = messages[-limit:] if limit and total > limit else messages

    return {
        "token": state_token(path, limit),
        "session": session_meta(path),
        "messages": window,
        "total": total,
        "resume": {"path": str(path), "turns": resume_turns(messages)},
    }


# USAGE

LEAF_FIELDS = ("calls", "input", "cache_read", "cache_write", "cache_write_1h", "output",
               "ctx_sum", "ctx_over_200k", "ctx_max", "starts", "first_ctx")
CWD_FIELD = re.compile(rb'"cwd":\s*"((?:[^"\\]|\\.)*)"')
MODEL_NAME = re.compile(r"^claude-([a-z]+)-(\d+)(?:-(\d{1,2}))?(?:-\d{8})?$")


def fresh_usage() -> dict:
    return {
        "version": USAGE_VERSION,
        "settings": {"quota_reset": dict(QUOTA_RESET)},
        "files": {},
        "folders": {},
        "titles": {},
        "hours": {},
        "versions": {},
        "seen": {},
    }


def set_aside_usage() -> None:
    """A summary that cannot be read is moved out of the way rather than
    overwritten: it may hold months the transcripts no longer have."""
    try:
        USAGE_PATH.replace(USAGE_PATH.with_name(USAGE_PATH.name + ".broken"))
    except OSError:
        return


def load_usage() -> dict:
    try:
        data = json.loads(USAGE_PATH.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return fresh_usage()
    except (OSError, ValueError):
        set_aside_usage()
        return fresh_usage()

    earlier = isinstance(data, dict) and data.get("version") in (1, 2)
    if earlier:
        data = migrate_usage(data)

    shape = fresh_usage()
    sound = (
        isinstance(data, dict)
        and data.get("version") == USAGE_VERSION
        and all(isinstance(data.get(key), dict) for key in shape if key != "version")
    )
    if not sound:
        set_aside_usage()
        return shape

    data["settings"]["quota_reset"] = quota_reset(data)
    return data


def migrate_usage(data: dict) -> dict:
    """Version 1 counted an id once per file, so a response copied into another
    file was counted again; version 2 kept too little beside each id. Every
    session whose transcript still exists is dropped and read afresh; the ones
    the CLI has deleted stay as they were, since nothing is left to read them
    from. Two things that cannot be told apart stay approximate: a deleted
    session whose history a living one copied is counted in both, and a day
    that mixes kept and re-read sessions loses the kept ones' version counts."""
    hours = data.get("hours")
    versions = data.get("versions")
    shaped = isinstance(hours, dict) and isinstance(versions, dict)
    if not shaped:
        return data

    present = {file_identity(path)[1] for path in usage_files()}
    days = set()
    for hour, projects in hours.items():
        for sessions in projects.values():
            for session in present & sessions.keys():
                del sessions[session]
                days.add(hour[:10])

    for hour in list(hours):
        hours[hour] = {project: sessions for project, sessions in hours[hour].items() if sessions}
        if not hours[hour]:
            del hours[hour]

    for day in days:
        versions.pop(day, None)

    return {**data, "version": USAGE_VERSION, "files": {}, "seen": {}}


def save_usage(state: dict) -> None:
    """Written beside the real file and renamed over it, so a crash mid-write
    leaves the previous summary whole instead of half of a new one."""
    temporary = USAGE_PATH.with_name(USAGE_PATH.name + ".tmp")
    temporary.write_text(json.dumps(state, separators=(",", ":")), encoding="utf-8")
    os.replace(temporary, USAGE_PATH)


def quota_reset(state: dict) -> dict:
    reset = (state.get("settings") or {}).get("quota_reset")
    if not isinstance(reset, dict):
        return dict(QUOTA_RESET)

    weekday = reset.get("weekday")
    hour = reset.get("hour")
    if not valid_quota_reset(weekday, hour):
        return dict(QUOTA_RESET)

    return {"weekday": weekday, "hour": hour}


def valid_quota_reset(weekday, hour) -> bool:
    """`type` and not `isinstance`: True is an int to Python, and would pass as one."""
    whole_hour = type(hour) is int and 0 <= hour <= 23
    return weekday in WEEKDAYS and whole_hour


def local_hour(stamp: str) -> str:
    """The local hour a UTC stamp fell in, or nothing. A day is the day on this
    machine's clock: work done at 23:00 belongs to the evening it was done in."""
    try:
        moment = datetime.fromisoformat(stamp.replace("Z", "+00:00"))
    except (ValueError, AttributeError):
        return ""

    if moment.tzinfo is None:
        return ""

    return moment.astimezone().strftime(HOUR_KEY)


def model_label(model: str) -> str:
    """claude-opus-5-5 reads as opus 5.5; anything else as it came."""
    found = MODEL_NAME.match(model)
    if not found:
        return model

    family, major, minor = found.groups()
    return f"{family} {major}.{minor}" if minor else f"{family} {major}"


def minor_version(version: str) -> str:
    """2.1.296 is 2.1: a patch release changes nothing worth marking."""
    parts = str(version).split(".")
    if len(parts) < 2:
        return ""

    return ".".join(parts[:2])


def price_of(model: str) -> tuple | None:
    for prefix, price in PRICES.items():
        if model.startswith(prefix):
            return price

    return None


def leaf_cost(model: str, leaf: dict) -> float | None:
    price = price_of(model)
    if price is None:
        return None

    short_writes = leaf["cache_write"] - leaf.get("cache_write_1h", 0)
    total = (
        leaf["input"] * price[0]
        + leaf["cache_read"] * price[1]
        + short_writes * price[2]
        + leaf.get("cache_write_1h", 0) * price[3]
        + leaf["output"] * price[4]
    )
    return total / 1_000_000


def leaf_tokens(leaf: dict) -> int:
    return leaf["input"] + leaf["cache_read"] + leaf["cache_write"] + leaf["output"]


def repository_root(cwd: str) -> str:
    """The repository a working directory belongs to. A worktree's common git
    directory is the main checkout's, so its work is summed there."""
    cached = _ROOTS.get(cwd)
    if cached is not None:
        return cached

    if not Path(cwd).is_dir():
        return ""

    try:
        probe = subprocess.run(
            ["git", "-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True, text=True, timeout=5,
        )
        common = probe.stdout.strip() if probe.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        common = ""

    root = cwd
    if common:
        root = str(Path(common).parent) if Path(common).name == ".git" else common

    _ROOTS[cwd] = root
    return root


def project_of(folder: str, home: tuple[str, bool], folders: dict) -> str:
    """Transcript folder to repository. A folder whose directory is gone keeps
    the answer it had last time; one never answered falls back to its name.
    `home` is a working directory and whether it is the folder's own."""
    cwd, own = home
    known = folders.get(folder)
    stray = not own
    if stray and known:
        return known

    root = repository_root(cwd) if cwd else ""
    if root and stray:
        return root

    if root:
        folders[folder] = root
        return root

    return folders.get(folder) or "/" + folder.lstrip("-").replace("-", "/")


def usage_files() -> list[Path]:
    """Sessions before subagents and older before newer, so a response copied
    into another file is counted where it was made: a fork's copy of its
    parent's history, or a continued session's copy of the one it continues."""
    return (sorted(PROJECTS.glob("*/*.jsonl"), key=modified_at)
            + sorted(PROJECTS.glob("*/*/subagents/*.jsonl"), key=modified_at))


def modified_at(path: Path) -> tuple[float, str]:
    try:
        return path.stat().st_mtime, str(path)
    except OSError:
        return 0.0, str(path)


def file_identity(path: Path) -> tuple[str, str, str]:
    """(folder, session, main or sub). A subagent's file sits under the folder
    named after the session that started it, and its work is that session's."""
    relative = path.relative_to(PROJECTS).parts
    if len(relative) == 2:
        return relative[0], path.stem, "main"

    return relative[0], relative[1], "sub"


def read_calls(lines: list[bytes]) -> list[dict]:
    """Every line in these lines that reports a response's usage, repeats
    included: merge_usage decides what was already counted."""
    calls = []
    for line in lines:
        if b'"usage"' not in line:
            continue
        try:
            record = json.loads(drop_blobs(line))
        except ValueError:
            continue

        message = record.get("message") if isinstance(record, dict) else None
        is_response = isinstance(message, dict) and record.get("type") == "assistant"
        if not is_response:
            continue

        usage = message.get("usage")
        model = message.get("model") or ""
        hour = local_hour(record.get("timestamp") or "")
        countable = isinstance(usage, dict) and hour and model and model != "<synthetic>"
        if not countable:
            continue

        key = message.get("id") or record.get("uuid") or ""
        if not key:
            continue

        written = usage.get("cache_creation") if isinstance(usage.get("cache_creation"), dict) else {}
        calls.append({
            "key": key,
            "hour": hour,
            "model": model,
            "version": minor_version(record.get("version") or ""),
            "input": int(usage.get("input_tokens") or 0),
            "cache_read": int(usage.get("cache_read_input_tokens") or 0),
            "cache_write": int(usage.get("cache_creation_input_tokens") or 0),
            "cache_write_1h": int(written.get("ephemeral_1h_input_tokens") or 0),
            "output": int(usage.get("output_tokens") or 0),
        })

    return calls


def read_usage(path: Path, entry: dict) -> tuple[dict, list[dict], tuple[str, bool]] | None:
    """What a transcript added since the offset in `entry`: the entry to keep,
    the calls found and where it ran (see home_directory), or nothing when it
    did not grow. The bookkeeping mirrors parse_transcript and fails as silently."""
    size = path.stat().st_size
    offset = int(entry.get("offset") or 0)
    if size == offset:
        return None

    # Transcripts only grow. One that shrank was rewritten, and reading it
    # again from zero would count what it still holds a second time.
    shrank = size < offset
    if shrank:
        return {**entry, "offset": size}, [], ("", False)

    with path.open("rb") as handle:
        handle.seek(offset)
        chunk = handle.read()

    end = chunk.rfind(b"\n")
    if end == -1:
        return None

    calls = read_calls(chunk[:end].split(b"\n"))

    home = ("", False) if entry.get("project") else home_directory(path, chunk[:end])

    return {**entry, "offset": offset + end + 1}, calls, home


def home_directory(path: Path, chunk: bytes) -> tuple[str, bool]:
    """The directory the CLI filed this transcript under, and whether it is
    that. A session can move to a scratch folder before its first record, so
    the one that names the transcript's folder wins over whichever came first."""
    folder = file_identity(path)[0]
    seen = []
    for found in CWD_FIELD.finditer(chunk):
        try:
            cwd = json.loads(b'"' + found.group(1) + b'"')
        except ValueError:
            continue

        if project_slug(Path(cwd)) == folder:
            return cwd, True

        seen.append(cwd)
        if len(seen) >= 50:
            break

    # None names the folder: a subagent sent elsewhere, typically. The folder's
    # own repository, once known, is a better answer than a scratch directory.
    return (seen[0] if seen else ""), False


def leaf_of(state: dict, project: str, session: str, kind: str, call: dict) -> dict:
    sessions = state["hours"].setdefault(call["hour"], {}).setdefault(project, {})
    leaf = sessions.setdefault(session, {}).setdefault(call["model"], {}).setdefault(kind, {})
    for field in LEAF_FIELDS:
        leaf.setdefault(field, 0)

    return leaf


def count_call(state: dict, project: str, session: str, kind: str, call: dict, entry: dict) -> None:
    """A response seen for the first time is a call. Seen again, it is a call
    already counted, and only output it did not report before is added, in the
    hour it was counted in: the first of its lines carries the opening tokens of
    the output, the last the whole of it. Everything else in its usage is the
    same on every line. A file whose first response is a copy has no base of
    its own: what it starts from is the history it inherited."""
    first = not entry.get("started")
    entry["started"] = True
    entry["oldest"] = min(entry.get("oldest") or call["hour"][:10], call["hour"][:10])

    day, before = seen_response(state["seen"], call)
    if before is None:
        state["seen"].setdefault(day, {})[call["key"]] = [call["output"], call["hour"][11:]]
        add_call(state, project, session, kind, call, first)
        return

    grown = call["output"] - before[0]
    if grown <= 0:
        return

    before[0] = call["output"]
    counted = {**call, "hour": day + "T" + before[1]}
    leaf_of(state, project, session, kind, counted)["output"] += grown


def seen_response(seen: dict, call: dict) -> tuple[str, list | None]:
    """Where a response was counted, if it was. Each line of a response carries
    its own time, so one begun before midnight can end after it."""
    day = call["hour"][:10]
    eve = (datetime.strptime(day, "%Y-%m-%d") - timedelta(days=1)).strftime("%Y-%m-%d")
    for candidate in (day, eve):
        found = seen.get(candidate, {}).get(call["key"])
        if found is not None:
            return candidate, found

    return day, None


def forget_seen(state: dict) -> None:
    """A day no transcript holds anymore has nothing left to copy from. The CLI
    deletes a transcript by when it was last written, not by when its responses
    were made, so a long session keeps old days alive until it goes."""
    held = [entry["oldest"] for entry in state["files"].values() if entry.get("oldest")]
    oldest = min(held, default=datetime.now().strftime("%Y-%m-%d"))
    for day in [day for day in state["seen"] if day < oldest]:
        del state["seen"][day]


def add_call(state: dict, project: str, session: str, kind: str, call: dict, first: bool) -> None:
    leaf = leaf_of(state, project, session, kind, call)

    context = call["input"] + call["cache_read"] + call["cache_write"]
    leaf["calls"] += 1
    for field in ("input", "cache_read", "cache_write", "cache_write_1h", "output"):
        leaf[field] += call[field]
    leaf["ctx_sum"] += context
    leaf["ctx_over_200k"] += int(context > CONTEXT_LARGE)
    leaf["ctx_max"] = max(leaf["ctx_max"], context)

    # The first call of a session or a subagent carries only what every call
    # carries: the system prompt, the tools, the rules. That is the fixed base.
    if first:
        leaf["starts"] += 1
        leaf["first_ctx"] += context

    if not call["version"]:
        return

    day = state["versions"].setdefault(call["hour"][:10], {})
    day[call["version"]] = day.get(call["version"], 0) + 1


def merge_usage(state: dict, path: Path, entry: dict, calls: list[dict], home: tuple[str, bool]) -> None:
    """Callers hold _USAGE_LOCK."""
    folder, session, kind = file_identity(path)
    project = entry.get("project") or project_of(folder, home, state["folders"])

    # A read that found no working directory, a transcript that so far holds
    # only its opening records, has only the folder's name to guess from, and
    # that guess turns battoni.dev into battoni/dev. It is not kept: the next
    # read looks again.
    settled = bool(home[0]) or folder in state["folders"]
    if settled:
        entry["project"] = project

    for call in calls:
        count_call(state, project, session, kind, call, entry)

    state["files"][str(path)] = entry


def remember_title(state: dict, path: Path) -> None:
    """Titles are read while the transcript exists, so a session keeps its name
    in the panel after the CLI has deleted the file."""
    _folder, session, kind = file_identity(path)
    if kind != "main":
        return

    try:
        title = session_meta(path)["title"]
    except OSError:
        return

    state["titles"][session] = {"title": title, "path": str(path)}


def usage_state() -> dict:
    """Callers hold _USAGE_LOCK."""
    if _USAGE["state"] is None:
        _USAGE["state"] = load_usage()

    return _USAGE["state"]


def index_usage() -> None:
    """One pass over every transcript, reading only what grew. The first pass
    reads everything; later ones read minutes of work."""
    claimed = _INDEX_LOCK.acquire(blocking=False)
    if not claimed:
        return

    try:
        index_usage_locked()
    finally:
        _INDEX_LOCK.release()


def index_usage_locked() -> None:
    with _USAGE_LOCK:
        state = usage_state()
        known = dict(state["files"])

    files = usage_files()
    with _USAGE_LOCK:
        _USAGE["done"] = 0
        _USAGE["total"] = len(files)

    changed = 0
    for path in files:
        try:
            result = read_usage(path, dict(known.get(str(path)) or {}))
        except OSError:
            result = None

        with _USAGE_LOCK:
            _USAGE["done"] += 1
            if result is None:
                continue

            entry, calls, home = result
            merge_usage(state, path, entry, calls, home)
            remember_title(state, path)
            changed += 1
            due = changed % USAGE_SAVE_EVERY == 0
            if due:
                save_usage(state)

    present = {str(path) for path in files}
    with _USAGE_LOCK:
        gone = [key for key in state["files"] if key not in present]
        for key in gone:
            del state["files"][key]

        forget_seen(state)
        if changed or gone:
            save_usage(state)

        _USAGE["ready"] = True


def usage_loop() -> None:
    while True:
        try:
            index_usage()
        except (OSError, ValueError) as error:
            print(f"pergula: usage index failed — {error}", file=sys.stderr, flush=True)

        time.sleep(USAGE_INTERVAL)


def usage_status() -> dict:
    with _USAGE_LOCK:
        return {"ready": _USAGE["ready"], "done": _USAGE["done"], "total": _USAGE["total"]}


def set_quota_reset(weekday: str, hour: int) -> dict:
    with _USAGE_LOCK:
        state = usage_state()
        state["settings"]["quota_reset"] = {"weekday": weekday, "hour": hour}
        save_usage(state)
        return quota_reset(state)


# Windows. Everything below works on naive local datetimes, and an hour is
# named by its key, so a window is a range of keys and comparing them is a
# string comparison.


def quota_week_start(moment: datetime, reset: dict) -> datetime:
    """The start of the quota week holding a local moment."""
    target = WEEKDAYS.index(reset["weekday"])
    start = moment.replace(hour=reset["hour"], minute=0, second=0, microsecond=0)
    start -= timedelta(days=(start.weekday() - target) % 7)
    if start > moment:
        start -= timedelta(days=7)

    return start


def month_start(moment: datetime, step: int = 0) -> datetime:
    index = moment.year * 12 + moment.month - 1 + step
    return datetime(index // 12, index % 12 + 1, 1)


def next_boundary(moment: datetime, unit: str) -> datetime:
    if unit == "hour":
        return moment.replace(minute=0, second=0, microsecond=0) + timedelta(hours=1)

    if unit == "day":
        return datetime(moment.year, moment.month, moment.day) + timedelta(days=1)

    return month_start(moment, 1)


def split_window(start: datetime, end: datetime, unit: str) -> list[tuple[datetime, datetime]]:
    bars = []
    cursor = start
    while cursor < end:
        following = next_boundary(cursor, unit)
        bars.append((cursor, min(following, end)))
        cursor = following

    return bars


def parse_day(text: str) -> datetime | None:
    try:
        return datetime.strptime(text, "%Y-%m-%d")
    except (TypeError, ValueError):
        return None


def usage_window(span: str, at: str, first: str, reset: dict) -> dict:
    """Start, end, bars and the neighbours of a window. `at` is an hour key
    inside the window wanted; for "custom" it is "from..to" in days."""
    if span not in SPANS:
        span = "week"

    try:
        moment = datetime.strptime(at, HOUR_KEY)
    except (TypeError, ValueError):
        moment = datetime.now().replace(minute=0, second=0, microsecond=0)

    if span == "day":
        start = datetime(moment.year, moment.month, moment.day)
        end = start + timedelta(days=1)
        unit = "hour"

    if span == "week":
        start = quota_week_start(moment, reset)
        end = start + timedelta(days=7)
        unit = "day"

    if span == "month":
        start = month_start(moment)
        end = month_start(moment, 1)
        unit = "day"

    if span == "year":
        start = datetime(moment.year, 1, 1)
        end = datetime(moment.year + 1, 1, 1)
        unit = "month"

    if span == "custom":
        head, _, tail = str(at).partition("..")
        start = parse_day(head) or datetime(moment.year, moment.month, moment.day)
        end = (parse_day(tail) or start) + timedelta(days=1)
        end = max(end, start + timedelta(days=1))
        unit = "day" if (end - start).days <= 62 else "month"

    length = end - start
    earlier = start - (length if span == "custom" else timedelta(hours=1))
    previous = (
        f"{earlier:%Y-%m-%d}..{start - timedelta(days=1):%Y-%m-%d}"
        if span == "custom" else earlier.strftime(HOUR_KEY)
    )
    following = (
        f"{end:%Y-%m-%d}..{end + length - timedelta(days=1):%Y-%m-%d}"
        if span == "custom" else end.strftime(HOUR_KEY)
    )

    has_earlier = bool(first) and first < start.strftime(HOUR_KEY)
    has_later = end <= datetime.now()

    # The ISO week holding the middle of a quota week holds most of it, so
    # that is the number the week goes by.
    middle = start + length / 2

    return {
        "span": span,
        "start": start.strftime(HOUR_KEY),
        "end": end.strftime(HOUR_KEY),
        "unit": unit,
        "week": middle.isocalendar()[1],
        "bars": [(head.strftime(HOUR_KEY), tail.strftime(HOUR_KEY))
                 for head, tail in split_window(start, end, unit)],
        "prev": previous if has_earlier else "",
        "next": following if has_later else "",
    }


def detect_milestones(state: dict) -> list[dict]:
    """A day whose most-used model, or whose Claude Code version x.y, is not
    the previous day's. Worked out from the summary each time, never stored,
    so a better rule rewrites the whole history."""
    models: dict[str, dict] = {}
    for hour, projects in state["hours"].items():
        day = models.setdefault(hour[:10], {})
        for sessions in projects.values():
            for by_model in sessions.values():
                for model, kinds in by_model.items():
                    # The model chosen for the session, not the cheaper one a
                    # subagent was handed: that changes with the task.
                    calls = (kinds.get("main") or {}).get("calls", 0)
                    if calls:
                        day[model] = day.get(model, 0) + calls

    found = []
    tracks = (("model", models, model_label), ("version", state["versions"], lambda name: f"claude code {name}"))
    for kind, days, label in tracks:
        before = ""
        for day in sorted(days):
            counts = days[day]
            if not counts:
                continue

            leader = max(sorted(counts), key=lambda name: counts[name])
            moved = before and leader != before
            if moved:
                found.append({"day": day, "kind": kind, "label": label(leader)})
            before = leader

    found.sort(key=lambda mark: (mark["day"], mark["kind"]))
    return found


def project_names(paths) -> dict:
    """A repository's nickname from the sidebar when it has one, else its
    folder's name."""
    names = load_names()
    return {path: names.get(project_slug(Path(path))) or Path(path).name or path for path in paths}


def blank_sums() -> dict:
    return {"calls": 0, "tokens": 0, "input": 0, "cache_read": 0, "cache_write": 0, "output": 0,
            "usd": 0.0, "unpriced": 0, "ctx_sum": 0, "ctx_over": 0, "starts": 0, "first_ctx": 0,
            "sub": 0}


def add_leaf(sums: dict, model: str, kind: str, leaf: dict) -> None:
    tokens = leaf_tokens(leaf)
    cost = leaf_cost(model, leaf)
    sums["calls"] += leaf["calls"]
    sums["tokens"] += tokens
    for field in ("input", "cache_read", "cache_write", "output"):
        sums[field] += leaf[field]
    sums["ctx_sum"] += leaf["ctx_sum"]
    sums["ctx_over"] += leaf["ctx_over_200k"]
    sums["usd"] += cost or 0.0
    sums["unpriced"] += tokens if cost is None else 0
    if kind == "sub":
        sums["sub"] += tokens
        return

    # The base is a session's: a subagent starts lighter, and mixing the two
    # would report neither.
    sums["starts"] += leaf["starts"]
    sums["first_ctx"] += leaf["first_ctx"]


def indicators(sums: dict) -> dict:
    calls = sums["calls"]
    return {
        "context": sums["ctx_sum"] / calls if calls else 0,
        "large": 100 * sums["ctx_over"] / calls if calls else 0,
        "base": sums["first_ctx"] / sums["starts"] if sums["starts"] else 0,
    }


def walk_leaves(state: dict, start: str, end: str):
    """(hour, project, session, model, kind, leaf) for every sum inside a window."""
    for hour in sorted(state["hours"]):
        inside = start <= hour < end
        if not inside:
            continue

        for project, sessions in state["hours"][hour].items():
            for session, by_model in sessions.items():
                for model, kinds in by_model.items():
                    for kind, leaf in kinds.items():
                        yield hour, project, session, model, kind, leaf


def usage_report(state: dict, span: str, at: str, off: set) -> dict:
    """Callers hold _USAGE_LOCK."""
    hours = sorted(state["hours"])
    first = hours[0] if hours else ""
    window = usage_window(span, at, first, quota_reset(state))

    # Colours go by the last thirty days, then by all time: the projects being
    # worked on get the eight colours, and moving the window does not repaint.
    recent = (datetime.now() - timedelta(days=30)).strftime(HOUR_KEY)
    weight: dict[str, tuple[int, int]] = {}
    for hour, project, _session, _model, _kind, leaf in walk_leaves(state, "", "~"):
        lately, ever = weight.get(project, (0, 0))
        fresh = leaf_tokens(leaf) if hour >= recent else 0
        weight[project] = (lately + fresh, ever + leaf_tokens(leaf))
    ranking = sorted(weight, key=lambda project: (-weight[project][0], -weight[project][1]))

    starts = [head for head, _tail in window["bars"]]
    bars = [{"start": head, "end": tail, "values": {}} for head, tail in window["bars"]]
    totals = blank_sums()
    projects: dict[str, dict] = {}
    for hour, project, _session, model, kind, leaf in walk_leaves(state, window["start"], window["end"]):
        add_leaf(projects.setdefault(project, blank_sums()), model, kind, leaf)
        if project in off:
            continue

        add_leaf(totals, model, kind, leaf)
        values = bars[bisect.bisect_right(starts, hour) - 1]["values"]
        values[project] = values.get(project, 0) + leaf_tokens(leaf)

    names = project_names(projects)
    rows = []
    for project, sums in projects.items():
        counted = bool(totals["tokens"]) and project not in off
        rows.append({
            "path": project,
            "name": names[project],
            "on": project not in off,
            "tokens": sums["tokens"],
            "calls": sums["calls"],
            "share": 100 * sums["tokens"] / totals["tokens"] if counted else 0,
            "sub": 100 * sums["sub"] / sums["tokens"] if sums["tokens"] else 0,
            "usd": sums["usd"],
            **indicators(sums),
        })
    rows.sort(key=lambda row: -row["tokens"])

    return {
        **window,
        "bars": bars,
        "first": first,
        "now": datetime.now().strftime(HOUR_KEY),
        "settings": quota_reset(state),
        "status": {"ready": _USAGE["ready"], "done": _USAGE["done"], "total": _USAGE["total"]},
        "prices": PRICES_DATE,
        "totals": {key: totals[key] for key in ("calls", "tokens", "input", "cache_read",
                                                "cache_write", "output", "usd", "unpriced")},
        "indicators": indicators(totals),
        "projects": rows,
        "ranking": ranking,
        "milestones": detect_milestones(state),
    }


def usage_sessions(state: dict, span: str, at: str, project: str) -> dict:
    """The sessions of one project inside a window, heaviest first. Callers
    hold _USAGE_LOCK."""
    hours = sorted(state["hours"])
    window = usage_window(span, at, hours[0] if hours else "", quota_reset(state))

    found: dict[str, dict] = {}
    for hour, owner, session, model, kind, leaf in walk_leaves(state, window["start"], window["end"]):
        if owner != project:
            continue

        row = found.setdefault(session, {"id": session, "first": hour, "tokens": 0, "calls": 0,
                                         "subagents": 0, "sub": 0, "context": 0, "usd": 0.0})
        tokens = leaf_tokens(leaf)
        row["tokens"] += tokens
        row["calls"] += leaf["calls"]
        row["context"] = max(row["context"], leaf["ctx_max"])
        row["usd"] += leaf_cost(model, leaf) or 0.0
        if kind == "sub":
            row["subagents"] += leaf["starts"]
            row["sub"] += tokens

    for session, row in found.items():
        known = state["titles"].get(session) or {}
        row["title"] = known.get("title") or session[:8]
        row["exists"] = bool(known.get("path")) and Path(known["path"]).exists()

    rows = sorted(found.values(), key=lambda row: -row["tokens"])
    return {**window, "project": project, "name": project_names([project])[project], "sessions": rows}


# WORK
#
# The Work tab: one card per worktree of every repository a session ran in.
# Read-only by design. git, the worktree's own record (.worktree.json), its
# specs/ folder, Valet's site links and the transcripts are read; GitHub is
# asked through `gh` and the answer kept five minutes. Nothing is fetched and
# nothing is changed: tearing a worktree down stays with `make wt-down`, which
# has the checks, so a card only offers that command to copy.

# A Valet site is a link in this folder, named after its host minus the TLD.
VALET_SITES = Path.home() / ".config" / "valet" / "Sites"
PR_CACHE_SECONDS = 300
IDLE_DAYS = 7
WORK_RECORD = ".worktree.json"
# Each card costs a few git calls and one gh call; one at a time, a machine with
# fifty worktrees waited most of a minute for the first answer.
WORK_THREADS = 8
TEARDOWN_TARGET = re.compile(r"^wt-down:", re.MULTILINE)

# (repository, branch) -> (asked at, pull requests or None when gh failed)
_PULL_REQUESTS: dict[tuple[str, str], tuple[float, list | None]] = {}
_PULL_REQUESTS_LOCK = threading.Lock()

# transcript -> (signature, the working directories it names)
_CWDS_CACHE: dict[str, tuple[str, set[str]]] = {}


def git_output(where: str, *arguments: str) -> str | None:
    """What git printed, or None when it failed or is not there."""
    try:
        probe = subprocess.run(["git", "-C", where, *arguments],
                               capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None

    if probe.returncode != 0:
        return None

    return probe.stdout


def list_worktrees(repo: str) -> list[dict]:
    """`git worktree list --porcelain` as {path, branch}, the main checkout first."""
    text = git_output(repo, "worktree", "list", "--porcelain")
    if text is None:
        return []

    found: list[dict] = []
    for line in text.splitlines():
        if line.startswith("worktree "):
            found.append({"path": line[len("worktree "):], "branch": "", "bare": False})
            continue

        if not found:
            continue

        if line.startswith("branch refs/heads/"):
            found[-1]["branch"] = line[len("branch refs/heads/"):]
            continue

        if line == "bare":
            found[-1]["bare"] = True

    return found


def session_cwds(path: Path) -> set[str]:
    """Every working directory a transcript names in its head and tail. A session
    that moved into a worktree (EnterWorktree) names it only after the move."""
    stamp = signature(path)
    cached = _CWDS_CACHE.get(str(path))
    fresh = cached is not None and cached[0] == stamp
    if fresh:
        return cached[1]

    found: set[str] = set()
    for chunk in (read_head(path), read_tail(path)):
        for line in chunk:
            for match in CWD_FIELD.finditer(line.encode("utf-8")):
                try:
                    found.add(json.loads(b'"' + match.group(1) + b'"'))
                except ValueError:
                    continue

    _CWDS_CACHE[str(path)] = (stamp, found)
    return found


def inside(cwd: str, folder: str) -> bool:
    return cwd == folder or cwd.startswith(folder.rstrip("/") + "/")


def read_record(tree: Path) -> dict:
    try:
        record = json.loads((tree / WORK_RECORD).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}

    return record if isinstance(record, dict) else {}


def feature_of(tree: Path, feature: str) -> tuple[str, str]:
    """(title, stage) from specs/<id>-*/: the intent's heading and the state's Stage line."""
    folders = sorted((tree / "specs").glob(f"{feature}-*")) if feature else []
    if not folders:
        return "", ""

    return heading_of(folders[0] / "intent.md"), stage_of(folders[0] / "state.md")


def heading_of(path: Path) -> str:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return ""

    heading = lines[0] if lines else ""
    return re.sub(r"^#\s*(Intent:\s*)?", "", heading).strip()


def stage_of(path: Path) -> str:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return ""

    return next((line[len("Stage:"):].strip() for line in lines if line.startswith("Stage:")), "")


def environment_of(record: dict) -> dict | None:
    """The links, ports and database the record names, and whether Valet serves it."""
    hosts = record.get("hosts") if isinstance(record.get("hosts"), dict) else {}
    ports = record.get("ports") if isinstance(record.get("ports"), dict) else {}
    api = hosts.get("api") or ""
    app = hosts.get("app") or ""
    if not api:
        return None

    vite = ports.get("vite")
    site = VALET_SITES / api.rsplit(".", 1)[0]
    linked = site.exists() or site.is_symlink()
    return {
        "app": f"https://{app}:{vite}" if app and vite else "",
        "api": f"https://{api}",
        "port": vite,
        "e2e": ports.get("e2e"),
        "database": record.get("database") or "",
        "up": linked,
    }


def pull_requests(repo: str, branch: str) -> list | None:
    """The branch's pull requests from `gh`, kept five minutes; None when gh fails."""
    key = (repo, branch)
    now = time.time()
    with _PULL_REQUESTS_LOCK:
        cached = _PULL_REQUESTS.get(key)

    fresh = cached is not None and now - cached[0] < PR_CACHE_SECONDS
    if fresh:
        return cached[1]

    prs = None
    try:
        probe = subprocess.run(
            ["gh", "pr", "list", "--head", branch, "--state", "all", "--json", "number,state,mergedAt"],
            cwd=repo, capture_output=True, text=True, timeout=15,
        )
        answered = probe.returncode == 0
        prs = json.loads(probe.stdout) if answered else None
    except (OSError, subprocess.SubprocessError, ValueError):
        prs = None

    prs = prs if isinstance(prs, list) else None
    with _PULL_REQUESTS_LOCK:
        _PULL_REQUESTS[key] = (now, prs)

    return prs


def work_status(prs: list | None, last_activity: float) -> tuple[str, str]:
    """(active, merged or left, the reason), the same rules `make wt-gc` applies."""
    merged = next((pr for pr in prs or [] if pr.get("state") == "MERGED"), None)
    if merged:
        return "merged", f"PR #{merged.get('number')} merged {merged.get('mergedAt') or ''}".strip()

    states = {pr.get("state") for pr in prs or []}
    closed = prs and not states & {"MERGED", "OPEN"}
    if closed:
        return "left", f"PR #{prs[0].get('number')} closed unmerged"

    idle = time.time() - last_activity
    if idle < IDLE_DAYS * 86400:
        return "active", ""

    return "left", f"no commit or session for {int(idle // 86400)} days"


def tears_down(checkout: str) -> bool:
    """Whether this checkout's Makefile has `wt-down`. Without one there is no command to offer."""
    try:
        makefile = (Path(checkout) / "Makefile").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False

    return bool(TEARDOWN_TARGET.search(makefile))


def work_card(repo: str, tree: dict, sessions: list[dict], teardown: bool) -> dict:
    path = Path(tree["path"])
    record = read_record(path)
    feature = str(record.get("id") or path.name)
    title, stage = feature_of(path, feature)
    branch = tree["branch"]

    ahead_text = git_output(str(path), "rev-list", "--count", "origin/main..HEAD")
    status_text = git_output(str(path), "status", "--porcelain") or ""
    committed_text = (git_output(str(path), "log", "-1", "--format=%ct", "HEAD") or "0").strip()
    dirty = len([line for line in status_text.splitlines() if line.strip()])
    counted = bool(ahead_text) and ahead_text.strip().isdigit()

    last_session = max((session["mtime"] for session in sessions), default=0.0)
    last_activity = max(float(committed_text or 0), last_session)
    prs = pull_requests(repo, branch) if branch else None
    status, reason = work_status(prs, last_activity)
    pr = (prs or [None])[0]
    offers_teardown = status != "active" and teardown

    return {
        "repo": repo,
        "repoName": Path(repo).name,
        "path": str(path),
        "id": feature,
        "label": str(record.get("label") or ""),
        "record": bool(record),
        "title": title,
        "stage": stage,
        "branch": branch,
        "ahead": int(ahead_text) if counted else None,
        "dirty": dirty,
        "clean": dirty == 0,
        "env": environment_of(record),
        "sessions": sessions,
        "status": status,
        "reason": reason,
        "command": f"make wt-down ID={feature}" if offers_teardown else "",
        "pr": pr,
        "github": prs is not None,
        "lastActivity": last_activity,
    }


def work_index() -> dict:
    """Every worktree but the main checkout, of every repository seen in a session cwd."""
    live = live_sessions()
    seen: list[tuple[dict, set[str]]] = []
    repositories: set[str] = set()
    for path in all_transcripts(None):
        try:
            meta = session_meta(path)
            cwds = session_cwds(path)
        except OSError:
            continue

        seen.append((meta, cwds))
        repositories.update(root for root in map(repository_root, cwds) if root)

    jobs = []
    for repo in sorted(repositories):
        trees = list_worktrees(repo)
        # Any checkout will do: a branch cut before the tooling, or a main that
        # has not merged it yet, still has a sibling the command runs from.
        teardown = any(tears_down(tree["path"]) for tree in trees if not tree["bare"])
        for tree in trees[1:]:
            missing = tree["bare"] or not Path(tree["path"]).is_dir()
            if missing:
                continue

            sessions = [
                {
                    "id": meta["id"],
                    "slug": meta["slug"],
                    "title": meta["title"],
                    "mtime": meta["mtime"],
                    "live": meta["id"] in live,
                    "state": (live.get(meta["id"]) or {}).get("state", ""),
                }
                for meta, cwds in seen
                if any(inside(cwd, tree["path"]) for cwd in cwds)
            ]
            sessions.sort(key=lambda session: session["mtime"], reverse=True)
            jobs.append((repo, tree, sessions, teardown))

    with ThreadPoolExecutor(max_workers=WORK_THREADS) as pool:
        cards = list(pool.map(lambda job: work_card(*job), jobs))

    cards.sort(key=lambda card: (card["repoName"], -card["lastActivity"]))
    return {"worktrees": cards, "github": all(card["github"] for card in cards)}


