# LAUNCHING


def probe(port: int) -> bool:
    """Is one of ours already listening there?"""
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/ping", timeout=1.5) as response:
            return response.headers.get("X-Pergula") == "1"
    except (urllib.error.URLError, OSError):
        return False


def open_window(address: str) -> None:
    chrome = "/Applications/Google Chrome.app"
    if Path(chrome).is_dir():
        subprocess.Popen(
            ["open", "-na", chrome, "--args", f"--app={address}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return

    subprocess.Popen(["open", address], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def launchctl(*arguments: str) -> subprocess.CompletedProcess:
    return subprocess.run(["launchctl", *arguments], capture_output=True, text=True)


def install_agent(port: int) -> None:
    script = Path(__file__).resolve()
    if not Path(AGENT_PYTHON).exists():
        sys.exit(f"pergula: {AGENT_PYTHON} does not exist — install the Command Line Tools")

    target = f"gui/{os.getuid()}"
    already_ours = launchctl("print", f"{target}/{AGENT_LABEL}").returncode == 0

    # A foreign listener would make the agent fail to bind, and KeepAlive would
    # retry that failure forever without ever saying so.
    foreign_listener = probe(port) and not already_ours
    if foreign_listener:
        sys.exit(
            f"pergula: something is already listening on 127.0.0.1:{port}.\n"
            "  Stop it (ctrl+c in its terminal) and run this again,\n"
            f"  or pick another port: pergula --install --port {port + 1}"
        )

    AGENT_PLIST.parent.mkdir(parents=True, exist_ok=True)
    AGENT_LOG.parent.mkdir(parents=True, exist_ok=True)

    AGENT_PLIST.write_bytes(plistlib.dumps({
        "Label": AGENT_LABEL,
        "ProgramArguments": [AGENT_PYTHON, str(script), "--serve", "--port", str(port)],
        "RunAtLoad": True,
        "KeepAlive": True,
        "ProcessType": "Background",
        "StandardOutPath": str(AGENT_LOG),
        "StandardErrorPath": str(AGENT_LOG),
    }))

    launchctl("bootout", f"{target}/{AGENT_LABEL}")
    result = launchctl("bootstrap", target, str(AGENT_PLIST))
    if result.returncode != 0:
        sys.exit(f"pergula: launchctl bootstrap failed — {result.stderr.strip() or result.stdout.strip()}")

    print(f"pergula: agent installed at {AGENT_PLIST}")
    print(f"  interpreter: {AGENT_PYTHON}")
    print(f"  log: {AGENT_LOG}")
    print("  runs at login, restarted if it dies")

    for _ in range(12):
        if probe(port):
            print(f"\n  serving at http://127.0.0.1:{port}")
            print("  from any terminal now, just run: pergula")
            return

        time.sleep(0.5)

    print(f"\n  WARNING: nothing answered on {port} after 6s — see {AGENT_LOG}")


def uninstall_agent() -> None:
    result = launchctl("bootout", f"gui/{os.getuid()}/{AGENT_LABEL}")
    removed = False
    if AGENT_PLIST.exists():
        AGENT_PLIST.unlink()
        removed = True

    failed = not removed and result.returncode != 0
    if failed:
        print("pergula: no agent installed")
        return

    print(f"pergula: agent removed ({AGENT_PLIST})")


def report_status(port: int) -> None:
    address = f"http://127.0.0.1:{port}"
    print(f"pergula: {address} — {'serving' if probe(port) else 'nothing listening'}")

    installed = AGENT_PLIST.exists()
    print(f"  login agent: {'installed' if installed else 'not installed'}")
    if not installed:
        return

    result = launchctl("print", f"gui/{os.getuid()}/{AGENT_LABEL}")
    if result.returncode != 0:
        print("  state: plist on disk but not loaded (run pergula --install)")
        return

    seen = set()
    for line in result.stdout.splitlines():
        stripped = line.strip()
        field = stripped.split("=")[0].strip()
        interesting = field in ("state", "pid", "last exit code") and field not in seen
        if interesting:
            seen.add(field)
            print(f"  {stripped}")


# EVENTS


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--port", type=int, default=7373)
    parser.add_argument("--here", action="store_true", help="only list sessions from the current directory")
    parser.add_argument("--serve", action="store_true", help="always serve in the foreground")
    parser.add_argument("--open", action="store_true", help="open the window (implied when a server is up)")
    parser.add_argument("--install", action="store_true", help="run at login as a background agent")
    parser.add_argument("--uninstall", action="store_true", help="remove that agent")
    parser.add_argument("--status", action="store_true", help="say whether anything is listening")
    arguments = parser.parse_args()

    if arguments.uninstall:
        uninstall_agent()
        return

    if arguments.install:
        install_agent(arguments.port)
        return

    if arguments.status:
        report_status(arguments.port)
        return

    if not PROJECTS.is_dir():
        sys.exit(f"pergula: {PROJECTS} does not exist — is Claude Code installed?")

    address = f"http://127.0.0.1:{arguments.port}"

    # Someone is already serving, so this invocation is a request for a window,
    # not for a second server. This is what makes `pergula` work from any
    # terminal once the agent is installed.
    already_serving = not arguments.serve and probe(arguments.port)
    if already_serving:
        open_window(address)
        print(f"pergula: {address} (already serving)")
        return

    Handler.scope = Path.cwd() if arguments.here else None

    try:
        server = ThreadingHTTPServer(("127.0.0.1", arguments.port), Handler)
    except OSError as error:
        sys.exit(f"pergula: cannot bind {address} — {error}")

    started = time.time()
    index = build_index(Handler.scope)
    sessions = sum(len(group["sessions"]) for group in index["projects"])
    print(f"pergula: {address}", flush=True)
    print(f"  {len(index['projects'])} projects, {sessions} sessions indexed in {time.time() - started:.1f}s", flush=True)
    print("  ctrl+c to stop", flush=True)

    wants_window = arguments.open or not arguments.serve
    if wants_window:
        open_window(address)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\npergula: stopped")


if __name__ == "__main__":
    main()
