// The work view filters its cards, not the tree, and redraws only on a key:
// the index poll would otherwise rebuild every card under the pointer.
function filtered() {
  if (view === 'work') drawWork();
  drawTree();
}

filter.addEventListener('input', filtered);

filter.addEventListener('keydown', (event) => {
  if (event.key !== 'Escape') return;
  filter.value = '';
  filter.blur();
  filtered();
});

awake.addEventListener('click', toggleAwake);

// A deploy restarts the agent and takes the caffeinate with it, so a tab left
// open can be showing a countdown that no longer means anything.
document.addEventListener('visibilitychange', () => {
  if (document.hidden) return;
  loadAwake();
});

langPt.addEventListener('click', () => setLang('pt'));
langEn.addEventListener('click', () => setLang('en'));

focusChip.addEventListener('click', toggleFocus);

scopeLive.addEventListener('click', () => setScope('live'));
scopeAll.addEventListener('click', () => setScope('all'));

// cmd/ctrl + 1..9 jumps to the Nth session on the list, in the order shown.
// Both modifiers are bound: in a normal Chrome tab cmd+N belongs to the tab
// strip, and only the --open window is free of it.
// cmd+A then cmd+F, with the modifier held, turns focus on or off. A on its own
// still selects everything; only an F that follows it within the second is taken.
const CHORD_MS = 1000;
let chordAt = 0;

window.addEventListener('keydown', (event) => {
  const hasModifier = event.metaKey || event.ctrlKey;
  if (!hasModifier) return;
  if (event.altKey) return;

  // Pressing cmd again between the two letters is not a key of its own here.
  const onlyModifier = event.key === 'Meta' || event.key === 'Control';
  if (onlyModifier) return;

  if (event.key === 'a') {
    chordAt = performance.now();
    return;
  }

  const closesChord = event.key === 'f' && performance.now() - chordAt < CHORD_MS;
  chordAt = 0;
  if (closesChord) {
    event.preventDefault();
    window.getSelection().removeAllRanges();
    toggleFocus();
    return;
  }

  if (event.key === 'b') {
    event.preventDefault();
    toggleRail();
    return;
  }

  if (event.key === 'f') {
    event.preventDefault();
    filter.focus();
    filter.select();
    return;
  }

  // The palette answers from anywhere, including mid-transcript: it is the one
  // shortcut that does not care which view the rail is showing.
  if (event.key === 'k') {
    event.preventDefault();
    openPalette();
    return;
  }

  const saving = event.key === 's' && view === 'library';
  if (saving) {
    event.preventDefault();
    saveNow();
    return;
  }

  const ordinal = Number(event.key);
  const inRange = Number.isInteger(ordinal) && ordinal >= 1 && ordinal <= 9;
  if (!inRange) return;

  const id = visibleRows[ordinal - 1];
  if (!id) return;

  event.preventDefault();

  if (view === 'library') {
    openSnippet(id);
    return;
  }

  onPick(id);
  toBottom(false);
});

follow.addEventListener('change', () => {
  if (!follow.checked) return;
  selectedId = null;
  stateToken = '';
  pinnedToBottom = true;
  schedulePoll(0);
});

function labelRail(off) {
  const text = t(off ? 'showList' : 'hideList');
  railTip.textContent = text + ' \u00b7 cmd+B';
  railToggle.setAttribute('aria-label', text);
}

function toggleRail() {
  const off = document.body.classList.toggle('railed-off');
  labelRail(off);
  localStorage.setItem('pergula:rail', off ? '0' : '1');
}

railToggle.addEventListener('click', toggleRail);

// The rail's width follows a drag on its right edge and is kept per browser.
// Long project and session names on a wide screen are the reason it exists;
// the clamp keeps the reading column from being squeezed out.
const RAIL_MIN = 220;
const RAIL_MAX = 720;

function clampRail(width) {
  const ceiling = Math.min(RAIL_MAX, Math.round(window.innerWidth * 0.6));
  return Math.max(RAIL_MIN, Math.min(ceiling, Math.round(width)));
}

function setRailWidth(width) {
  document.body.style.setProperty('--rail-width', clampRail(width) + 'px');
}

function onGripDown(event) {
  if (event.button !== 0) return;

  event.preventDefault();
  railGrip.setPointerCapture(event.pointerId);
  document.body.classList.add('resizing');
}

function onGripMove(event) {
  if (!railGrip.hasPointerCapture(event.pointerId)) return;

  setRailWidth(event.clientX);
}

function onGripUp(event) {
  if (!railGrip.hasPointerCapture(event.pointerId)) return;

  railGrip.releasePointerCapture(event.pointerId);
  document.body.classList.remove('resizing');
  localStorage.setItem('pergula:rail-width', String(rail.getBoundingClientRect().width));
}

function onGripReset() {
  document.body.style.removeProperty('--rail-width');
  localStorage.removeItem('pergula:rail-width');
}

// A width saved on a wide screen is re-clamped when the window narrows, so the
// reading column keeps its share; widening again gives the saved width back.
function restoreRailWidth() {
  const saved = Number(localStorage.getItem('pergula:rail-width'));
  if (saved) setRailWidth(saved);
}

restoreRailWidth();
window.addEventListener('resize', restoreRailWidth);

railGrip.addEventListener('pointerdown', onGripDown);
railGrip.addEventListener('pointermove', onGripMove);
railGrip.addEventListener('pointerup', onGripUp);
railGrip.addEventListener('pointercancel', onGripUp);
railGrip.addEventListener('dblclick', onGripReset);

options.querySelector('.fold-head').addEventListener('click', () => toggleFold(options));

// The session in a page of text, to paste into a new one: what it was, where
// its transcript is, and the last things said.
function resumePrompt() {
  const where = (session.cwd || session.slug) + (session.branch ? ' (' + session.branch + ')' : '');
  const turns = resume.turns.map((turn) => {
    return '[' + t(turn.role === 'user' ? 'roleYou' : 'roleClaude') + ']\n' + turn.text;
  });

  return [
    t('resumeIntro'),
    '',
    t('resumeSession') + ': ' + session.title,
    'ID: ' + session.id,
    t('resumeProject') + ': ' + where,
    'Transcript: ' + resume.path,
    '',
    t('resumeRecent') + ':',
    '',
    turns.join('\n\n'),
    '',
    t('resumeAsk'),
  ].join('\n');
}

function copyFromTop(button, tip, payload, hit) {
  // A second click while the answer is still showing would remember the answer
  // as the hint, and put it back for good.
  if (tip.dataset.busy) return;

  const previous = tip.innerHTML;
  tip.dataset.busy = '1';

  // Without the catch, a refusal from the clipboard gave no sign at all: the
  // click simply did nothing visible.
  const restore = () => setTimeout(() => {
    tip.innerHTML = previous;
    tip.dataset.busy = '';
    button.classList.remove('done');
  }, 1400);

  navigator.clipboard.writeText(payload).then(() => {
    tip.textContent = hit;
    button.classList.add('done');
    restore();
  }).catch(() => {
    tip.textContent = t('copyFailed');
    restore();
  });
}

copySid.addEventListener('click', () => {
  if (!session) return;

  copyFromTop(copySid, sidEl, session.id, t('idCopied'));
});

copyResume.addEventListener('click', () => {
  const ready = session && resume && resume.turns.length;
  if (!ready) return;

  copyFromTop(copyResume, resumeTip, resumePrompt(), t('resumeCopied'));
});

function onPick(id) {
  selectedId = id;
  follow.checked = false;
  limit = DEFAULT_LIMIT;
  rendered = [];
  stateToken = '';
  pinnedToBottom = true;
  drawTree();
  paintPicked(id);
  schedulePoll(0);
}

// The last sessions read, as the server last sent them. Going back to one paints
// it at once from here; the poll that follows sends its token and gets a 204, or
// the few turns that arrived meanwhile.
const PAINTED_LIMIT = 12;
const painted = new Map();

function remember(payload) {
  const cacheable = limit === DEFAULT_LIMIT && payload.session;
  if (!cacheable) return;

  painted.delete(payload.session.id);
  painted.set(payload.session.id, payload);
  if (painted.size > PAINTED_LIMIT) painted.delete(painted.keys().next().value);
}

// A click answers in the same frame: the header takes the new session from the
// index straight away, and the feed shows the cached turns or says it is loading.
// Leaving the old conversation on screen under the new name read as a dead click.
function paintPicked(id) {
  const known = painted.get(id);
  if (known) {
    onState(known);
    return;
  }

  session = projects.flatMap((project) => project.sessions).find((meta) => meta.id === id) || null;
  resume = null;
  messages = [];
  total = 0;
  drawTop();

  const loading = document.createElement('div');
  loading.className = 'empty';
  loading.textContent = t('loading');
  feed.replaceChildren(loading);
}

function onIndex(payload) {
  indexToken = payload.token;
  hasRegistry = payload.hasRegistry !== false;
  projects = payload.projects;
  activeId = payload.active;
  drawTree();
  drawAttention();
  paintFocus();
}

function onState(payload) {
  const sameSession = session && payload.session && session.id === payload.session.id;
  const next = payload.messages;

  stateToken = payload.token;
  session = payload.session;
  resume = payload.resume || null;
  total = payload.total || next.length;
  drawTop();

  // Never yank the page while text is selected — that is the whole point here.
  const selecting = !window.getSelection().isCollapsed;
  const wasPinned = pinnedToBottom;

  const canAppend = sameSession && appendable(next);
  messages = next;

  if (canAppend) drawDelta(next);
  if (!canAppend) draw();

  const shouldStayAtBottom = wasPinned && !selecting;
  if (shouldStayAtBottom) toBottom(false);
  if (!wasPinned) jump.classList.add('show');
}

// Switching session cannot wait for the next tick: that was up to 700 ms of dead
// time before the fetch even began. schedulePoll(0) serves it immediately.
let pollTimer = null;
let pollRun = 0;
let pollAbort = null;

function schedulePoll(delay) {
  clearTimeout(pollTimer);
  pollTimer = setTimeout(pollState, delay);
}

async function pollState() {
  const run = ++pollRun;

  // A request for the session just left is dropped, not waited on: the browser
  // keeps six connections to a host, and stale ones queued the new one behind.
  if (pollAbort) pollAbort.abort();
  pollAbort = new AbortController();
  const signal = pollAbort.signal;

  try {
    const target = follow.checked ? '' : (selectedId || '');
    const url = '/api/state?session=' + encodeURIComponent(target)
      + '&limit=' + limit
      + '&since=' + encodeURIComponent(stateToken);
    const response = await fetch(url, { signal });

    // A newer switch began while this response was in flight. Applying it now
    // would paint the old session over the one the person just chose.
    if (run !== pollRun) return;

    if (response.status === 200) {
      const payload = await response.json();
      if (run !== pollRun) return;
      const changedSession = !session || !payload.session || session.id !== payload.session.id;
      onState(payload);
      remember(payload);
      const following = follow.checked && payload.session;
      if (following) {
        selectedId = payload.session.id;
        if (changedSession) drawTree();
      }
    }
  } catch (error) { /* servidor fora; o próximo tick tenta de novo */ }
  if (run === pollRun) schedulePoll(700);
}

async function pollIndex() {
  try {
    const response = await fetch('/api/index?since=' + encodeURIComponent(indexToken));
    if (response.status === 200) onIndex(await response.json());
  } catch (error) { /* idem */ }
  setTimeout(pollIndex, 2500);
}

paintLang();
paintScope();
paintFold(options);
paintView();
pollState();
pollIndex();
loopSnippets();
loadAwake();
setInterval(tickAwake, 1000);
</script>
</body>
</html>
"""


# LAUNCHING


def probe(port: int) -> bool:
    """Is one of ours already listening there?"""
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/ping", timeout=1.5) as response:
            return response.headers.get("X-Pergula") == "1"
    except (urllib.error.URLError, OSError):
        return False


def open_window(address: str) -> None:
    chrome = "/Applications/Google Chrome.app"
    if Path(chrome).is_dir():
        subprocess.Popen(
            ["open", "-na", chrome, "--args", f"--app={address}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return

    subprocess.Popen(["open", address], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def launchctl(*arguments: str) -> subprocess.CompletedProcess:
    return subprocess.run(["launchctl", *arguments], capture_output=True, text=True)


def install_agent(port: int) -> None:
    script = Path(__file__).resolve()
    if not Path(AGENT_PYTHON).exists():
        sys.exit(f"pergula: {AGENT_PYTHON} does not exist — install the Command Line Tools")

    target = f"gui/{os.getuid()}"
    already_ours = launchctl("print", f"{target}/{AGENT_LABEL}").returncode == 0

    # A foreign listener would make the agent fail to bind, and KeepAlive would
    # retry that failure forever without ever saying so.
    foreign_listener = probe(port) and not already_ours
    if foreign_listener:
        sys.exit(
            f"pergula: something is already listening on 127.0.0.1:{port}.\n"
            "  Stop it (ctrl+c in its terminal) and run this again,\n"
            f"  or pick another port: pergula --install --port {port + 1}"
        )

    AGENT_PLIST.parent.mkdir(parents=True, exist_ok=True)
    AGENT_LOG.parent.mkdir(parents=True, exist_ok=True)

    AGENT_PLIST.write_bytes(plistlib.dumps({
        "Label": AGENT_LABEL,
        "ProgramArguments": [AGENT_PYTHON, str(script), "--serve", "--port", str(port)],
        "RunAtLoad": True,
        "KeepAlive": True,
        # A person is waiting on every answer. Background meant the lowest
        # priority and the efficiency cores only: with a few agents busy the
        # system starved it, and a click took tens of seconds to come back.
        "ProcessType": "Interactive",
        "StandardOutPath": str(AGENT_LOG),
        "StandardErrorPath": str(AGENT_LOG),
    }))

    launchctl("bootout", f"{target}/{AGENT_LABEL}")
    result = launchctl("bootstrap", target, str(AGENT_PLIST))
    if result.returncode != 0:
        sys.exit(f"pergula: launchctl bootstrap failed — {result.stderr.strip() or result.stdout.strip()}")

    print(f"pergula: agent installed at {AGENT_PLIST}")
    print(f"  interpreter: {AGENT_PYTHON}")
    print(f"  log: {AGENT_LOG}")
    print("  runs at login, restarted if it dies")

    for _ in range(12):
        if probe(port):
            print(f"\n  serving at http://127.0.0.1:{port}")
            print("  from any terminal now, just run: pergula")
            return

        time.sleep(0.5)

    print(f"\n  WARNING: nothing answered on {port} after 6s — see {AGENT_LOG}")


def uninstall_agent() -> None:
    result = launchctl("bootout", f"gui/{os.getuid()}/{AGENT_LABEL}")
    removed = False
    if AGENT_PLIST.exists():
        AGENT_PLIST.unlink()
        removed = True

    failed = not removed and result.returncode != 0
    if failed:
        print("pergula: no agent installed")
        return

    print(f"pergula: agent removed ({AGENT_PLIST})")


def report_status(port: int) -> None:
    address = f"http://127.0.0.1:{port}"
    print(f"pergula: {address} — {'serving' if probe(port) else 'nothing listening'}")

    installed = AGENT_PLIST.exists()
    print(f"  login agent: {'installed' if installed else 'not installed'}")
    if not installed:
        return

    result = launchctl("print", f"gui/{os.getuid()}/{AGENT_LABEL}")
    if result.returncode != 0:
        print("  state: plist on disk but not loaded (run pergula --install)")
        return

    seen = set()
    for line in result.stdout.splitlines():
        stripped = line.strip()
        field = stripped.split("=")[0].strip()
        interesting = field in ("state", "pid", "last exit code") and field not in seen
        if interesting:
            seen.add(field)
            print(f"  {stripped}")


# EVENTS


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--port", type=int, default=7373)
    parser.add_argument("--here", action="store_true", help="only list sessions from the current directory")
    parser.add_argument("--serve", action="store_true", help="always serve in the foreground")
    parser.add_argument("--open", action="store_true", help="open the window (implied when a server is up)")
    parser.add_argument("--install", action="store_true", help="run at login as a background agent")
    parser.add_argument("--uninstall", action="store_true", help="remove that agent")
    parser.add_argument("--status", action="store_true", help="say whether anything is listening")
    arguments = parser.parse_args()

    if arguments.uninstall:
        uninstall_agent()
        return

    if arguments.install:
        install_agent(arguments.port)
        return

    if arguments.status:
        report_status(arguments.port)
        return

    if not PROJECTS.is_dir():
        sys.exit(f"pergula: {PROJECTS} does not exist — is Claude Code installed?")

    address = f"http://127.0.0.1:{arguments.port}"

    # Someone is already serving, so this invocation is a request for a window,
    # not for a second server. This is what makes `pergula` work from any
    # terminal once the agent is installed.
    already_serving = not arguments.serve and probe(arguments.port)
    if already_serving:
        open_window(address)
        print(f"pergula: {address} (already serving)")
        return

    Handler.scope = Path.cwd() if arguments.here else None

    try:
        server = ThreadingHTTPServer(("127.0.0.1", arguments.port), Handler)
    except OSError as error:
        sys.exit(f"pergula: cannot bind {address} — {error}")

    adopt_caffeine()

    # The first pass reads every transcript and takes a while; the page shows
    # its progress and the reader never waits on it.
    threading.Thread(target=usage_loop, name="usage", daemon=True).start()

    started = time.time()
    index = build_index(Handler.scope)
    sessions = sum(len(group["sessions"]) for group in index["projects"])
    print(f"pergula: {address}", flush=True)
    print(f"  {len(index['projects'])} projects, {sessions} sessions indexed in {time.time() - started:.1f}s", flush=True)
    print("  ctrl+c to stop", flush=True)

    wants_window = arguments.open or not arguments.serve
    if wants_window:
        open_window(address)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        stop_caffeine()
        print("\npergula: stopped")


if __name__ == "__main__":
    main()
