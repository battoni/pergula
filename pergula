// HELPERS

function escapeHtml(text) {
  return text.replace(/[&<>"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[char]);
}

function colorOf(name) {
  return COLORS[name] || COLORS.default;
}

function ago(epoch) {
  const seconds = Math.max(0, Date.now() / 1000 - epoch);
  if (seconds < 60) return t('now');
  if (seconds < 3600) return Math.floor(seconds / 60) + 'min';
  if (seconds < 86400) return Math.floor(seconds / 3600) + 'h';
  if (seconds < 2592000) return Math.floor(seconds / 86400) + 'd';
  return Math.floor(seconds / 2592000) + t('month');
}

function locale() {
  return lang === 'pt' ? 'pt-BR' : 'en-US';
}

// Time of day. A long session spans days, so the date appears when it is not
// today — the hour alone would be ambiguous. The full stamp lives in the hover.
function stampParts(iso) {
  if (!iso) return null;
  const when = new Date(iso);
  if (Number.isNaN(when.getTime())) return null;

  const time = when.toLocaleTimeString(locale(), { hour: '2-digit', minute: '2-digit' });
  const today = new Date();
  const sameDay = when.getDate() === today.getDate()
    && when.getMonth() === today.getMonth()
    && when.getFullYear() === today.getFullYear();

  const short = sameDay
    ? time
    : when.toLocaleDateString(locale(), { day: '2-digit', month: '2-digit' }) + ' ' + time;

  return { short: short, full: when.toLocaleString(locale()) };
}

function shortPath(path) {
  return path.replace(/^\/Users\/[^/]+/, '~');
}

function renderInline(text) {
  let html = escapeHtml(text);
  html = html.replace(/`([^`]+)`/g, (_all, code) => '<code class="inline">' + code + '</code>');
  html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  html = html.replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noreferrer">$1</a>');
  return html;
}

function renderTable(lines) {
  const rows = lines
    .map((line) => line.trim().replace(/^\||\|$/g, '').split('|').map((cell) => cell.trim()))
    .filter((cells) => !cells.every((cell) => /^:?-{2,}:?$/.test(cell)));

  if (!rows.length) return '';

  const head = '<tr>' + rows[0].map((cell) => '<th>' + renderInline(cell) + '</th>').join('') + '</tr>';
  const body = rows.slice(1)
    .map((cells) => '<tr>' + cells.map((cell) => '<td>' + renderInline(cell) + '</td>').join('') + '</tr>')
    .join('');

  return '<div class="scroller"><table><thead>' + head + '</thead><tbody>' + body + '</tbody></table></div>';
}

function renderProse(text) {
  const out = [];
  let list = null;
  let table = null;

  const flush = () => {
    if (list) { out.push('</' + list + '>'); list = null; }
  };
  const flushTable = () => {
    if (table) { out.push(renderTable(table)); table = null; }
  };

  for (const rawLine of text.split('\n')) {
    const line = rawLine.trimEnd();

    if (!line.trim()) { flush(); flushTable(); continue; }

    if (/^\s*\|.*\|\s*$/.test(line)) { flush(); (table = table || []).push(line); continue; }
    flushTable();

    const heading = line.match(/^(#{1,6})\s+(.*)$/);
    if (heading) {
      flush();
      const level = heading[1].length <= 3 ? 'h3' : 'h4';
      out.push('<' + level + '>' + renderInline(heading[2]) + '</' + level + '>');
      continue;
    }

    const bullet = line.match(/^\s*[-*]\s+(.*)$/);
    if (bullet) {
      if (list !== 'ul') { flush(); out.push('<ul>'); list = 'ul'; }
      out.push('<li>' + renderInline(bullet[1]) + '</li>');
      continue;
    }

    const numbered = line.match(/^\s*\d+\.\s+(.*)$/);
    if (numbered) {
      if (list !== 'ol') { flush(); out.push('<ol>'); list = 'ol'; }
      out.push('<li>' + renderInline(numbered[1]) + '</li>');
      continue;
    }

    const quote = line.match(/^>\s?(.*)$/);
    if (quote) { flush(); out.push('<blockquote>' + renderInline(quote[1]) + '</blockquote>'); continue; }

    flush();
    out.push('<p>' + renderInline(line) + '</p>');
  }

  flush();
  flushTable();
  return out.join('');
}

function flash(button, hit, back) {
  button.textContent = hit;
  button.classList.add('done');
  setTimeout(() => { button.textContent = back; button.classList.remove('done'); }, 1400);
}

function copyButton(payload, label) {
  const button = document.createElement('button');
  button.className = 'copy';
  button.type = 'button';
  button.textContent = label;
  button.addEventListener('click', (event) => {
    event.stopPropagation();
    navigator.clipboard.writeText(payload).then(() => flash(button, t('copied'), label));
  });
  return button;
}

function codeBlock(source, language) {
  const wrap = document.createElement('div');
  wrap.className = 'block';
  const pre = document.createElement('pre');
  const code = document.createElement('code');
  code.textContent = source;
  if (language) code.dataset.lang = language;
  pre.appendChild(code);
  wrap.appendChild(pre);
  wrap.appendChild(copyButton(source, t('copy')));
  return wrap;
}

function renderMarkdown(container, source) {
  // Odd-indexed segments are fenced code; the fence language is the first line.
  source.split('```').forEach((segment, index) => {
    if (index % 2 === 0) {
      if (!segment.trim()) return;
      const prose = document.createElement('div');
      prose.innerHTML = renderProse(segment);
      while (prose.firstChild) container.appendChild(prose.firstChild);
      return;
    }

    const newline = segment.indexOf('\n');
    const first = newline === -1 ? '' : segment.slice(0, newline).trim();
    const language = /^[a-zA-Z0-9+#._-]*$/.test(first) ? first : '';
    const body = language === first && newline !== -1 ? segment.slice(newline + 1) : segment;
    container.appendChild(codeBlock(body.replace(/\n+$/, ''), language));
  });
}

// The Claude mark: a burst of tapered rays. Drawn here rather than fetched, so
// the page stays a single file with no network at all.
function claudeMark(size) {
  const NS = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(NS, 'svg');
  svg.setAttribute('viewBox', '0 0 24 24');
  svg.setAttribute('width', size);
  svg.setAttribute('height', size);
  svg.setAttribute('aria-hidden', 'true');
  svg.classList.add('mark');

  const RAYS = 11;
  for (let index = 0; index < RAYS; index += 1) {
    const ray = document.createElementNS(NS, 'path');
    // A slim petal: a point at the centre, widest around mid-radius, a point at
    // the tip. Widening it near the centre instead turns the middle into a blob.
    ray.setAttribute('d', 'M12 1.5 L12.95 6.2 L12 12 L11.05 6.2 Z');
    ray.setAttribute('fill', 'currentColor');
    ray.setAttribute('transform', 'rotate(' + (index * 360 / RAYS).toFixed(2) + ' 12 12)');
    svg.appendChild(ray);
  }

  return svg;
}

function label(message) {
  if (message.role === 'user') return t('roleYou');
  if (message.kind === 'tool_use') return t('roleCommand');
  if (message.kind === 'tool_result') return t('roleOutput');
  return t('roleClaude');
}

function visible(message) {
  if (message.kind === 'tool_use') return toggles.tools.checked;
  if (message.kind === 'tool_result') return toggles.results.checked;
  return message.kind === 'text';
}

function speaker(message) {
  if (message.role === 'user') return 'user';
  if (message.kind === 'tool_result') return 'result';
  if (message.kind === 'tool_use') return 'tool';
  return 'claude';
}

// A command shows its name and arguments; its output collapses behind a summary;
// anything else is prose and gets the markdown renderer.
function fillBubble(bubble, message) {
  if (message.kind === 'tool_use') {
    const head = document.createElement('div');
    head.className = 'tool-head';

    const name = document.createElement('b');
    name.textContent = message.name;
    head.appendChild(name);

    if (message.subtitle) {
      const note = document.createElement('span');
      note.textContent = message.subtitle;
      head.appendChild(note);
    }

    bubble.appendChild(head);
    if (message.text) bubble.appendChild(codeBlock(message.text, 'bash'));
    return;
  }

  if (message.kind === 'tool_result') {
    const details = document.createElement('details');
    details.className = 'result';

    const summary = document.createElement('summary');
    const lines = message.text.split('\n').length;
    summary.textContent = lines + ' ' + t(lines === 1 ? 'line' : 'lines');

    details.appendChild(summary);
    details.appendChild(codeBlock(message.text, ''));
    bubble.appendChild(details);
    return;
  }

  renderMarkdown(bubble, message.text);
}

function buildMessage(message) {
  const article = document.createElement('article');
  const kind = speaker(message);
  article.className = 'msg ' + kind;

  const who = document.createElement('div');
  who.className = 'who';
  if (kind === 'claude') who.appendChild(claudeMark(14));
  who.appendChild(document.createTextNode(label(message)));

  const stamp = stampParts(message.ts);
  if (stamp) {
    const when = document.createElement('time');
    when.className = 'stamp';
    when.dateTime = message.ts;
    when.textContent = stamp.short;
    when.title = stamp.full;
    who.appendChild(when);
  }

  // The prompts worth keeping are already in the transcript; this promotes one
  // into the library instead of making you retype it.
  const promotable = message.role === 'user' && message.kind === 'text' && message.text;
  if (promotable) {
    const keep = document.createElement('button');
    keep.className = 'copy copy-msg';
    keep.type = 'button';
    keep.textContent = t('saveSnippet');
    keep.addEventListener('click', () => {
      flash(keep, t('savedSnippet'), t('saveSnippet'));
      promote(message.text);
    });
    who.appendChild(keep);
  }

  if (message.text) {
    const button = copyButton(message.text, t('copyAll'));
    button.classList.add('copy-msg');
    who.appendChild(button);
  }
  article.appendChild(who);

  const bubble = document.createElement('div');
  bubble.className = 'bubble';

  fillBubble(bubble, message);

  article.appendChild(bubble);
  return article;
}

function atBottom() {
  return scroller.scrollHeight - scroller.scrollTop - scroller.clientHeight <= 90;
}

function toBottom(smooth) {
  scroller.scrollTo({ top: scroller.scrollHeight, behavior: smooth ? 'smooth' : 'auto' });
}

function windowNotice() {
  const showingEverything = !limit || total <= messages.length;
  if (showingEverything) return null;

  const notice = document.createElement('div');
  notice.className = 'empty notice';
  notice.textContent = t('showingLast', { n: messages.length, total: total });

  const button = document.createElement('button');
  button.className = 'copy';
  button.type = 'button';
  button.textContent = t('loadAll');
  button.addEventListener('click', () => {
    limit = 0;
    stateToken = '';
    button.textContent = t('loading');
  });
  notice.appendChild(button);
  return notice;
}

function draw() {
  const shown = messages.filter(visible);
  feed.replaceChildren();

  const notice = windowNotice();
  if (notice) feed.appendChild(notice);

  if (!shown.length) {
    const empty = document.createElement('div');
    empty.className = 'empty';
    empty.textContent = t('nothingYet');
    feed.appendChild(empty);
    rendered = [];
    return;
  }

  for (const message of shown) feed.appendChild(buildMessage(message));
  rendered = messages;
}

// Transcripts only ever grow, so the common case is "a few new turns arrived".
// Rebuilding thousands of nodes for that would make the page crawl.
function appendable(next) {
  const lostGround = !rendered.length || next.length < rendered.length;
  if (lostGround) return false;
  const anchor = rendered.length - 1;
  return next[anchor] && next[anchor].text === rendered[anchor].text
    && next[anchor].kind === rendered[anchor].kind;
}

function drawDelta(next) {
  const fresh = next.slice(rendered.length).filter(visible);
  for (const message of fresh) feed.appendChild(buildMessage(message));
  rendered = next;
}

function projectName(project) {
  return project.label || shortPath(project.path);
}

function matches(project, meta, needle) {
  if (!needle) return true;
  const hay = projectName(project) + ' ' + project.path + ' ' + meta.title + ' ' + meta.id;
  return hay.toLowerCase().includes(needle);
}

// "Ativas" means a claude process is open in a terminal right now, which the
// CLI records in ~/.claude/sessions. Whatever you are reading stays on the list
// regardless, so it never vanishes under you mid-sentence.
function inScope(meta) {
  if (scope === 'all') return true;
  if (meta.id === selectedId) return true;
  if (hasRegistry) return meta.live;
  return (Date.now() / 1000 - meta.mtime) <= ACTIVE_WINDOW;
}

function paintFold(panel) {
  const shut = folded.has(panel.id);

  panel.classList.toggle('folded', shut);
  panel.querySelector('.fold-head').setAttribute('aria-expanded', String(!shut));
}

function toggleFold(panel) {
  const shut = !folded.has(panel.id);
  if (shut) folded.add(panel.id);
  if (!shut) folded.delete(panel.id);

  localStorage.setItem('pergula:folded', JSON.stringify([...folded]));
  paintFold(panel);
}

// Calendar days, not spans of 24 hours: something from 23:00 last night is
// yesterday's, however few hours ago it was.
function dayRank(epoch) {
  const today = new Date().setHours(0, 0, 0, 0);
  const then = new Date(epoch * 1000).setHours(0, 0, 0, 0);

  // Rounded, because a day that changes the clocks is not 24 hours long.
  const age = Math.round((today - then) / 86400000);
  if (age <= 0) return 0;
  if (age === 1) return 1;
  if (age <= 7) return 2;
  if (age <= 30) return 3;
  return 4;
}

function dayNames() {
  return [t('dayToday'), t('dayYesterday'), t('dayWeek'), t('dayMonth'), t('dayOlder')];
}

function buildDayLabel(text) {
  const label = document.createElement('div');
  label.className = 'day';
  label.textContent = text;
  return label;
}

// The manual order rules; whatever is not in it follows, in the server's order.
function applyOrder(slug, hits) {
  const manual = manualOrder[slug];
  if (!manual) return hits;

  const rank = new Map(manual.map((id, index) => [id, index]));
  const placed = [];
  const fresh = [];
  for (const meta of hits) (rank.has(meta.id) ? placed : fresh).push(meta);
  placed.sort((a, b) => rank.get(a.id) - rank.get(b.id));
  return placed.concat(fresh);
}

// A session is dragged among the others of its own day. Letting it land under
// another heading would only show a drop that the next redraw takes back.
function dayPeers(group, row) {
  return [...group.querySelectorAll('.session:not(.dragging)')]
    .filter((peer) => peer.dataset.rank === row.dataset.rank);
}

// Where to drop: the first row whose middle has passed the cursor.
function rowBelow(peers, y) {
  return peers.find((peer) => {
    const box = peer.getBoundingClientRect();
    return y < box.top + box.height / 2;
  }) || null;
}

function makeSortable(group, slug) {
  group.addEventListener('dragstart', (event) => {
    const row = event.target.closest('.session');
    if (!row) return;
    row.classList.add('dragging');
    event.dataTransfer.effectAllowed = 'move';
    event.dataTransfer.setData('text/plain', row.dataset.id);
  });

  group.addEventListener('dragover', (event) => {
    const row = group.querySelector('.session.dragging');
    if (!row) return;
    event.preventDefault();
    event.dataTransfer.dropEffect = 'move';
    const peers = dayPeers(group, row);
    if (!peers.length) return;

    const below = rowBelow(peers, event.clientY);
    if (below) {
      group.insertBefore(row, below);
      return;
    }

    peers[peers.length - 1].after(row);
  });

  group.addEventListener('dragend', () => {
    const row = group.querySelector('.session.dragging');
    if (!row) return;
    row.classList.remove('dragging');
    manualOrder[slug] = [...group.querySelectorAll('.session')].map((el) => el.dataset.id);
    localStorage.setItem('pergula:order', JSON.stringify(manualOrder));
    drawTree();
  });
}

// A renamed project is set in italics; an automatic name stays plain.
function fillName(name, meta) {
  if (!meta.renamed) {
    name.textContent = meta.title;
    return;
  }

  const strong = document.createElement('em');
  strong.textContent = meta.title;
  name.appendChild(strong);
}

function stateLabel(state) {
  if (state === 'needs_you') return t('stateNeedsYou');

  if (state === 'error') return t('stateError');

  if (state === 'working') return t('stateWorking');

  if (state === 'waiting') return t('stateWaiting');

  return t('stateReady');
}

// The two states that are waiting on a person. Everything else can be left alone.
function needsAttention(meta) {
  const isStuck = meta.state === 'needs_you' || meta.state === 'error';
  return meta.live && isStuck;
}

// The count goes where it can be seen without the window in front: the tab or
// window title, and the Dock icon when this runs as an installed app.
function drawAttention() {
  const count = projects
    .flatMap((project) => project.sessions)
    .filter(needsAttention)
    .length;

  document.title = count ? '(' + count + ') pergula' : 'pergula';

  if (!('setAppBadge' in navigator)) return;

  const badging = count ? navigator.setAppBadge(count) : navigator.clearAppBadge();
  // A badge the platform refuses changes nothing on the page.
  badging.catch(() => null);
}

// What sits where the time would: what the session is waiting on, or how many
// subagents are still working once the main turn has ended, that it is waiting
// on a shell, or how long ago.
function whenLabel(meta) {
  if (needsAttention(meta)) return stateLabel(meta.state);

  if (meta.live && meta.state === 'waiting') return stateLabel(meta.state);

  const behind = meta.live && meta.subagents;
  if (!behind) return ago(meta.mtime);

  if (meta.subagents === 1) return t('subagentOne');

  return t('subagentMany', { n: meta.subagents });
}

function buildSessionRow(meta, ordinal) {
  const row = document.createElement('button');
  row.type = 'button';
  row.className = 'session'
    + (meta.id === selectedId ? ' active' : '')
    + (meta.live ? ' live ' + meta.state.replace('_', '-') : '');
  row.title = meta.id
    + (meta.live
      ? '\n' + t('openInTerminal', { pid: meta.pid, status: stateLabel(meta.state) })
      : '')
    + (meta.renamed ? '' : '\n' + t('autoName'));
  row.draggable = true;
  row.dataset.id = meta.id;

  if (ordinal <= 9) {
    const badge = document.createElement('span');
    badge.className = 'badge';
    badge.textContent = ordinal;
    row.appendChild(badge);
  }

  const dot = document.createElement('span');
  dot.className = 'swatch';
  if (meta.color) dot.style.background = colorOf(meta.color);
  row.appendChild(dot);

  const name = document.createElement('span');
  name.className = 'name';
  fillName(name, meta);
  row.appendChild(name);

  const when = document.createElement('span');
  when.className = 'when';
  when.textContent = whenLabel(meta);
  if (meta.live) {
    const light = document.createElement('span');
    light.className = 'light';
    light.textContent = '● ';
    when.prepend(light);
  }
  row.appendChild(when);

  row.addEventListener('click', () => onPick(meta.id));
  return row;
}

function startRename(project, summary, name) {
  const input = document.createElement('input');
  input.className = 'rename';
  input.value = project.label || '';
  input.placeholder = shortPath(project.path);
  summary.replaceChild(input, name);
  summary.dataset.editing = '1';
  input.focus();
  input.select();

  const stop = (event) => event.stopPropagation();
  input.addEventListener('click', stop);
  input.addEventListener('mousedown', stop);

  const finish = (save) => {
    delete summary.dataset.editing;
    if (!save) { drawTree(); return; }

    fetch('/api/rename', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ slug: project.slug, label: input.value.trim() }),
    }).then(() => {
      project.label = input.value.trim();
      indexToken = '';
      drawTree();
    }).catch(() => drawTree());
  };

  input.addEventListener('keydown', (event) => {
    event.stopPropagation();
    if (event.key === 'Enter') { event.preventDefault(); finish(true); }
    if (event.key === 'Escape') { event.preventDefault(); finish(false); }
  });
  input.addEventListener('blur', () => finish(true));
}

function drawTree() {
  // Never yank the tree out from under someone naming a project or dragging a
  // session. It is the same rule as "never yank the page while text is selected"
  // further down: a new message arriving cannot cost what a person was in the
  // middle of. The tree goes a few seconds stale; whoever finishes redraws.
  if (tree.querySelector('[data-editing], .dragging')) return;

  if (view === 'library') {
    drawLibraryTree();
    return;
  }

  // The usage and work views have no tree, so cmd+1..9 has nothing to jump to.
  if (view === 'usage' || view === 'work') {
    visibleRows = [];
    return;
  }

  const needle = filter.value.trim().toLowerCase();
  const names = dayNames();
  tree.replaceChildren();
  visibleRows = [];

  for (const project of projects) {
    if (!inFocus(project)) continue;

    const hits = project.sessions.filter((meta) => matches(project, meta, needle) && inScope(meta));
    if (!hits.length) continue;

    const holdsActive = hits.some((meta) => meta.id === selectedId);
    const group = document.createElement('details');
    group.className = 'project';
    group.open = needle ? true : (holdsActive || !collapsed.has(project.slug));

    const summary = document.createElement('summary');
    summary.title = project.path;
    const name = document.createElement('b');
    name.textContent = projectName(project);
    summary.appendChild(name);

    // A group under .claude/worktrees/ is one piece of work, not a project.
    const worktree = (project.path || '').split('/.claude/worktrees/')[1];
    if (worktree) {
      const badge = document.createElement('span');
      badge.className = 'wt-badge';
      badge.textContent = '⎇ ' + worktree.split('/')[0];
      summary.appendChild(badge);
    }

    const pencil = document.createElement('button');
    pencil.className = 'pencil';
    pencil.type = 'button';
    pencil.textContent = '✎';
    pencil.title = t('renameHint');
    pencil.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      startRename(project, summary, name);
    });
    summary.appendChild(pencil);

    const count = document.createElement('span');
    count.className = 'count';
    count.textContent = hits.length;
    summary.appendChild(count);

    summary.addEventListener('click', (event) => {
      if (summary.dataset.editing) event.preventDefault();
    });
    name.addEventListener('dblclick', (event) => {
      event.preventDefault();
      event.stopPropagation();
      startRename(project, summary, name);
    });

    group.appendChild(summary);

    group.addEventListener('toggle', () => {
      if (filter.value.trim()) return;
      if (group.open) collapsed.delete(project.slug);
      if (!group.open) collapsed.add(project.slug);
      localStorage.setItem('pergula:collapsed', JSON.stringify([...collapsed]));
    });

    // The day comes first and the manual order rules inside it: the sort is
    // stable, so a session dragged within its day stays where it was put.
    const dated = applyOrder(project.slug, hits)
      .map((meta) => ({ meta, rank: dayRank(meta.mtime) }))
      .sort((a, b) => a.rank - b.rank);
    const spansDays = new Set(dated.map((entry) => entry.rank)).size > 1;
    let day = -1;

    for (const entry of dated) {
      const opensDay = spansDays && entry.rank !== day;
      if (opensDay) group.appendChild(buildDayLabel(names[entry.rank]));
      day = entry.rank;

      visibleRows.push(entry.meta.id);
      const row = buildSessionRow(entry.meta, visibleRows.length);
      row.dataset.rank = entry.rank;
      group.appendChild(row);
    }

    makeSortable(group, project.slug);

    tree.appendChild(group);
  }

  if (!tree.children.length) {
    const empty = document.createElement('div');
    empty.className = 'empty';
    empty.textContent = scope === 'live' && !filter.value.trim()
      ? t(hasRegistry ? 'noLiveSession' : 'noRecentSession')
      : t('nothingFound');
    tree.appendChild(empty);
  }
}

function paintLang() {
  document.documentElement.lang = lang === 'pt' ? 'pt-BR' : 'en';
  for (const node of document.querySelectorAll('[data-i18n]')) {
    node.textContent = t(node.dataset.i18n);
  }
  for (const node of document.querySelectorAll('[data-i18n-ph]')) {
    node.placeholder = t(node.dataset.i18nPh);
  }
  for (const node of document.querySelectorAll('[data-i18n-title]')) {
    node.title = t(node.dataset.i18nTitle);
  }
  for (const node of document.querySelectorAll('[data-i18n-aria]')) {
    node.setAttribute('aria-label', t(node.dataset.i18nAria));
  }
  langPt.classList.toggle('on', lang === 'pt');
  langEn.classList.toggle('on', lang === 'en');
  paintAwake();
  paintFocus();
  paintView();
}

function setLang(next) {
  if (next === lang) return;
  lang = next;
  localStorage.setItem('pergula:lang', next);
  paintLang();
  labelRail(document.body.classList.contains('railed-off'));
  // The text lives inside messages and rows already drawn, so this has to
  // rebuild rather than swap a few loose labels.
  rendered = [];
  drawTop();
  paintScope();
  drawFavourites();
  paintStar();
  drawTree();
  draw();
  if (view === 'usage') drawUsage();
  if (view === 'work') drawWork();
}

// KEEPING THE MAC AWAKE

function countdown(seconds) {
  const whole = Math.ceil(seconds / 60);
  const hours = Math.floor(whole / 60);
  const minutes = whole % 60;
  if (!hours) return minutes + 'min';

  return hours + ':' + String(minutes).padStart(2, '0');
}

function paintAwake() {
  const left = awakeUntil - Date.now() / 1000;
  const holding = left > 0;
  awake.classList.toggle('on', holding);
  if (!holding) {
    awake.textContent = t('keepAwake');
    awake.title = t('keepAwakeHint');
    return;
  }

  awake.textContent = t('awakeFor', { time: countdown(left) });
  awake.title = t('stopAwake');
}

// Counted down here rather than polled: this page set the deadline, so a
// request every second would buy nothing. The one moment it has to ask again is
// when the clock runs out, because the server is what knows the child is gone.
function tickAwake() {
  if (!awakeUntil) return;

  const done = awakeUntil - Date.now() / 1000 <= 0;
  if (done) {
    awakeUntil = 0;
    loadAwake();
    return;
  }

  paintAwake();
}

function drawAwakeHours(hours) {
  awakeHours.replaceChildren();
  for (const count of hours) {
    const button = document.createElement('button');
    button.type = 'button';
    button.textContent = count + 'h';
    button.addEventListener('click', () => sendAwake(count));
    awakeHours.appendChild(button);
  }
}

function onAwake(state) {
  awakeUntil = state.until || 0;
  drawAwakeHours(state.hours || []);
  paintAwake();
}

function sendAwake(hours) {
  railFoot.classList.remove('asking');
  fetch('/api/caffeine', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ hours: hours }),
  }).then((response) => response.json()).then(onAwake).catch(() => null);
}

async function loadAwake() {
  try {
    const response = await fetch('/api/caffeine');
    onAwake(await response.json());
  } catch (error) { /* server down; the next visit asks again */ }
}

function toggleAwake() {
  const holding = awakeUntil > Date.now() / 1000;
  if (holding) {
    sendAwake(0);
    return;
  }

  railFoot.classList.toggle('asking');
}


function paintScope() {
  scopeLive.classList.toggle('on', scope === 'live');
  scopeAll.classList.toggle('on', scope === 'all');
  optionsState.textContent = t(scope === 'live' ? 'active' : 'all');
}

function setScope(next) {
  scope = next;
  paintScope();
  drawTree();
}

// Focus keeps one project on the list: the one the open session belongs to when
// it is turned on, with every project in a folder under it, so a repository's
// sub-apps stay. Nothing is filtered on the server; it is the list, not the data.
function inFocus(project) {
  if (!focusPath) return true;

  const inside = project.path === focusPath || project.path.startsWith(focusPath + '/');
  return inside;
}

function focusedProject() {
  return projects.find((project) => project.path === focusPath) || null;
}

function paintFocus() {
  focusChip.hidden = !focusPath;
  if (!focusPath) return;

  const project = focusedProject();
  const name = project ? projectName(project) : shortPath(focusPath);
  focusChip.innerHTML = '<span></span><span class="name"></span><span class="keys">cmd+A F</span>';
  focusChip.firstChild.textContent = t('focusOn');
  focusChip.querySelector('.name').textContent = name;
}

function setFocus(path) {
  focusPath = path;
  if (focusPath) localStorage.setItem('pergula:focus', focusPath);
  if (!focusPath) localStorage.removeItem('pergula:focus');

  paintFocus();
  drawTree();
}

function toggleFocus() {
  if (focusPath) {
    setFocus('');
    return;
  }

  const owner = session && projects.find((project) => project.slug === session.slug);
  if (!owner) return;

  setFocus(owner.path);
}

function drawTop() {
  if (view === 'usage') {
    drawUsageTop();
    return;
  }

  if (view === 'work') {
    drawWorkTop();
    return;
  }

  if (view === 'library') {
    titleEl.textContent = t('tabLibrary');
    titleEl.title = '';
    metaEl.textContent = shortPath(snippetsHome);
    return;
  }

  if (!session) {
    titleEl.textContent = t('noSession');
    titleEl.title = '';
    sidEl.dataset.for = '';
    sidEl.textContent = t('sessionId');
    metaEl.textContent = '';
    return;
  }

  titleEl.textContent = session.title;
  titleEl.title = session.title;
  if (sidEl.dataset.for !== session.id) {
    sidEl.dataset.for = session.id;
    sidEl.innerHTML = escapeHtml(t('sessionIdCopy')) + '<b></b>';
    sidEl.querySelector('b').textContent = session.id;
  }
  swatch.style.background = colorOf(session.color);
  metaEl.textContent = shortPath(session.cwd || '') + (session.branch ? '  ·  ' + session.branch : '');
}

// LIBRARY

// The same reduction the server performs, so the file path shown under the
// editor is the one that will actually be written.
function slugify(raw) {
  const parts = raw.normalize('NFD').replace(/[\u0300-\u036f]/g, '').split('/')
    .map((part) => part.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''))
    .filter(Boolean)
    .slice(0, 2);

  return parts.join('/');
}

function snippetMatches(item, needle) {
  if (!needle) return true;

  const hay = item.slug + ' ' + item.title + ' ' + item.body;
  return hay.toLowerCase().includes(needle);
}

function findSnippet(slug) {
  return snippets.find((item) => item.slug === slug) || null;
}

// A star can outlive the file it points at — deleted in the editor, or by hand.
// Resolving through the library rather than trusting the list keeps that quiet.
function favouriteSnippets() {
  return favouriteSlugs
    .map((slug) => findSnippet(slug))
    .filter(Boolean)
    .slice(0, FAVOURITE_LIMIT);
}

function copyFavourite(row, item) {
  navigator.clipboard.writeText(item.body).then(() => {
    if (!row) return;

    const name = row.querySelector('.name');
    row.classList.add('done');
    name.textContent = t('copied');
    setTimeout(() => {
      row.classList.remove('done');
      name.textContent = item.title;
    }, 1200);
  });
}

// One click, no view change: the reason the block exists is that you are in the
// middle of a transcript and want the prompt, not the library.
function drawFavourites() {
  favourites.replaceChildren();

  const starred = favouriteSnippets();
  if (!starred.length) return;

  const head = document.createElement('button');
  head.type = 'button';
  head.className = 'fold-head';
  head.textContent = t('favourites');
  head.addEventListener('click', () => toggleFold(favourites));
  favourites.appendChild(head);
  paintFold(favourites);

  for (const item of starred) {
    const row = document.createElement('button');
    row.type = 'button';
    row.className = 'fav';
    row.title = item.slug + '.md';

    const pin = document.createElement('span');
    pin.className = 'pin';
    pin.textContent = '\u2605';
    row.appendChild(pin);

    const name = document.createElement('span');
    name.className = 'name';
    name.textContent = item.title;
    row.appendChild(name);

    row.addEventListener('click', () => copyFavourite(row, item));
    favourites.appendChild(row);
  }
}

function paintStar() {
  const slug = editing ? editing.slug : '';
  const on = Boolean(slug) && favouriteSlugs.includes(slug);
  const blocked = !on && favouriteSlugs.length >= FAVOURITE_LIMIT;

  let hint = t('favouriteAdd');
  if (on) hint = t('favouriteDrop');
  if (blocked) hint = t('favouriteFull');

  snipStar.textContent = on ? '\u2605' : '\u2606';
  snipStar.classList.toggle('on', on);
  snipStar.disabled = !slug || blocked;
  snipStar.title = hint;
  snipStar.setAttribute('aria-label', hint);
}

function toggleStar() {
  const starrable = editing !== null && editing.slug;
  if (!starrable) return;

  const wanted = !favouriteSlugs.includes(editing.slug);
  fetch('/api/favourite', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ slug: editing.slug, on: wanted }),
  }).then((response) => response.json()).then((saved) => {
    favouriteSlugs = saved.favourites;
    snippetsToken = '';
    paintStar();
    drawFavourites();
    drawTree();
  }).catch(() => null);
}

function paintGroups() {
  const names = [...new Set(snippets.map((item) => item.group).filter(Boolean))].sort();
  snipGroups.replaceChildren();

  for (const name of names) {
    const option = document.createElement('option');
    option.value = name;
    snipGroups.appendChild(option);
  }
}

// Spelling out the file is the point: these are ordinary Markdown documents,
// and knowing where one sits is what lets you edit it without this page.
function snippetWhere() {
  const title = snipTitle.value.trim();
  if (!title) return '';

  const slug = slugify(snipGroup.value.trim() + '/' + title);
  return shortPath(snippetsHome) + '/' + slug + '.md';
}

function paintEditor() {
  library.classList.toggle('editing', editing !== null);
  disarm();
  if (!editing) return;

  snipTitle.value = editing.title;
  snipGroup.value = editing.group;
  snipBody.value = editing.body;
  snipWhere.textContent = snippetWhere();
  paintStar();
  paintGroups();
}

// Switching away from a half-typed snippet must not throw it out. Anything with
// a title is written; anything without one has no file name to be written under.
function commitDraft() {
  clearTimeout(draftTimer);
  if (!dirty) return null;
  if (!editing) return null;

  const title = snipTitle.value.trim();
  dirty = false;
  if (!title) return null;

  const draft = editing;
  const payload = {
    was: draft.slug,
    title: title,
    group: snipGroup.value.trim(),
    body: snipBody.value,
  };

  return fetch('/api/snippet', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload),
  }).then((response) => response.json()).then((saved) => {
    draft.slug = saved.slug;
    draft.title = title;
    snippetsToken = '';
    return pollSnippets();
  }).catch(() => null);
}

// Every pause in the typing writes the file, so closing the window never costs
// anything. A retitle writes the new name and the server drops the old one.
function touchDraft() {
  dirty = true;
  snipWhere.textContent = snippetWhere();
  clearTimeout(draftTimer);
  draftTimer = setTimeout(commitDraft, 1200);
}

function openSnippet(slug) {
  const item = findSnippet(slug);
  if (!item) return;

  commitDraft();
  editing = { slug: item.slug, title: item.title, group: item.group, body: item.body };
  dirty = false;
  paintEditor();
  drawTree();
}

function newSnippet(body) {
  commitDraft();
  editing = { slug: '', title: '', group: '', body: body || '' };
  dirty = Boolean(body);
  paintEditor();
  drawTree();
  snipTitle.focus();
}

function saveNow() {
  const title = snipTitle.value.trim();
  if (!title) {
    snipTitle.focus();
    return;
  }

  dirty = true;
  commitDraft();
  flash(snipSave, t('saved'), t('save'));
}

function disarm() {
  armed = false;
  snipDelete.textContent = t('remove');
  snipDelete.classList.remove('armed');
}

// Two clicks rather than a modal: a browser dialog would be the only blocking
// thing on an otherwise quiet page.
function deleteNow() {
  if (!editing) return;

  const unsaved = !editing.slug;
  if (unsaved) {
    dirty = false;
    editing = null;
    paintEditor();
    drawTree();
    return;
  }

  if (!armed) {
    armed = true;
    snipDelete.textContent = t('confirmRemove');
    snipDelete.classList.add('armed');
    setTimeout(disarm, 3000);
    return;
  }

  const slug = editing.slug;
  dirty = false;
  editing = null;
  paintEditor();
  drawTree();

  fetch('/api/snippet/delete', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ slug: slug }),
  }).then(() => {
    snippetsToken = '';
    return pollSnippets();
  }).catch(() => null);
}

function buildSnippetRow(item, ordinal, flat) {
  const row = document.createElement('div');
  const isOpen = editing !== null && editing.slug === item.slug;
  const classes = ['session'];
  if (flat) classes.push('flat');
  if (isOpen) classes.push('active');

  row.className = classes.join(' ');
  row.setAttribute('role', 'button');
  row.tabIndex = 0;
  row.title = item.slug + '.md';

  if (ordinal <= 9) {
    const badge = document.createElement('span');
    badge.className = 'badge';
    badge.textContent = ordinal;
    row.appendChild(badge);
  }

  const name = document.createElement('span');
  name.className = 'name';
  name.textContent = item.title;
  row.appendChild(name);

  if (favouriteSlugs.includes(item.slug)) {
    const pin = document.createElement('span');
    pin.className = 'pin';
    pin.textContent = '\u2605';
    row.appendChild(pin);
  }

  const copy = copyButton(item.body, t('copy'));
  copy.classList.add('rowcopy');
  row.appendChild(copy);

  row.addEventListener('click', () => openSnippet(item.slug));
  row.addEventListener('keydown', (event) => {
    const activates = event.key === 'Enter' || event.key === ' ';
    if (!activates) return;

    event.preventDefault();
    openSnippet(item.slug);
  });

  return row;
}

// Folders are the only grouping there is, so the tree mirrors the directory:
// loose snippets at the top, one collapsible group per folder underneath.
function drawLibraryTree() {
  const needle = filter.value.trim().toLowerCase();
  tree.replaceChildren();
  visibleRows = [];

  const hits = snippets.filter((item) => snippetMatches(item, needle));

  for (const item of hits.filter((one) => !one.group)) {
    visibleRows.push(item.slug);
    tree.appendChild(buildSnippetRow(item, visibleRows.length, true));
  }

  const names = [...new Set(hits.map((item) => item.group).filter(Boolean))];
  for (const folder of names) {
    const key = 'snip:' + folder;
    const group = document.createElement('details');
    group.className = 'project';
    group.open = needle ? true : !collapsed.has(key);

    const summary = document.createElement('summary');
    const heading = document.createElement('b');
    heading.textContent = folder;
    summary.appendChild(heading);

    const members = hits.filter((item) => item.group === folder);
    const count = document.createElement('span');
    count.className = 'count';
    count.textContent = members.length;
    summary.appendChild(count);

    group.appendChild(summary);
    group.addEventListener('toggle', () => {
      if (filter.value.trim()) return;
      if (group.open) collapsed.delete(key);
      if (!group.open) collapsed.add(key);
      localStorage.setItem('pergula:collapsed', JSON.stringify([...collapsed]));
    });

    for (const item of members) {
      visibleRows.push(item.slug);
      group.appendChild(buildSnippetRow(item, visibleRows.length, false));
    }

    tree.appendChild(group);
  }

  if (tree.children.length) return;

  const empty = document.createElement('div');
  empty.className = 'empty';
  empty.textContent = needle ? t('nothingFound') : t('noSnippets');
  tree.appendChild(empty);
}

function paintView() {
  document.body.classList.toggle('library', view === 'library');
  document.body.classList.toggle('usage', view === 'usage');
  document.body.classList.toggle('work', view === 'work');
  tabSessions.classList.toggle('on', view === 'sessions');
  tabLibrary.classList.toggle('on', view === 'library');
  tabUsage.classList.toggle('on', view === 'usage');
  tabWork.classList.toggle('on', view === 'work');
  filter.placeholder = t(view === 'library' ? 'filterSnippets' : 'filterPlaceholder');
  if (view === 'work') filter.placeholder = t('filterWork');
  filter.setAttribute('aria-label', view === 'work' ? t('filterWorkLabel') : filter.placeholder);
}

function setView(next) {
  if (next === view) return;

  commitDraft();
  view = next;
  filter.value = '';
  paintView();
  drawTop();
  drawTree();
  if (view === 'usage') loadUsage();
  if (view === 'work') loadWork();
}

function promote(text) {
  setView('library');
  newSnippet(text);
}

// USAGE

const usagePane = document.getElementById('usage');
const usageSide = document.getElementById('usageSide');
const usageSpans = document.getElementById('usageSpans');
const usageDates = document.getElementById('usageDates');
const usageFrom = document.getElementById('usageFrom');
const usageTo = document.getElementById('usageTo');
const usagePrev = document.getElementById('usagePrev');
const usageNext = document.getElementById('usageNext');
const tabUsage = document.getElementById('tabUsage');

const SERIES = 8;
const SESSION_ROWS = 40;
const WEEKDAY_KEYS = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];

// The window is the server's to work out: it knows the hour the quota week
// turns at. The page keeps a moment inside the window it wants and the
// neighbours the server handed back. An empty moment means now.
let usageSpan = localStorage.getItem('pergula:usage-span') || 'week';
let usageAt = '';
let usageOff = new Set(JSON.parse(localStorage.getItem('pergula:usage-off') || '[]'));
let usageReport = null;
let usageProject = null;
let usageDetail = null;
let usageTimer = null;
let usageRun = 0;

function number(value, digits) {
  const places = digits || 0;
  return new Intl.NumberFormat(locale(), { minimumFractionDigits: places, maximumFractionDigits: places })
    .format(value);
}

function tokens(value) {
  if (value >= 1e9) return number(value / 1e9, 2) + ' ' + t('unitBillion');
  if (value >= 1e7) return number(value / 1e6) + ' ' + t('unitMillion');
  if (value >= 1e6) return number(value / 1e6, 1) + ' ' + t('unitMillion');
  if (value >= 1e3) return number(value / 1e3) + ' ' + t('unitThousand');
  return number(value);
}

function kilo(value) {
  return number(Math.round(value / 1000)) + 'k';
}

function percent(value) {
  return number(value) + '%';
}

function dollars(value) {
  return 'us$ ' + number(value, value < 100 ? 2 : 0);
}

// An hour key, 2026-11-02T14, as the local moment it names.
function fromKey(key) {
  const [day, hour] = key.split('T');
  const [year, month, date] = day.split('-').map(Number);
  return new Date(year, month - 1, date, Number(hour || 0));
}

function toKey(when) {
  const pad = (value) => String(value).padStart(2, '0');
  return when.getFullYear() + '-' + pad(when.getMonth() + 1) + '-' + pad(when.getDate())
    + 'T' + pad(when.getHours());
}

function lower(text) {
  return text.toLocaleLowerCase(locale()).replace(/\./g, '');
}

function dayLabel(when, withYear) {
  const options = { weekday: 'short', day: 'numeric', month: 'short' };
  if (withYear) options.year = 'numeric';
  return lower(when.toLocaleDateString(locale(), options));
}

function plainDay(when, withYear) {
  const options = { day: 'numeric', month: 'short' };
  if (withYear) options.year = 'numeric';
  return lower(when.toLocaleDateString(locale(), options));
}

function hourLabel(when) {
  return String(when.getHours()).padStart(2, '0') + ':00';
}

function monthLabel(when) {
  return lower(when.toLocaleDateString(locale(), { month: 'long', year: 'numeric' }));
}

function windowLabel(report) {
  const start = fromKey(report.start);
  const end = fromKey(report.end);
  const last = new Date(end.getTime() - 3600000);

  if (report.span === 'day') return dayLabel(start, true);

  if (report.span === 'week') {
    return dayLabel(start) + ' ' + hourLabel(start) + ' – ' + dayLabel(end, true) + ' ' + hourLabel(end);
  }

  if (report.span === 'month') return monthLabel(start);

  if (report.span === 'year') return String(start.getFullYear());

  return plainDay(start) + ' – ' + plainDay(last, true);
}

function usageHeading() {
  if (usageProject) return t('tabUsage') + ' · ' + (usageDetail ? usageDetail.name : '');

  const report = usageReport;
  if (!report) return t('tabUsage');

  if (report.span === 'week') return t('tabUsage') + ' · ' + t('usageWeek', { n: report.week });

  return t('tabUsage') + ' · ' + windowLabel(report);
}

// The colour of a project follows its rank over everything ever indexed, so
// it does not change as the window moves.
function seriesOf(path) {
  const rank = usageReport ? usageReport.ranking.indexOf(path) : -1;
  const ranked = rank >= 0 && rank < SERIES;
  return ranked ? 's' + (rank + 1) : 's0';
}

function dot(path) {
  const mark = document.createElement('span');
  mark.className = 'dot ' + seriesOf(path);
  return mark;
}

function drawUsageTop() {
  titleEl.textContent = usageHeading();
  titleEl.title = '';
  const report = usageReport;
  usagePrev.disabled = !report || !report.prev;
  usageNext.disabled = !report || !report.next;
  if (!report) {
    metaEl.textContent = '';
    return;
  }

  const parts = [windowLabel(report), t('usageCalls', { n: number(report.totals.calls) }), t('usageOnce')];
  const status = report.status;
  const indexing = !status.ready && status.total;
  if (indexing) parts.push(t('usageIndexing', { n: Math.floor(100 * status.done / status.total) }));

  metaEl.textContent = parts.join('  ·  ');
}

function head(text) {
  const label = document.createElement('div');
  label.className = 'head';
  label.textContent = text;
  return label;
}

function none(text) {
  const empty = document.createElement('div');
  empty.className = 'none';
  empty.textContent = text;
  return empty;
}

function projectPick(row) {
  const pick = document.createElement('label');
  pick.className = 'pick';
  pick.title = row.path;

  const box = document.createElement('input');
  box.type = 'checkbox';
  box.checked = row.on;
  box.addEventListener('change', () => {
    if (box.checked) usageOff.delete(row.path);
    if (!box.checked) usageOff.add(row.path);
    localStorage.setItem('pergula:usage-off', JSON.stringify([...usageOff]));
    loadUsage();
  });
  pick.appendChild(box);

  const name = document.createElement('span');
  name.className = 'label';
  name.textContent = row.name;
  pick.appendChild(name);

  pick.appendChild(dot(row.path));
  return pick;
}

function shortDay(day) {
  return day.slice(8, 10) + '/' + day.slice(5, 7) + '/' + day.slice(2, 4);
}

function weekdayName(index) {
  // 2026-11-02 was a Monday; the names come from the locale, not a table.
  const when = new Date(2026, 10, 2 + index);
  return lower(when.toLocaleDateString(locale(), { weekday: 'long' }));
}

function resetPicker(settings) {
  const row = document.createElement('div');
  row.className = 'reset';

  const weekday = document.createElement('select');
  WEEKDAY_KEYS.forEach((key, index) => {
    const option = document.createElement('option');
    option.value = key;
    option.textContent = weekdayName(index);
    option.selected = key === settings.weekday;
    weekday.appendChild(option);
  });

  const hour = document.createElement('select');
  for (let value = 0; value < 24; value += 1) {
    const option = document.createElement('option');
    option.value = String(value);
    option.textContent = String(value).padStart(2, '0') + ':00';
    option.selected = value === settings.hour;
    hour.appendChild(option);
  }

  const send = () => {
    fetch('/api/usage/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ weekday: weekday.value, hour: Number(hour.value) }),
    }).then(() => loadUsage()).catch(() => null);
  };
  weekday.addEventListener('change', send);
  hour.addEventListener('change', send);

  row.appendChild(weekday);
  row.appendChild(hour);
  return row;
}

function drawUsageSide() {
  usageSide.replaceChildren();
  const report = usageReport;
  if (!report) return;

  usageSide.appendChild(head(t('usageProjects')));
  for (const row of report.projects) usageSide.appendChild(projectPick(row));
  if (!report.projects.length) usageSide.appendChild(none(t('noCalls')));

  usageSide.appendChild(head(t('usageMilestones')));
  const marks = report.milestones.slice().reverse().slice(0, 12);
  for (const mark of marks) {
    const line = document.createElement('div');
    line.className = 'mark';

    const when = document.createElement('span');
    when.className = 'when';
    when.textContent = shortDay(mark.day);
    line.appendChild(when);

    const what = document.createElement('span');
    what.textContent = mark.label;
    line.appendChild(what);
    usageSide.appendChild(line);
  }
  if (!marks.length) usageSide.appendChild(none(t('noMilestones')));

  usageSide.appendChild(head(t('usageReset')));
  usageSide.appendChild(resetPicker(report.settings));
}

function paintSpans() {
  for (const button of usageSpans.querySelectorAll('button')) {
    button.classList.toggle('on', button.dataset.span === usageSpan);
  }

  usageDates.classList.toggle('on', usageSpan === 'custom');
}

function stat(label, value, hint) {
  const card = document.createElement('div');
  card.className = 'stat';
  if (hint) card.title = hint;

  const name = document.createElement('span');
  name.className = 'label';
  name.textContent = label;
  card.appendChild(name);

  const figure = document.createElement('b');
  figure.textContent = value;
  card.appendChild(figure);
  return card;
}

function pairStat(first, second) {
  const card = document.createElement('div');
  card.className = 'stat';
  const pair = document.createElement('div');
  pair.className = 'pair';
  for (const [label, value] of [first, second]) {
    const half = stat(label, value);
    half.className = '';
    pair.appendChild(half);
  }
  card.appendChild(pair);
  return card;
}

function drawStats(report) {
  const totals = report.totals;
  const figures = document.createElement('div');
  figures.className = 'stats';

  figures.appendChild(stat(t('statTokens'), tokens(totals.tokens)));
  figures.appendChild(stat(t('statRead'), tokens(totals.cache_read)));
  figures.appendChild(pairStat([t('statWrite'), tokens(totals.cache_write)],
    [t('statOutput'), tokens(totals.output)]));

  let hint = t('statApiHint', { date: plainDay(fromKey(report.prices + 'T00'), true) });
  if (totals.unpriced) hint += '\n' + t('unpriced', { n: tokens(totals.unpriced) });
  figures.appendChild(stat(t('statApi'), dollars(totals.usd), hint));

  const signs = document.createElement('div');
  signs.className = 'stats three';
  const found = report.indicators;
  signs.appendChild(stat(t('indContext'), kilo(found.context), t('indContextHint')));
  signs.appendChild(stat(t('indLarge'), percent(found.large)));
  signs.appendChild(stat(t('indBase'), kilo(found.base), t('indBaseHint')));

  return [figures, signs];
}

function niceCeiling(value) {
  const magnitude = Math.pow(10, Math.floor(Math.log10(value)));
  const step = [1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10].find((each) => each * magnitude >= value * 1.04);
  return (step || 10) * magnitude;
}

function barLabels(report, bar, index) {
  const when = fromKey(bar.start);
  if (report.unit === 'hour') return [String(when.getHours()).padStart(2, '0'), ''];

  if (report.unit === 'month') return [lower(when.toLocaleDateString(locale(), { month: 'short' })), ''];

  if (report.span === 'week') {
    return [lower(when.toLocaleDateString(locale(), { weekday: 'short' })), String(when.getDate())];
  }

  const opensMonth = index === 0 || when.getDate() === 1;
  const month = opensMonth ? lower(when.toLocaleDateString(locale(), { month: 'short' })) : '';
  return [String(when.getDate()), month];
}

// The bar a milestone day falls in, or -1 when the day is outside the window.
function milestoneBar(report, day) {
  const opens = day + 'T00';
  const closes = toKey(new Date(fromKey(opens).getTime() + 86400000));
  const outside = closes <= report.start || opens >= report.end;
  if (outside) return -1;

  const from = opens > report.start ? opens : report.start;
  let found = 0;
  report.bars.forEach((bar, index) => {
    if (bar.start <= from) found = index;
  });
  return found;
}

function emptyText(report) {
  if (!report.first) return t(report.status.ready ? 'noUsageYet' : 'loading');

  const before = report.end <= report.first;
  if (before) return t('noDataBefore', { date: plainDay(fromKey(report.first), true) });

  return t('noCalls');
}

function svgNode(name, attributes, text) {
  const node = document.createElementNS('http://www.w3.org/2000/svg', name);
  for (const [key, value] of Object.entries(attributes)) node.setAttribute(key, value);
  if (text !== undefined) node.textContent = text;
  return node;
}

// Stacked bars in plain SVG: the page fetches no library. The heaviest
// projects of all time get a colour each; the rest stack as one.
function drawChart(report, box) {
  const width = Math.max(280, Math.floor(box.clientWidth || 600));
  const height = 230;
  const marks = report.milestones
    .map((mark) => ({ mark, bar: milestoneBar(report, mark.day) }))
    .filter((entry) => entry.bar >= 0);
  const left = 52;
  const right = 8;
  const top = marks.length ? 22 : 10;
  const bottom = 36;
  const inner = height - top - bottom;
  const slot = (width - left - right) / report.bars.length;
  const thick = Math.max(2, Math.min(44, slot * 0.62));
  const peak = Math.max(...report.bars.map((bar) => Object.values(bar.values).reduce((a, b) => a + b, 0)), 0);
  const ceiling = peak ? niceCeiling(peak) : 1;
  const y = (value) => top + inner - value / ceiling * inner;

  const svg = svgNode('svg', { class: 'chart', width, height, viewBox: '0 0 ' + width + ' ' + height,
    role: 'img', 'aria-label': usageHeading() });

  for (let step = 0; step <= 4; step += 1) {
    const level = top + inner - step * inner / 4;
    svg.appendChild(svgNode('line', { class: 'grid', x1: left, x2: width - right, y1: level, y2: level }));
    const labelled = step > 0 && peak > 0;
    if (labelled) {
      svg.appendChild(svgNode('text', { x: left - 6, y: level + 4, 'text-anchor': 'end' },
        tokens(ceiling * step / 4)));
    }
  }

  const order = report.ranking.slice(0, SERIES);
  report.bars.forEach((bar, index) => {
    const x = left + slot * index + (slot - thick) / 2;
    const rest = Object.entries(bar.values)
      .filter(([path]) => !order.includes(path))
      .reduce((sum, [, value]) => sum + value, 0);
    const layers = order.map((path) => [path, bar.values[path] || 0]).concat([['', rest]]);
    const dim = report.span === 'day' ? false : bar.start > report.now;
    let stacked = 0;

    for (const [path, value] of layers) {
      if (!value) continue;
      const rect = svgNode('rect', {
        class: 'bar ' + (path ? seriesOf(path) : 's0') + (dim ? ' dim' : ''),
        x: x.toFixed(1), y: y(stacked + value).toFixed(1), width: thick.toFixed(1),
        height: Math.max(0.5, y(stacked) - y(stacked + value)).toFixed(1),
      });
      const named = report.projects.find((row) => row.path === path);
      rect.appendChild(svgNode('title', {}, (named ? named.name : t('others')) + ' · ' + tokens(value)));
      svg.appendChild(rect);
      stacked += value;
    }
  });

  const every = Math.max(1, Math.ceil(34 / slot));
  report.bars.forEach((bar, index) => {
    if (index % every) return;
    const centre = left + slot * (index + 0.5);
    const [first, second] = barLabels(report, bar, index);
    svg.appendChild(svgNode('text', { x: centre.toFixed(1), y: height - bottom + 16, 'text-anchor': 'middle' }, first));
    if (second) {
      svg.appendChild(svgNode('text', { x: centre.toFixed(1), y: height - bottom + 30, 'text-anchor': 'middle' }, second));
    }
  });

  for (const { mark, bar } of marks) {
    const centre = left + slot * bar + (report.span === 'day' ? 0 : slot / 2);
    const flip = centre > width - 110;
    svg.appendChild(svgNode('line', { class: 'milestone', x1: centre, x2: centre, y1: top - 6, y2: top + inner }));
    svg.appendChild(svgNode('text', { class: 'milestone', x: centre + (flip ? -5 : 5), y: 12,
      'text-anchor': flip ? 'end' : 'start' }, mark.label));
  }

  if (!peak) {
    svg.appendChild(svgNode('text', { x: left + (width - left - right) / 2, y: top + inner / 2,
      'text-anchor': 'middle' }, emptyText(report)));
  }

  box.replaceChildren(svg);
}

function legend(report) {
  const list = document.createElement('div');
  list.className = 'legend';
  const shown = report.projects.filter(isShown);
  for (const row of shown) {
    const item = document.createElement('span');
    item.appendChild(dot(row.path));
    item.appendChild(document.createTextNode(row.name));
    list.appendChild(item);
  }
  return list;
}

function cell(text, classes) {
  const part = document.createElement('span');
  part.className = classes === undefined ? 'num' : classes;
  part.textContent = text;
  return part;
}

function headRow(kind, labels) {
  const row = document.createElement('div');
  row.className = 'row head ' + kind;
  labels.forEach(([text, classes]) => row.appendChild(cell(text, classes)));
  return row;
}

function isShown(row) {
  const shown = row.on && row.tokens > 0;
  return shown;
}

function projectTable(report) {
  const rows = report.projects.filter(isShown);
  if (!rows.length) return null;

  const table = document.createElement('div');
  table.className = 'card rows';
  table.appendChild(headRow('project', [
    [t('colProject'), ''], [t('statTokens'), 'num'], [t('colShare'), 'num wide'],
    [t('colSub'), 'num wide'], [t('indContext'), 'num'], [t('colLarge'), 'num wide'], [t('colUsd'), 'num'],
  ]));

  for (const row of rows) {
    const line = document.createElement('button');
    line.type = 'button';
    line.className = 'row project';
    line.title = row.path;

    const name = document.createElement('span');
    name.className = 'name';
    name.appendChild(dot(row.path));
    name.appendChild(cell(row.name, ''));
    line.appendChild(name);

    line.appendChild(cell(tokens(row.tokens)));
    line.appendChild(cell(percent(row.share), 'num wide'));
    line.appendChild(cell(percent(row.sub), 'num wide'));
    line.appendChild(cell(kilo(row.context)));
    line.appendChild(cell(percent(row.large), 'num wide'));
    line.appendChild(cell(number(row.usd, row.usd < 100 ? 2 : 0)));
    line.addEventListener('click', () => openUsageProject(row.path));
    table.appendChild(line);
  }

  return table;
}

function sessionTitle(row) {
  const name = document.createElement('span');
  name.className = 'name';

  const stack = document.createElement('span');
  stack.appendChild(cell(row.title, ''));
  if (row.exists) {
    const open = document.createElement('button');
    open.type = 'button';
    open.className = 'open';
    open.textContent = t('openSession');
    open.addEventListener('click', () => {
      setView('sessions');
      onPick(row.id);
    });
    stack.appendChild(open);
  }
  if (!row.exists) stack.appendChild(cell(t('sessionGone'), 'gone'));

  name.appendChild(stack);
  return name;
}

function sessionTable(detail) {
  const table = document.createElement('div');
  table.className = 'card rows';
  table.appendChild(headRow('session', [
    [t('colSession'), ''], [t('colStarted'), 'num wide'], [t('statTokens'), 'num'],
    [t('colSub'), 'num wide'], [t('colMax'), 'num'], [t('colUsd'), 'num'],
  ]));

  for (const row of detail.sessions.slice(0, SESSION_ROWS)) {
    const line = document.createElement('div');
    line.className = 'row session';
    line.title = row.id;
    line.appendChild(sessionTitle(row));
    line.appendChild(cell(plainDay(fromKey(row.first)), 'num wide'));
    line.appendChild(cell(tokens(row.tokens)));
    line.appendChild(cell(number(row.subagents), 'num wide'));
    line.appendChild(cell(kilo(row.context)));
    line.appendChild(cell(number(row.usd, row.usd < 100 ? 2 : 0)));
    table.appendChild(line);
  }

  const rest = detail.sessions.slice(SESSION_ROWS);
  if (!rest.length) return table;

  const line = document.createElement('div');
  line.className = 'row session';
  line.appendChild(cell(t('otherSessions', { n: rest.length }), 'muted'));
  line.appendChild(cell('', 'num wide'));
  line.appendChild(cell(tokens(rest.reduce((sum, row) => sum + row.tokens, 0)), 'num muted'));
  table.appendChild(line);
  return table;
}

function drawUsagePane() {
  const report = usageReport;
  const body = document.createElement('div');
  body.className = 'body';
  usagePane.replaceChildren(body);
  if (!report) {
    const waiting = document.createElement('div');
    waiting.className = 'empty';
    waiting.textContent = t('loading');
    body.appendChild(waiting);
    return;
  }

  if (usageProject) {
    const leave = document.createElement('button');
    leave.type = 'button';
    leave.className = 'copy back';
    leave.textContent = t('allProjects');
    leave.addEventListener('click', closeUsageProject);
    body.appendChild(leave);
    if (usageDetail) body.appendChild(sessionTable(usageDetail));
    return;
  }

  for (const block of drawStats(report)) body.appendChild(block);

  const card = document.createElement('div');
  card.className = 'card chartbox';
  const box = document.createElement('div');
  card.appendChild(box);
  card.appendChild(legend(report));
  body.appendChild(card);
  drawChart(report, box);

  const table = projectTable(report);
  if (table) body.appendChild(table);
}

function drawUsage() {
  paintSpans();
  drawUsageTop();
  drawUsageSide();
  drawUsagePane();
}

function usageQuery() {
  const parts = ['span=' + encodeURIComponent(usageSpan), 'at=' + encodeURIComponent(usageAt)];
  for (const path of usageOff) parts.push('off=' + encodeURIComponent(path));
  return parts.join('&');
}

// Asked again every minute while the panel is open, and every two seconds
// while the first pass is still reading.
async function loadUsage() {
  const run = ++usageRun;
  clearTimeout(usageTimer);
  if (view !== 'usage') return;

  try {
    const response = await fetch('/api/usage?' + usageQuery());
    const report = await response.json();
    if (run !== usageRun) return;
    usageReport = report;
    if (usageProject) await loadUsageProject(run);
    if (run !== usageRun) return;
    drawUsage();
  } catch (error) { /* the server is down; the timer tries again */ }

  const indexing = usageReport && !usageReport.status.ready;
  usageTimer = setTimeout(loadUsage, indexing ? 2000 : 60000);
}

async function loadUsageProject(run) {
  const response = await fetch('/api/usage/project?' + usageQuery() + '&name=' + encodeURIComponent(usageProject));
  const detail = await response.json();
  if (run !== usageRun) return;
  usageDetail = detail;
}

function openUsageProject(path) {
  usageProject = path;
  usageDetail = null;
  loadUsage();
}

function closeUsageProject() {
  usageProject = null;
  usageDetail = null;
  drawUsage();
}

function setSpan(span) {
  usageSpan = span;
  localStorage.setItem('pergula:usage-span', span);
  usageAt = '';
  const custom = span === 'custom';
  if (custom) usageAt = customRange();
  paintSpans();
  loadUsage();
}

// The dates default to the window on screen, so switching to them changes
// nothing until a date is moved.
function customRange() {
  const report = usageReport;
  if (!usageFrom.value && report) usageFrom.value = report.start.slice(0, 10);
  if (!usageTo.value && report) usageTo.value = toKey(new Date(fromKey(report.end).getTime() - 3600000)).slice(0, 10);

  return usageFrom.value + '..' + usageTo.value;
}

function stepUsage(target) {
  if (!target) return;

  usageAt = target;
  const custom = usageSpan === 'custom';
  if (custom) {
    const [from, to] = target.split('..');
    usageFrom.value = from;
    usageTo.value = to;
  }
  loadUsage();
}

usageSpans.addEventListener('click', (event) => {
  const button = event.target.closest('button[data-span]');
  if (!button) return;

  setSpan(button.dataset.span);
});

for (const field of [usageFrom, usageTo]) {
  field.addEventListener('change', () => {
    usageAt = customRange();
    loadUsage();
  });
}

usagePrev.addEventListener('click', () => stepUsage(usageReport && usageReport.prev));
usageNext.addEventListener('click', () => stepUsage(usageReport && usageReport.next));
tabUsage.addEventListener('click', () => setView('usage'));

window.addEventListener('resize', () => {
  const charted = view === 'usage' && usageReport && !usageProject;
  if (charted) drawUsagePane();
});

// WORK

const workPane = document.getElementById('work');
const workSide = document.getElementById('workSide');
const workScopeBox = document.getElementById('workScope');
const tabWork = document.getElementById('tabWork');
const toastEl = document.getElementById('toast');

// Read once each time the tab opens, never polled: a cold answer walks every
// worktree of every repository and takes seconds. Nothing here writes.
let workData = null;
let workFailed = false;
let workRun = 0;
let workScope = 'all';
let workRepo = '';
const workOpen = new Set();
let toastTimer = null;

function toast(text) {
  toastEl.textContent = text;
  toastEl.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toastEl.classList.remove('show'), 3000);
}

async function loadWork() {
  const run = ++workRun;
  workFailed = false;
  drawWork();

  try {
    const response = await fetch('/api/work');
    const data = await response.json();
    if (run !== workRun) return;
    workData = data;
  } catch (error) {
    if (run !== workRun) return;
    workFailed = !workData;
  }

  if (view === 'work') drawWork();
}

function workCards() {
  return (workData && workData.worktrees) || [];
}

function hasLive(card) {
  return card.sessions.some((item) => item.live);
}

function workMatches(card, needle) {
  if (!needle) return true;
  const fields = [card.id, card.title, card.branch, card.stage, card.repoName, card.path, card.label];
  return fields.some((field) => (field || '').toLowerCase().includes(needle));
}

function visibleCards() {
  const needle = filter.value.trim().toLowerCase();
  return workCards().filter((card) => (workScope === 'all' || hasLive(card))
    && (!workRepo || card.repo === workRepo)
    && workMatches(card, needle));
}

function workCounts() {
  const cards = workCards();
  return {
    trees: cards.length,
    up: cards.filter((card) => card.env && card.env.up).length,
    live: cards.reduce((sum, card) => sum + card.sessions.filter((item) => item.live).length, 0),
    left: cards.filter((card) => card.status === 'left').length,
  };
}

function drawWorkTop() {
  titleEl.textContent = t('workTitle');
  titleEl.title = '';
  if (!workData) {
    metaEl.textContent = workFailed ? t('workFailed') : t('workLoading');
    return;
  }

  const counts = workCounts();
  const parts = [t('workCounts', { n: counts.trees, e: counts.up, l: counts.left })];
  const unanswered = workCards().filter((card) => !card.github).length;
  if (unanswered) parts.push(t('workNoGithub', { n: unanswered }));
  metaEl.textContent = parts.join('  ·  ');
}

function paintWorkScope() {
  for (const button of workScopeBox.querySelectorAll('button')) {
    button.classList.toggle('on', button.dataset.scope === workScope);
  }
}

function drawWorkSide() {
  paintWorkScope();
  workSide.replaceChildren();
  const repos = new Map();
  for (const card of workCards()) {
    const entry = repos.get(card.repo) || { name: card.repoName, count: 0 };
    entry.count += 1;
    repos.set(card.repo, entry);
  }
  if (!repos.size) return;

  workSide.appendChild(head(t('workRepos')));
  for (const [repo, entry] of repos) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'repo' + (repo === workRepo ? ' on' : '');
    button.title = shortPath(repo);
    button.appendChild(textSpan('name', entry.name));
    button.appendChild(textSpan('count', String(entry.count)));
    button.addEventListener('click', () => {
      workRepo = workRepo === repo ? '' : repo;
      drawWork();
    });
    workSide.appendChild(button);
  }
}

function textSpan(className, text) {
  const span = document.createElement('span');
  span.className = className;
  span.textContent = text;
  return span;
}

function codeSpan(text, className) {
  const code = document.createElement('code');
  if (className) code.className = className;
  code.textContent = text;
  return code;
}

function chip(text, className) {
  return textSpan('chip' + (className ? ' ' + className : ''), text);
}

function workRow(className) {
  const row = document.createElement('div');
  row.className = 'wrow' + (className ? ' ' + className : '');
  return row;
}

function shortStamp(iso) {
  const when = new Date(iso);
  if (Number.isNaN(when.getTime())) return '';
  return when.toLocaleDateString(locale(), { day: '2-digit', month: '2-digit' }) + ' '
    + when.toLocaleTimeString(locale(), { hour: '2-digit', minute: '2-digit' });
}

function workReason(card) {
  const pr = card.pr;
  if (card.status === 'merged' && pr) return t('prMerged', { n: pr.number, when: shortStamp(pr.mergedAt || '') }).trim();
  if (pr && pr.state === 'CLOSED') return t('prClosed', { n: pr.number });
  const days = Math.floor(Math.max(0, Date.now() / 1000 - card.lastActivity) / 86400);
  return t('workIdle', { n: days });
}

function statusChip(card) {
  if (card.status === 'merged') return chip(t('workMerged'), 'status');
  if (card.status === 'left') return chip(t('workLeft'), 'status');
  return chip(t('workActive'), 'status');
}

function link(url) {
  const anchor = document.createElement('a');
  anchor.href = url;
  anchor.target = '_blank';
  anchor.rel = 'noreferrer';
  anchor.textContent = url.replace(/^https:\/\//, '');
  anchor.addEventListener('click', (event) => event.stopPropagation());
  return anchor;
}

function environmentRow(card) {
  const row = workRow();
  const env = card.env;
  if (env && env.up) {
    if (env.app) row.appendChild(link(env.app));
    row.appendChild(link(env.api));
    if (env.port) row.appendChild(chip(':' + env.port, 'port'));
    return row;
  }

  const merged = card.status === 'merged';
  const text = env ? t('workEnvDown') : t(merged ? 'workNoEnvMerged' : 'workNoEnv');
  row.appendChild(textSpan('muted', text));
  return row;
}

function sessionChip(item) {
  const box = textSpan('schip', '');
  box.title = item.id;
  box.appendChild(codeSpan(item.id.slice(0, 8)));
  box.appendChild(textSpan('name', item.title || ''));
  const when = item.live
    ? textSpan('when live' + (item.state ? ' ' + item.state : ''), '● ' + t('workLive'))
    : textSpan('when', t('workAgo', { t: ago(item.mtime) }));
  box.appendChild(when);
  return box;
}

function sessionsRow(card) {
  const row = workRow();
  if (!card.sessions.length) {
    row.appendChild(textSpan('muted', t('workNoSession')));
    return row;
  }

  for (const item of card.sessions) row.appendChild(sessionChip(item));
  return row;
}

function copyCommand(card, button) {
  const failed = () => toast(t('clipboardBlocked'));
  if (!navigator.clipboard) {
    failed();
    return;
  }

  navigator.clipboard.writeText(card.command).then(() => {
    button.textContent = t('copied');
    button.classList.add('done');
    setTimeout(() => { button.textContent = t('copy'); button.classList.remove('done'); }, 1800);
  }).catch(failed);
}

function teardownRow(card) {
  const row = workRow('teardown');
  row.appendChild(textSpan('muted', workReason(card)));
  if (!card.command) return row;

  row.appendChild(codeSpan(card.command, 'cmd'));
  const button = document.createElement('button');
  button.type = 'button';
  button.className = 'copy';
  button.textContent = t('copy');
  button.addEventListener('click', (event) => {
    event.stopPropagation();
    copyCommand(card, button);
  });
  row.appendChild(button);

  if (card.ahead) row.appendChild(textSpan('note', t('workNoteAhead', { n: card.ahead })));
  if (!card.ahead && card.dirty) row.appendChild(textSpan('note', t('workNoteDirty', { n: card.dirty })));
  return row;
}

function moreList(card) {
  const list = document.createElement('dl');
  list.className = 'more';
  const env = card.env;
  const pairs = [
    [t('moreDb'), (env && env.database) || t('moreNone')],
    [t('morePath'), shortPath(card.path)],
    [t('moreEndToEnd'), (env && env.e2e) ? String(env.e2e) : t('moreNone')],
  ];
  for (const [term, value] of pairs) {
    const dt = document.createElement('dt');
    dt.textContent = term;
    const dd = document.createElement('dd');
    dd.textContent = value;
    list.append(dt, dd);
  }
  return list;
}

function workCard(card) {
  const box = document.createElement('article');
  box.className = 'card wcard ' + card.status + (workOpen.has(card.path) ? ' open' : '');
  box.tabIndex = 0;
  box.title = shortPath(card.path);

  const first = workRow();
  const dot = textSpan('dot', '');
  first.appendChild(dot);
  first.appendChild(textSpan('wid', card.id));
  first.appendChild(textSpan('wtitle', card.title || ''));
  const chips = textSpan('chips', '');
  if (card.dirty) chips.appendChild(chip(t('workDirty'), 'dirty'));
  chips.appendChild(statusChip(card));
  first.appendChild(chips);
  box.appendChild(first);

  const second = workRow();
  if (card.stage) second.appendChild(textSpan('', t('workStage', { s: card.stage })));
  second.appendChild(codeSpan(card.branch || '—'));
  if (card.ahead !== null) second.appendChild(textSpan('muted', t('workAhead', { n: card.ahead })));
  second.appendChild(textSpan('muted', card.dirty ? t('workUncommitted', { n: card.dirty }) : t('workClean')));
  box.appendChild(second);

  box.appendChild(environmentRow(card));
  box.appendChild(sessionsRow(card));
  if (card.status !== 'active') box.appendChild(teardownRow(card));
  box.appendChild(moreList(card));

  const toggle = () => {
    if (workOpen.has(card.path)) workOpen.delete(card.path);
    if (!box.classList.contains('open')) workOpen.add(card.path);
    box.classList.toggle('open');
  };
  box.addEventListener('click', () => {
    const selecting = String(window.getSelection() || '').length > 0;
    if (selecting) return;
    toggle();
  });
  box.addEventListener('keydown', (event) => {
    if (event.target !== box) return;
    if (event.key !== 'Enter' && event.key !== ' ') return;
    event.preventDefault();
    toggle();
  });
  return box;
}

function workStat(label, value) {
  const box = document.createElement('div');
  box.className = 'stat';
  box.appendChild(textSpan('label', label));
  const figure = document.createElement('b');
  figure.textContent = String(value);
  box.appendChild(figure);
  return box;
}

function drawWorkPane() {
  const body = document.createElement('div');
  body.className = 'body';
  workPane.replaceChildren(body);

  if (!workData) {
    const waiting = document.createElement('div');
    waiting.className = 'empty';
    waiting.textContent = workFailed ? t('workFailed') : t('workLoading');
    body.appendChild(waiting);
    return;
  }

  const counts = workCounts();
  const stats = document.createElement('div');
  stats.className = 'stats';
  stats.append(workStat(t('statWorktrees'), counts.trees), workStat(t('statEnvUp'), counts.up),
               workStat(t('statLive'), counts.live), workStat(t('statLeft'), counts.left));
  body.appendChild(stats);

  const cards = visibleCards();
  if (!cards.length) {
    const empty = document.createElement('div');
    empty.className = 'empty';
    empty.textContent = t('noWorkMatch');
    body.appendChild(empty);
    return;
  }

  let repo = null;
  for (const card of cards) {
    if (card.repo !== repo) {
      repo = card.repo;
      const group = document.createElement('div');
      group.className = 'work-group';
      group.title = shortPath(repo);
      const name = document.createElement('b');
      name.textContent = card.repoName;
      group.append(name, codeSpan('.claude/worktrees'));
      body.appendChild(group);
    }
    body.appendChild(workCard(card));
  }
}

function drawWork() {
  drawWorkTop();
  drawWorkSide();
  drawWorkPane();
}

for (const button of workScopeBox.querySelectorAll('button')) {
  button.addEventListener('click', () => {
    workScope = button.dataset.scope;
    drawWork();
  });
}

tabWork.addEventListener('click', () => setView('work'));

// PALETTE

function paletteHits() {
  const needle = paletteInput.value.trim().toLowerCase();
  return snippets.filter((item) => snippetMatches(item, needle)).slice(0, 40);
}

function closePalette() {
  palette.classList.remove('on');
}

function openPalette() {
  palette.classList.add('on');
  paletteInput.value = '';
  paletteAt = 0;
  paintPalette();
  paletteInput.focus();
}

function paintPalette() {
  if (!palette.classList.contains('on')) return;

  const hits = paletteHits();
  paletteAt = Math.min(paletteAt, Math.max(0, hits.length - 1));
  paletteList.replaceChildren();

  if (!hits.length) {
    const empty = document.createElement('div');
    empty.className = 'empty';
    empty.textContent = snippets.length ? t('nothingFound') : t('noSnippets');
    paletteList.appendChild(empty);
    return;
  }

  hits.forEach((item, index) => {
    const row = document.createElement('button');
    row.type = 'button';
    row.className = index === paletteAt ? 'hit on' : 'hit';

    if (item.group) {
      const folder = document.createElement('span');
      folder.className = 'group';
      folder.textContent = item.group + ' /';
      row.appendChild(folder);
    }

    const name = document.createElement('span');
    name.textContent = item.title;
    row.appendChild(name);

    const peek = document.createElement('span');
    peek.className = 'peek';
    peek.textContent = item.body.replace(/\s+/g, ' ').trim();
    row.appendChild(peek);

    row.addEventListener('click', () => copyHit(index));
    paletteList.appendChild(row);
  });
}

function copyHit(index) {
  const item = paletteHits()[index];
  if (!item) return;

  navigator.clipboard.writeText(item.body).then(() => {
    const row = paletteList.children[index];
    if (row) {
      row.classList.add('done');
      row.querySelector('.peek').textContent = t('copied');
    }

    setTimeout(closePalette, 480);
  }).catch(closePalette);
}

async function pollSnippets() {
  try {
    const response = await fetch('/api/snippets?since=' + encodeURIComponent(snippetsToken));
    if (response.status === 200) {
      const payload = await response.json();
      snippetsToken = payload.token;
      snippetsHome = payload.home;
      snippets = payload.snippets;
      favouriteSlugs = payload.favourites;
      drawFavourites();
      paintStar();
      paintGroups();
      paintPalette();
      if (view === 'library') {
        drawTree();
        drawTop();
      }
    }
  } catch (error) { /* the server is down; the next tick tries again */ }
}

async function loopSnippets() {
  await pollSnippets();
  setTimeout(loopSnippets, 2500);
}

